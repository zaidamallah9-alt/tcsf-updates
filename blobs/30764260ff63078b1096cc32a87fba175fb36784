// La bande de personnages, dessinée comme des fournitures scolaires au trait d'encre.
// Un seul style pour tous : contour encre #1d2b53 (trait 4), aplats francs, visage minimal (deux points, un trait).
// window.TCSF_CAST.svg(id, taille, humeur)  ·  humeurs : happy, sad, wow
//   tico  : le cahier Seyès (guide de l'appli)     nour  : le crayon (maths)
//   volta : la fiole d'Erlenmeyer (physique-chimie) moss  : la pousse en pot (SVT)
//   pixel : la calculatrice (informatique)          rima  : le livre ouvert (langues, sciences humaines)
(() => {
  const INK = '#1d2b53';
  const line = `stroke="${INK}" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"`;

  // visage : yeux (clignent), sourire, bouche qui parle (cachée sauf quand la voix lit)
  function face(mood, cx, cy) {
    const eyes = mood === 'sad'
      ? `<circle cx="${cx - 10}" cy="${cy + 1}" r="3.4" fill="${INK}"/><circle cx="${cx + 10}" cy="${cy + 1}" r="3.4" fill="${INK}"/><path d="M${cx - 15} ${cy - 5} l8 -3M${cx + 15} ${cy - 5} l-8 -3" stroke="${INK}" stroke-width="2.6" stroke-linecap="round" fill="none"/>`
      : `<circle cx="${cx - 10}" cy="${cy}" r="${mood === 'wow' ? 4.6 : 3.8}" fill="${INK}"/><circle cx="${cx + 10}" cy="${cy}" r="${mood === 'wow' ? 4.6 : 3.8}" fill="${INK}"/>`;
    const mouth = mood === 'sad' ? `<path class="msc-smile" d="M${cx - 7} ${cy + 14} q7 -6 14 0" ${line} fill="none"/>`
      : mood === 'wow' ? `<ellipse class="msc-smile" cx="${cx}" cy="${cy + 12}" rx="4.5" ry="5.5" fill="${INK}"/>`
      : `<path class="msc-smile" d="M${cx - 8} ${cy + 9} q8 8 16 0" ${line} fill="none"/>`;
    return `<g class="msc-eyes">${eyes}</g>${mouth}<ellipse class="msc-mouth" cx="${cx}" cy="${cy + 12}" rx="5" ry="4" fill="${INK}"/>`;
  }

  const DRAW = {
    // cahier : couverture bleue, page Seyès, marge rouge
    tico: (m) => `
      <rect x="20" y="10" width="82" height="100" rx="7" fill="#2c5cc5" ${line}/>
      <rect x="34" y="16" width="62" height="88" rx="3" fill="#fff" stroke="${INK}" stroke-width="2.5"/>
      <path d="M34 34h62M34 46h62M34 58h62M34 70h62M34 82h62M34 94h62" stroke="#9db9e8" stroke-width="1.6"/>
      <path d="M46 16v88" stroke="#e2463b" stroke-width="2.4"/>
      <path d="M20 26h-6M20 44h-6M20 62h-6M20 80h-6M20 98h-6" ${line}/>
      ${face(m, 71, 56)}`,
    // crayon à papier : corps jaune, virole, gomme rose, mine
    nour: (m) => `
      <path d="M38 22h44v66H38z" fill="#f2b705" ${line}/>
      <path d="M52 22v66M68 22v66" stroke="#c99700" stroke-width="2.5"/>
      <rect x="36" y="12" width="48" height="12" rx="2" fill="#c7cfdc" ${line}/>
      <path d="M40 12V8a6 6 0 0 1 6-6h28a6 6 0 0 1 6 6v4z" fill="#f08aa0" ${line}/>
      <path d="M38 88h44l-22 28z" fill="#f4d6a8" ${line}/>
      <path d="M54 108h12l-6 8z" fill="${INK}"/>
      <rect x="44" y="42" width="32" height="30" rx="6" fill="#fff6d6" opacity=".9"/>
      ${face(m, 60, 54)}`,
    // fiole : verre clair, liquide orange, deux bulles
    volta: (m) => `
      <path d="M50 8h20M53 8v34L24 96a8 8 0 0 0 7 12h58a8 8 0 0 0 7-12L67 42V8" fill="#eef4ff" ${line}/>
      <path d="M36 74h48l12 22a8 8 0 0 1-7 12H31a8 8 0 0 1-7-12z" fill="#f59e0b" ${line}/>
      <circle cx="44" cy="92" r="3.5" fill="#fff" opacity=".8"/><circle cx="74" cy="86" r="2.5" fill="#fff" opacity=".8"/>
      <path d="M53 24h8M53 32h5" stroke="${INK}" stroke-width="2.5" stroke-linecap="round"/>
      ${face(m, 60, 58)}`,
    // pousse : pot en terre, deux feuilles
    moss: (m) => `
      <path d="M60 64V36" ${line} fill="none"/>
      <path d="M60 46C42 46 30 34 32 18c16 0 28 10 28 28z" fill="#2e9e5b" ${line}/>
      <path d="M60 38c14 0 26-10 25-24-14 0-25 8-25 24z" fill="#4cc27a" ${line}/>
      <rect x="24" y="62" width="72" height="14" rx="3" fill="#d9774a" ${line}/>
      <path d="M30 76h60l-8 34H38z" fill="#c8643b" ${line}/>
      ${face(m, 60, 88)}`,
    // calculatrice : boîtier, écran, touches
    pixel: (m) => `
      <rect x="22" y="10" width="76" height="100" rx="12" fill="#0e8fa8" ${line}/>
      <rect x="32" y="20" width="56" height="44" rx="6" fill="#e9fbff" ${line}/>
      <g fill="#fff" ${line}>
        <rect x="32" y="74" width="14" height="11" rx="3"/><rect x="53" y="74" width="14" height="11" rx="3"/><rect x="74" y="74" width="14" height="11" rx="3" fill="#f2b705"/>
        <rect x="32" y="92" width="14" height="11" rx="3"/><rect x="53" y="92" width="14" height="11" rx="3"/><rect x="74" y="92" width="14" height="11" rx="3" fill="#e2463b"/>
      </g>
      ${face(m, 60, 38)}`,
    // livre ouvert : couverture violette, pages réglées
    rima: (m) => `
      <path d="M6 30v70c22-4 40-2 54 6 14-8 32-10 54-6V30z" fill="#8b5cf6" ${line}/>
      <path d="M60 36c-12-8-30-10-46-7v63c16-3 34-1 46 7z" fill="#fff" ${line}/>
      <path d="M60 36c12-8 30-10 46-7v63c-16-3-34-1-46 7z" fill="#fff" ${line}/>
      <path d="M22 48c10-2 20-1 28 2M22 84c10-2 20-1 28 2M70 50c8-3 18-4 28-2M70 86c8-3 18-4 28-2" stroke="#9db9e8" stroke-width="2" fill="none"/>
      ${face(m, 60, 64)}`
  };

  function svg(id, size = 96, mood = 'happy') {
    const draw = DRAW[id] || DRAW.rima;
    return `<svg class="msc cast cast-${id}" width="${size}" height="${size}" viewBox="0 0 120 120" aria-hidden="true" focusable="false"><g class="msc-body">${draw(mood)}</g></svg>`;
  }
  window.TCSF_CAST = { svg, ids: Object.keys(DRAW) };
})();
