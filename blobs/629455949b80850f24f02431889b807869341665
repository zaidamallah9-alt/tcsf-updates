// Widgets interactifs utilisables dans les fichiers de leçon :
//   <div data-widget="atom-history"></div>      modèles historiques animés
//   <div data-widget="rutherford"></div>        simulation de l'expérience de Rutherford
//   <div data-widget="atom-builder"></div>      construire un atome / ion / isotope
//   <div data-widget="atom-scale"></div>        zoom de l'atome au noyau
//   <div data-widget="quiz" data-src="chemin/quiz.json"></div>
window.TCSF_WIDGETS = (() => {
  const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim() || '#888';
  const P_COL = '#e5484d', N_COL = '#8b93a7', E_COL = '#3b82f6';
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const ELEMENTS = [null,
    ['H', 'Hydrogène', 1], ['He', 'Hélium', 4], ['Li', 'Lithium', 7], ['Be', 'Béryllium', 9], ['B', 'Bore', 11],
    ['C', 'Carbone', 12], ['N', 'Azote', 14], ['O', 'Oxygène', 16], ['F', 'Fluor', 19], ['Ne', 'Néon', 20],
    ['Na', 'Sodium', 23], ['Mg', 'Magnésium', 24], ['Al', 'Aluminium', 27], ['Si', 'Silicium', 28], ['P', 'Phosphore', 31],
    ['S', 'Soufre', 32], ['Cl', 'Chlore', 35], ['Ar', 'Argon', 40], ['K', 'Potassium', 39], ['Ca', 'Calcium', 40]];

  // ---------- utilitaires ----------
  function h(tag, attrs = {}, html = '') {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (k === 'class') e.className = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v); else e.setAttribute(k, v);
    }
    if (html) e.innerHTML = html;
    return e;
  }
  function sci(x, d = 2) {
    if (x === 0) return '0';
    const n = Math.floor(Math.log10(Math.abs(x)));
    let a = x / 10 ** n;
    let s = a.toFixed(d).replace('.', ',');
    if (s.replace('-', '').startsWith('10')) { a /= 10; s = a.toFixed(d).replace('.', ','); return `${s} × 10<sup>${String(n + 1).replace('-', '−')}</sup>`; }
    return n === 0 ? s : `${s} × 10<sup>${String(n).replace('-', '−')}</sup>`;
  }
  const nucHTML = (A, Z, X) => `<span class="nuc"><span class="az"><span>${A}</span><span>${Z}</span></span><span class="x">${X}</span></span>`;

  function makeCanvas(container, ratio, minH = 220, maxH = 420) {
    const canvas = h('canvas', { class: 'w-canvas' });
    container.appendChild(canvas);
    const ctx = canvas.getContext('2d');
    const st = { w: 0, h: 0 };
    const fit = () => {
      const w = Math.max(260, canvas.parentElement.clientWidth);
      const hh = Math.max(minH, Math.min(maxH, w * ratio));
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(hh * dpr);
      canvas.style.height = hh + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      st.w = w; st.h = hh;
    };
    fit();
    new ResizeObserver(fit).observe(container);
    return { canvas, ctx, st };
  }
  // Boucle d'animation qui s'arrête quand le widget quitte la page.
  function loop(el, fn) {
    const t0 = performance.now();
    const step = (now) => {
      if (!el.isConnected) return;
      fn((now - t0) / 1000);
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  function ball(ctx, x, y, r, color, label) {
    const g = ctx.createRadialGradient(x - r * .35, y - r * .35, r * .1, x, y, r);
    g.addColorStop(0, '#ffffff'); g.addColorStop(.25, color); g.addColorStop(1, shade(color, -40));
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    if (label && r >= 6) { ctx.fillStyle = '#fff'; ctx.font = `700 ${Math.round(r * 1.2)}px Segoe UI, Arial`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(label, x, y + .5); }
  }
  function shade(hex, amt) {
    const n = parseInt(hex.slice(1), 16);
    const c = (s) => Math.max(0, Math.min(255, ((n >> s) & 255) + amt));
    return `rgb(${c(16)},${c(8)},${c(0)})`;
  }
  function header(el, title, hint) {
    el.classList.add('widget');
    el.appendChild(h('div', { class: 'w-head' }, `<span class="w-badge">Interactif</span><b>${title}</b>${hint ? `<span class="w-hint">${hint}</span>` : ''}`));
  }
  // Noyau compact (spirale) : liste de particules p/n
  function nucleusLayout(Z, N) {
    const parts = [];
    const total = Z + N;
    let p = 0, n = 0;
    for (let i = 0; i < total; i++) {
      const wantP = (p + 0.5) / Z <= (n + 0.5) / Math.max(N, 1) || n >= N;
      if (wantP && p < Z) { parts.push('p'); p++; } else { parts.push('n'); n++; }
    }
    return parts.map((k, i) => ({ k, r: Math.sqrt(i + .5), a: i * 2.39996 }));
  }
  function drawNucleus(ctx, cx, cy, Z, N, s, t = 0) {
    const L = nucleusLayout(Z, N);
    for (let i = L.length - 1; i >= 0; i--) {
      const q = L[i];
      const j = reduceMotion ? 0 : Math.sin(t * 9 + i * 1.7) * s * .06;
      ball(ctx, cx + Math.cos(q.a) * q.r * s * .95 + j, cy + Math.sin(q.a) * q.r * s * .95 - j, s, q.k === 'p' ? P_COL : N_COL, s >= 7 ? (q.k === 'p' ? '+' : '') : '');
    }
  }
  function shells(n) {
    const caps = [2, 8, 8, 2];
    const out = [];
    for (const c of caps) { if (n <= 0) break; out.push(Math.min(c, n)); n -= c; }
    return out;
  }

  // =====================================================================
  // 1) Modèles historiques animés
  // =====================================================================
  const MODELS = [
    { year: '~400 av. J.-C.', who: 'Démocrite', title: 'Des grains insécables', text: "La matière est faite de minuscules particules indivisibles, en mouvement dans le vide : les <b>atomes</b> (<i>atomos</i> = insécable). C'est une idée philosophique, sans expérience.", news: 'Première idée de l’atome' },
    { year: '1808', who: 'Dalton', title: 'La sphère pleine', text: "L'atome est une <b>sphère pleine et indivisible</b>. Tous les atomes d'un même élément sont identiques ; les atomes d'éléments différents ont des masses différentes.", news: 'Modèle basé sur la chimie' },
    { year: '1904', who: 'Thomson', title: 'Le pudding aux raisins', text: "Thomson découvre l'<b>électron</b> (1897) : l'atome n'est pas indivisible ! Il l'imagine comme une sphère <b>positive</b> dans laquelle les électrons <b>négatifs</b> sont incrustés.", news: "Découverte de l'électron" },
    { year: '1911', who: 'Rutherford', title: 'Le modèle planétaire', text: "Un <b>noyau</b> minuscule, positif et très massif au centre ; les électrons tournent autour, très loin. L'atome est surtout formé de <b>vide</b> (structure lacunaire).", news: 'Découverte du noyau' },
    { year: '1913', who: 'Bohr', title: 'Les couches électroniques', text: "Les électrons ne tournent que sur certaines <b>orbites (couches) K, L, M…</b>, chacune correspondant à une énergie bien définie. Ici : l'atome de sodium (K)²(L)⁸(M)¹.", news: 'Couches quantifiées' },
    { year: 'Aujourd’hui', who: 'Modèle actuel', title: 'Le nuage électronique', text: "On ne peut pas suivre la trajectoire d'un électron : on connaît seulement la <b>probabilité</b> de le trouver à un endroit. Plus le nuage est dense, plus l'électron a de chances d'y être.", news: 'Modèle quantique' }
  ];
  const DEMO_PARTS = Array.from({ length: 16 }, (_, i) => ({ fx: .3 + (i * .37) % .9, fy: .4 + (i * .53) % .8, px: i * 1.3, py: i * 2.1, r: .1 + (i % 4) * .025, c: ['#8b93a7', '#c08a4a', '#6aa36f', '#7a8ccf'][i % 4] }));
  const CLOUD = Array.from({ length: 1400 }, () => {
    const u = Math.random(), a = Math.random() * Math.PI * 2;
    return { r: Math.min(1.25, -Math.log(1 - u * .985) * .32), a, s: Math.random() };
  });

  function drawModel(ctx, i, w, hh, t) {
    const cx = w / 2, cy = hh / 2, R = Math.min(w, hh) * .38;
    const text = css('--text');
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    if (i === 0) {
      ctx.strokeStyle = css('--line'); ctx.lineWidth = 2; ctx.setLineDash([6, 6]);
      ctx.beginPath(); ctx.arc(cx, cy, R * 1.15, 0, 7); ctx.stroke(); ctx.setLineDash([]);
      DEMO_PARTS.forEach((p) => {
        const x = cx + Math.sin(t * p.fx + p.px) * R * .85, y = cy + Math.cos(t * p.fy + p.py) * R * .85;
        ball(ctx, x, y, R * p.r, p.c);
      });
      ctx.fillStyle = text; ctx.font = 'italic 600 15px Segoe UI, Arial'; ctx.fillText('atomos', cx, cy + R * 1.15 + 14 > hh - 8 ? hh - 10 : cy + R * 1.15 + 14);
    } else if (i === 1) {
      const y = cy + Math.sin(t * 1.6) * 6;
      ctx.fillStyle = 'rgba(0,0,0,.12)'; ctx.beginPath(); ctx.ellipse(cx, cy + R + 8, R * .8 - Math.sin(t * 1.6) * 6, 8, 0, 0, 7); ctx.fill();
      ball(ctx, cx, y, R * .9, '#8a96ad');
      ball(ctx, cx + R * 1.35, cy + R * .45 + Math.sin(t * 1.6 + 1) * 5, R * .38, '#c08a4a');
      ball(ctx, cx - R * 1.35, cy + R * .55 + Math.sin(t * 1.6 + 2) * 5, R * .28, '#6aa36f');
    } else if (i === 2) {
      const g = ctx.createRadialGradient(cx - R * .3, cy - R * .3, R * .2, cx, cy, R);
      g.addColorStop(0, '#ffd6da'); g.addColorStop(1, '#f19aa2');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, R, 0, 7); ctx.fill();
      ctx.fillStyle = '#c0313a'; ctx.font = '700 18px Segoe UI, Arial';
      for (let k = 0; k < 14; k++) { const a = k * 2.4, r = R * (.25 + (k % 4) * .18); ctx.fillText('+', cx + Math.cos(a) * r, cy + Math.sin(a) * r); }
      for (let k = 0; k < 9; k++) {
        const a = k * 0.7 + 0.3, r = R * (.12 + (k % 3) * .27);
        const jx = reduceMotion ? 0 : Math.sin(t * 7 + k) * 3, jy = reduceMotion ? 0 : Math.cos(t * 6 + k * 2) * 3;
        ball(ctx, cx + Math.cos(a) * r + jx, cy + Math.sin(a) * r + jy, 9, E_COL, '−');
      }
    } else if (i === 3) {
      ctx.strokeStyle = text; ctx.globalAlpha *= .35; ctx.lineWidth = 1.3;
      for (let k = 0; k < 3; k++) { ctx.beginPath(); ctx.ellipse(cx, cy, R * 1.1, R * .38, k * Math.PI / 3, 0, 7); ctx.stroke(); }
      ctx.globalAlpha /= .35;
      ball(ctx, cx, cy, 6, P_COL);
      for (let k = 0; k < 3; k++) {
        const th = t * (1.6 + k * .4) + k * 2, rot = k * Math.PI / 3;
        const ex = R * 1.1 * Math.cos(th), ey = R * .38 * Math.sin(th);
        ball(ctx, cx + ex * Math.cos(rot) - ey * Math.sin(rot), cy + ex * Math.sin(rot) + ey * Math.cos(rot), 7, E_COL);
      }
      ctx.fillStyle = css('--muted'); ctx.font = '12px Segoe UI, Arial'; ctx.fillText('noyau (agrandi)', cx, cy + 22);
    } else if (i === 4) {
      const radii = [R * .42, R * .72, R * 1.02], counts = [2, 8, 1], names = ['K', 'L', 'M'];
      radii.forEach((r, k) => {
        ctx.strokeStyle = text; ctx.globalAlpha *= .3; ctx.lineWidth = 1.3; ctx.beginPath(); ctx.arc(cx, cy, r, 0, 7); ctx.stroke(); ctx.globalAlpha /= .3;
        ctx.fillStyle = css('--accent'); ctx.font = '700 13px Segoe UI, Arial'; ctx.fillText(names[k], cx + r * .72 + 10, cy - r * .72 - 4);
        for (let e = 0; e < counts[k]; e++) {
          const a = t * (1.4 - k * .35) + e * Math.PI * 2 / counts[k];
          ball(ctx, cx + Math.cos(a) * r, cy + Math.sin(a) * r, 6.5, E_COL);
        }
      });
      drawNucleus(ctx, cx, cy, 11, 12, Math.max(3.2, R * .045), t);
    } else {
      const frame = Math.floor(t * 12);
      ctx.fillStyle = E_COL;
      CLOUD.forEach((p, k) => {
        if (((k * 7919 + frame * 104729) % 97) / 97 > .55) return;
        const x = cx + Math.cos(p.a) * p.r * R, y = cy + Math.sin(p.a) * p.r * R;
        ctx.globalAlpha = .55; ctx.fillRect(x, y, 2, 2);
      });
      ctx.globalAlpha = 1;
      ball(ctx, cx, cy, 5, P_COL);
    }
  }

  function atomHistory(el) {
    header(el, 'Évolution du modèle de l’atome', 'Clique sur une date ou utilise ← →');
    const tl = h('div', { class: 'w-timeline', role: 'tablist' });
    const stage = h('div', { class: 'w-stage' });
    const info = h('div', { class: 'w-info' });
    const ctrl = h('div', { class: 'w-controls' });
    el.append(tl, stage, info, ctrl);
    const { ctx, st } = makeCanvas(stage, .5, 230, 340);
    let cur = 0, prev = -1, switchAt = 0, auto = false, autoTimer = null, now = 0;
    const btns = MODELS.map((m, i) => {
      const b = h('button', { class: 'w-step', role: 'tab', onclick: () => go(i) }, `<span>${m.year}</span><b>${m.who}</b>`);
      tl.appendChild(b); return b;
    });
    const prevB = h('button', { class: 'btn', onclick: () => go((cur + MODELS.length - 1) % MODELS.length) }, '← Précédent');
    const playB = h('button', { class: 'btn', onclick: () => setAuto(!auto) }, '▶ Lecture auto');
    const nextB = h('button', { class: 'btn primary', onclick: () => go((cur + 1) % MODELS.length) }, 'Suivant →');
    ctrl.append(prevB, playB, nextB);
    el.tabIndex = 0;
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go((cur + 1) % MODELS.length); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); e.stopPropagation(); go((cur + MODELS.length - 1) % MODELS.length); }
    });
    function setAuto(v) {
      auto = v; playB.textContent = v ? '❚❚ Pause' : '▶ Lecture auto';
      clearInterval(autoTimer);
      if (v) autoTimer = setInterval(() => { if (!el.isConnected) return clearInterval(autoTimer); go((cur + 1) % MODELS.length, true); }, 6000);
    }
    function go(i, fromAuto) {
      if (!fromAuto && auto) setAuto(false);
      if (i === cur && prev !== -1) return;
      prev = cur; cur = i; switchAt = now;
      btns.forEach((b, k) => { b.classList.toggle('active', k === i); b.classList.toggle('past', k < i); b.setAttribute('aria-selected', k === i); });
      const m = MODELS[i];
      info.innerHTML = `<div class="w-info-top"><span class="w-year">${m.year}</span><span class="w-news">${m.news}</span></div><h4>${m.who} — ${m.title}</h4><p>${m.text}</p>`;
      info.classList.remove('pop'); void info.offsetWidth; info.classList.add('pop');
    }
    go(0); prev = -1;
    loop(el, (t) => {
      now = t;
      ctx.clearRect(0, 0, st.w, st.h);
      const k = Math.min(1, (t - switchAt) / .45);
      if (prev >= 0 && k < 1) { ctx.globalAlpha = 1 - k; drawModel(ctx, prev, st.w, st.h, t); }
      ctx.globalAlpha = prev >= 0 ? k : 1;
      ctx.save(); ctx.translate(st.w / 2, st.h / 2); const sc = .85 + .15 * (prev >= 0 ? k : 1); ctx.scale(sc, sc); ctx.translate(-st.w / 2, -st.h / 2);
      drawModel(ctx, cur, st.w, st.h, t);
      ctx.restore(); ctx.globalAlpha = 1;
    });
  }

  // =====================================================================
  // 2) Simulation de l'expérience de Rutherford
  // =====================================================================
  function rutherford(el) {
    header(el, "L'expérience de Rutherford", 'Lance des particules α sur la feuille d’or');
    const stage = h('div', { class: 'w-stage dark' });
    const stats = h('div', { class: 'w-stats' });
    const ctrl = h('div', { class: 'w-controls' });
    const note = h('p', { class: 'w-note' });
    el.append(stage, stats, ctrl, note);
    const { ctx, st } = makeCanvas(stage, .46, 240, 340);

    let model = 'rutherford', burst = false, showAtoms = true;
    let parts = [], trails = [];
    const count = { pass: 0, dev: 0, back: 0 };
    const SPACING = 34, D = .3, V = 4.2;
    const foilX = () => st.w * .55;
    const nuclei = () => { const a = []; for (let y = SPACING / 2; y < st.h; y += SPACING) a.push(y); return a; };

    function fire(n = 1) {
      for (let i = 0; i < n; i++) {
        const y = st.h * .12 + Math.random() * st.h * .76;
        parts.push({ x: 70, y, vx: V, vy: 0, path: [[70, y]], done: false });
      }
    }
    const bFire = h('button', { class: 'btn primary', onclick: () => fire(1) }, '🎯 Lancer 1 particule');
    const bBurst = h('button', { class: 'btn', onclick: () => { burst = !burst; bBurst.textContent = burst ? '❚❚ Arrêter le faisceau' : '⚡ Faisceau continu'; } }, '⚡ Faisceau continu');
    const bModel = h('button', { class: 'btn', onclick: () => {
      model = model === 'rutherford' ? 'thomson' : 'rutherford';
      bModel.textContent = model === 'rutherford' ? 'Voir la prévision de Thomson' : 'Revenir au modèle de Rutherford';
      reset(); updNote();
    } }, 'Voir la prévision de Thomson');
    const bAtoms = h('button', { class: 'btn ghost', onclick: () => { showAtoms = !showAtoms; bAtoms.textContent = showAtoms ? 'Masquer les atomes' : 'Montrer les atomes'; } }, 'Masquer les atomes');
    const bReset = h('button', { class: 'btn ghost', onclick: () => reset() }, '↺ Réinitialiser');
    ctrl.append(bFire, bBurst, bModel, bAtoms, bReset);

    function reset() { parts = []; trails = []; count.pass = count.dev = count.back = 0; updStats(); }
    function updNote() {
      note.innerHTML = model === 'rutherford'
        ? "Modèle de <b>Rutherford</b> : le noyau positif, minuscule, repousse les particules α (positives) qui passent tout près. Dans la réalité, à peine <b>1 particule sur 10 000</b> rebondit ; ici l'effet est un peu exagéré pour qu'on le voie."
        : "Prévision du modèle de <b>Thomson</b> : la charge positive est étalée dans tout l'atome, donc les particules α devraient <b>toutes traverser presque sans déviation</b>. Les rebonds observés par Rutherford ont prouvé que ce modèle était faux !";
    }
    function updStats() {
      const tot = count.pass + count.dev + count.back;
      const pc = (x) => (tot ? ((x / tot) * 100).toFixed(1).replace('.', ',') : '0') + ' %';
      stats.innerHTML = `
        <div><span class="dot" style="background:#22c55e"></span><b>${count.pass}</b> traversent <small>${pc(count.pass)}</small></div>
        <div><span class="dot" style="background:#f59e0b"></span><b>${count.dev}</b> déviées <small>${pc(count.dev)}</small></div>
        <div><span class="dot" style="background:#ef4444"></span><b>${count.back}</b> renvoyées <small>${pc(count.back)}</small></div>
        <div><b>${tot}</b> particules lancées</div>`;
    }
    updStats(); updNote();

    let lastBurst = 0;
    loop(el, (t) => {
      const W = st.w, H = st.h, fx = foilX();
      if (burst && t - lastBurst > .07) { fire(1); lastBurst = t; }
      // physique
      const ys = nuclei();
      for (const p of parts) {
        if (p.done) continue;
        // pas de temps adaptatif : très fin près d'un noyau
        let tt = 0;
        for (let guard = 0; tt < 1 - 1e-9 && guard < 5000; guard++) {
          let dt = .125;
          if (model === 'rutherford' && Math.abs(p.x - fx) < 60) {
            const ny = ys.reduce((b, y) => (Math.abs(y - p.y) < Math.abs(b - p.y) ? y : b), ys[0]);
            const dx = p.x - fx, dy = p.y - ny, r2 = dx * dx + dy * dy + .0005, r = Math.sqrt(r2);
            dt = Math.min(.125, Math.max(.0005, r / 40));
            const a = (D * V * V / 2) / r2;
            p.vx += a * dx / r * dt; p.vy += a * dy / r * dt;
          }
          if (model === 'thomson' && Math.abs(p.x - fx) < 3) p.vy += (Math.random() - .5) * .004;
          dt = Math.min(dt, 1 - tt);
          p.x += p.vx * dt; p.y += p.vy * dt; tt += dt;
        }
        p.path.push([p.x, p.y]);
        if (p.x > W + 5 || p.x < -5 || p.y < -5 || p.y > H + 5) {
          p.done = true;
          const ang = Math.abs(Math.atan2(p.vy, p.vx)) * 180 / Math.PI;
          const kind = ang < 6 ? 'pass' : ang < 90 ? 'dev' : 'back';
          count[kind]++; updStats();
          trails.push({ path: p.path, kind, born: t });
        }
      }
      parts = parts.filter((p) => !p.done);
      if (trails.length > 140) trails.splice(0, trails.length - 140);

      // dessin
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#0f1424'; ctx.fillRect(0, 0, W, H);
      // écran fluorescent
      ctx.strokeStyle = 'rgba(34,197,94,.35)'; ctx.lineWidth = 6;
      ctx.beginPath(); ctx.arc(fx, H / 2, Math.min(W * .42, fx - 10), -Math.PI * .95, Math.PI * .95); ctx.stroke();
      // source
      ctx.fillStyle = '#4b5470'; ctx.fillRect(8, H / 2 - 30, 62, 60);
      ctx.fillStyle = '#fff'; ctx.font = '700 12px Segoe UI, Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Source α', 39, H / 2);
      // feuille d'or
      ctx.fillStyle = 'rgba(224,177,58,.22)'; ctx.fillRect(fx - 9, 0, 18, H);
      ys.forEach((y) => {
        if (showAtoms) {
          if (model === 'rutherford') {
            ctx.strokeStyle = 'rgba(147,197,253,.25)'; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(fx, y, SPACING / 2 - 1, 0, 7); ctx.stroke();
            ctx.fillStyle = '#ff6b70'; ctx.beginPath(); ctx.arc(fx, y, 2.2, 0, 7); ctx.fill();
          } else {
            ctx.fillStyle = 'rgba(241,154,162,.35)'; ctx.beginPath(); ctx.arc(fx, y, SPACING / 2 - 1, 0, 7); ctx.fill();
          }
        }
      });
      ctx.fillStyle = '#e0b13a'; ctx.font = '700 12px Segoe UI, Arial'; ctx.fillText("feuille d'or", fx, 12);
      // traces
      const col = { pass: '34,197,94', dev: '245,158,11', back: '239,68,68' };
      for (const tr of trails) {
        const age = t - tr.born, al = Math.max(tr.kind === 'pass' ? .05 : .25, 1 - age / (tr.kind === 'pass' ? 2 : 8));
        ctx.strokeStyle = `rgba(${col[tr.kind]},${al})`; ctx.lineWidth = tr.kind === 'pass' ? 1 : 2;
        ctx.beginPath(); tr.path.forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y))); ctx.stroke();
      }
      for (const p of parts) {
        ctx.strokeStyle = 'rgba(255,255,255,.5)'; ctx.lineWidth = 1.2;
        ctx.beginPath(); p.path.slice(-25).forEach(([x, y], i) => (i ? ctx.lineTo(x, y) : ctx.moveTo(x, y))); ctx.stroke();
        ball(ctx, p.x, p.y, 4, '#fbbf24');
      }
    });
  }

  // =====================================================================
  // 3) Constructeur d'atome
  // =====================================================================
  function atomBuilder(el) {
    header(el, "Construis ton atome", 'Ajoute ou retire des protons, neutrons et électrons');
    const wrap = h('div', { class: 'w-builder' });
    const left = h('div', { class: 'w-b-left' });
    const stage = h('div', { class: 'w-stage' });
    const right = h('div', { class: 'w-b-right' });
    const toast = h('div', { class: 'w-toast' });
    left.append(stage, toast);
    wrap.append(left, right);
    el.appendChild(wrap);
    const presets = h('div', { class: 'w-presets' });
    el.appendChild(presets);
    const { ctx, st } = makeCanvas(stage, .85, 260, 360);

    const s = { Z: 6, N: 6, E: 6 };
    const counters = {};
    const defs = [
      ['Z', 'Protons', P_COL, 1, 20, 'p'],
      ['N', 'Neutrons', N_COL, 0, 30, 'n'],
      ['E', 'Électrons', E_COL, 0, 20, 'e⁻']
    ];
    const ctrls = h('div', { class: 'w-counters' });
    defs.forEach(([key, label, color, min, max]) => {
      const val = h('output', { class: 'w-count-val' });
      const minus = h('button', { class: 'w-round', 'aria-label': 'Retirer un ' + label.toLowerCase(), onclick: () => change(key, -1) }, '−');
      const plus = h('button', { class: 'w-round', 'aria-label': 'Ajouter un ' + label.toLowerCase(), onclick: () => change(key, +1) }, '+');
      const row = h('div', { class: 'w-counter' }, `<span class="dot" style="background:${color}"></span><span class="w-count-label">${label}</span>`);
      row.append(minus, val, plus);
      ctrls.appendChild(row);
      counters[key] = { val, min, max };
    });
    const out = h('div', { class: 'w-out' });
    right.append(ctrls, out);

    const PRESETS = [
      ['Hydrogène', 1, 0, 1], ['Deutérium', 1, 1, 1], ['Carbone 12', 6, 6, 6], ['Carbone 14', 6, 8, 6],
      ['Oxygène', 8, 8, 8], ['Sodium', 11, 12, 11], ['Ion Na⁺', 11, 12, 10], ['Ion Cl⁻', 17, 18, 18], ['Ion O²⁻', 8, 8, 10], ['Argon', 18, 22, 18]
    ];
    presets.innerHTML = '<span class="muted">Exemples :</span>';
    PRESETS.forEach(([n, Z, N, E]) => presets.appendChild(h('button', { class: 'chip-btn', onclick: () => { Object.assign(s, { Z, N, E }); flash(n); render(); } }, n)));

    let toastT;
    function flash(msg) {
      toast.innerHTML = msg; toast.classList.add('show');
      clearTimeout(toastT); toastT = setTimeout(() => toast.classList.remove('show'), 2200);
    }
    function change(key, d) {
      const c = counters[key];
      const v = s[key] + d;
      if (v < c.min || v > c.max) return flash(v < c.min ? (key === 'Z' ? 'Il faut au moins 1 proton !' : 'Déjà à zéro') : 'Limite atteinte (Z ≤ 20 au programme)');
      const oldEl = ELEMENTS[s.Z][1];
      s[key] = v;
      if (key === 'Z') flash(`Nouvel élément : <b>${ELEMENTS[s.Z][1]}</b> — c'est Z qui définit l'élément !`);
      else if (key === 'N') flash(`Toujours du <b>${oldEl}</b> : on a fait un autre <b>isotope</b> (A = ${s.Z + s.N}).`);
      else flash(s.E === s.Z ? 'Autant d’électrons que de protons : <b>atome neutre</b>' : s.E < s.Z ? 'Électrons perdus → <b>cation</b> (ion positif)' : 'Électrons gagnés → <b>anion</b> (ion négatif)');
      render();
    }
    function render() {
      for (const k of ['Z', 'N', 'E']) counters[k].val.textContent = s[k];
      const [X, name, commonA] = ELEMENTS[s.Z];
      const A = s.Z + s.N, q = s.Z - s.E;
      const ionSym = q === 0 ? X : `${X}<sup>${Math.abs(q) > 1 ? Math.abs(q) : ''}${q > 0 ? '+' : '−'}</sup>`;
      const kind = q === 0 ? 'Atome neutre' : q > 0 ? `Cation (a perdu ${q} électron${q > 1 ? 's' : ''})` : `Anion (a gagné ${-q} électron${q < -1 ? 's' : ''})`;
      const sh = shells(s.E);
      const rep = sh.length ? sh.map((n, i) => `(${'KLMN'[i]})<sup>${n}</sup>`).join('') : '—';
      const mN = s.Z * 1.673e-27 + s.N * 1.675e-27, mE = s.E * 9.11e-31;
      const pct = (mE / (mN + mE)) * 100;
      const weird = Math.abs(q) > 3 ? '<p class="w-warn">Ion très peu probable dans la nature (charge trop grande).</p>' : '';
      const iso = A === commonA ? '' : `<p class="w-tip">Isotope de ${name.toLowerCase()} (l'isotope le plus courant a A = ${commonA}).</p>`;
      out.innerHTML = `
        <div class="w-symbol">${nucHTML(A, s.Z, X)}<div><b>${name}</b><span>${kind} : ${ionSym}</span></div></div>
        <table class="w-table">
          <tr><td>Nombre de charge</td><td><i>Z</i> = ${s.Z}</td></tr>
          <tr><td>Nombre de masse</td><td><i>A</i> = <i>Z</i> + <i>N</i> = ${A}</td></tr>
          <tr><td>Neutrons</td><td><i>N</i> = <i>A</i> − <i>Z</i> = ${s.N}</td></tr>
          <tr><td>Charge du noyau</td><td>${sci(s.Z * 1.6e-19)} C</td></tr>
          <tr><td>Charge totale</td><td>${q === 0 ? '0 (neutre)' : `${q > 0 ? '+' : '−'}${Math.abs(q) > 1 ? Math.abs(q) : ''}<i>e</i> = ${sci(q * 1.6e-19)} C`}</td></tr>
          <tr><td>Masse ≈ <i>A</i>·<i>m</i><sub>nucléon</sub></td><td>${sci(A * 1.67e-27)} kg</td></tr>
          <tr><td>Répartition électronique</td><td>${rep}</td></tr>
        </table>
        <div class="w-massbar" title="Part de la masse des électrons"><span style="width:${Math.max(.6, pct)}%"></span></div>
        <p class="w-small">Les électrons représentent seulement <b>${pct.toFixed(3).replace('.', ',')} %</b> de la masse → négligeable.</p>
        ${iso}${weird}`;
    }
    render();

    loop(el, (t) => {
      const W = st.w, H = st.h, cx = W / 2, cy = H / 2;
      ctx.clearRect(0, 0, W, H);
      const sh = shells(s.E);
      const maxR = Math.min(W, H) * .46;
      const nucS = Math.max(4, Math.min(9, 40 / Math.sqrt(s.Z + s.N)));
      const nucR = Math.sqrt(s.Z + s.N) * nucS;
      const base = nucR + 16, gap = sh.length ? (maxR - base) / Math.max(sh.length, 1) : 0;
      sh.forEach((n, k) => {
        const r = base + gap * (k + .7);
        ctx.strokeStyle = css('--text'); ctx.globalAlpha = .25; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.arc(cx, cy, r, 0, 7); ctx.stroke(); ctx.globalAlpha = 1;
        ctx.fillStyle = css('--accent'); ctx.font = '700 12px Segoe UI, Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('KLMN'[k], cx + r * .707 + 9, cy - r * .707 - 9);
        for (let e = 0; e < n; e++) {
          const a = (reduceMotion ? 0 : t * (1.2 - k * .25)) + e * Math.PI * 2 / n;
          ball(ctx, cx + Math.cos(a) * r, cy + Math.sin(a) * r, 6.5, E_COL, '−');
        }
      });
      drawNucleus(ctx, cx, cy, s.Z, s.N, nucS, t);
    });
  }

  // =====================================================================
  // 4) Zoom : de l'atome au noyau
  // =====================================================================
  function atomScale(el) {
    header(el, "Zoom : de l'atome au noyau", 'Fais glisser le curseur pour zoomer');
    const stage = h('div', { class: 'w-stage dark' });
    const slider = h('input', { type: 'range', min: '0', max: '1000', value: '0', class: 'w-range', 'aria-label': 'Zoom' });
    const lab = h('div', { class: 'w-zoomlab' });
    const cmp = h('div', { class: 'w-compare' });
    el.append(stage, slider, lab, cmp);
    const { ctx, st } = makeCanvas(stage, .5, 230, 320);
    const RA = 1e-10, RN = 1e-15;
    let z = 0, target = 0;
    slider.addEventListener('input', () => { target = +slider.value / 1000; });

    const OBJ = [['une bille', 1, 'cm'], ['une balle de tennis', 3.3, 'cm'], ['un ballon de football', 11, 'cm']];
    cmp.innerHTML = '<p><b>Et si le noyau était…</b></p>';
    const res = h('p', { class: 'w-compare-res' });
    const row = h('div', { class: 'w-presets' });
    OBJ.forEach(([n, r]) => row.appendChild(h('button', { class: 'chip-btn', onclick: () => {
      const km = (r * 1e5) / 1e5; // cm × 10^5 → km
      res.innerHTML = `Si le noyau était <b>${n}</b> de rayon ${String(r).replace('.', ',')} cm, l'atome aurait un rayon de ${String(r).replace('.', ',')} × 10<sup>5</sup> cm ≈ <b>${km.toLocaleString('fr-FR')} km</b> ! Entre les deux : du vide.`;
    } }, n)));
    cmp.append(row, res);
    row.firstChild.click();

    loop(el, (t) => {
      z += (target - z) * .12;
      const W = st.w, H = st.h, cx = W / 2, cy = H / 2;
      const view = 2.6e-10 / 10 ** (z * 4.8); // largeur du champ de vision (m)
      const px = W / view;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#0f1424'; ctx.fillRect(0, 0, W, H);
      const ra = RA * px;
      // nuage
      const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, ra);
      g.addColorStop(0, 'rgba(59,130,246,.55)'); g.addColorStop(.6, 'rgba(59,130,246,.18)'); g.addColorStop(1, 'rgba(59,130,246,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, Math.min(ra, W * 4), 0, 7); ctx.fill();
      if (ra < W * 2) { ctx.strokeStyle = 'rgba(147,197,253,.6)'; ctx.setLineDash([5, 5]); ctx.beginPath(); ctx.arc(cx, cy, ra, 0, 7); ctx.stroke(); ctx.setLineDash([]); }
      const rn = RN * px;
      if (rn >= 2.5) drawNucleus(ctx, cx, cy, 6, 6, rn / 3.6, t);
      else { ctx.fillStyle = '#ff6b70'; ctx.globalAlpha = Math.max(.15, rn / 2.5); ctx.beginPath(); ctx.arc(cx, cy, 1.2, 0, 7); ctx.fill(); ctx.globalAlpha = 1; }
      // échelle
      ctx.fillStyle = '#cbd5e1'; ctx.font = '12px Segoe UI, Arial'; ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      ctx.fillText('Champ de vision : ' + sci(view, 1).replace(/<sup>(.*?)<\/sup>/, (_, e) => [...e].map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[c] || (c === '−' ? '⁻' : c)).join('')) + ' m', 12, H - 12);
      ctx.textAlign = 'right';
      ctx.fillText('Zoom × ' + Math.round(10 ** (z * 4.8)).toLocaleString('fr-FR'), W - 12, H - 12);
      ctx.textAlign = 'center';
      if (rn < 2.5) ctx.fillText('le noyau est encore invisible à cette échelle…', cx, 20);
      else if (ra > W * 1.5) ctx.fillText("on ne voit plus le bord de l'atome : il est très loin !", cx, 20);
      lab.innerHTML = `Rayon de l'atome : <b>10<sup>−10</sup> m</b> &nbsp;·&nbsp; rayon du noyau : <b>10<sup>−15</sup> m</b> &nbsp;·&nbsp; rapport : <b>10<sup>5</sup></b>`;
    });
  }

  // =====================================================================
  // 5) Quiz (questions dans un fichier JSON du contenu)
  // =====================================================================
  async function quiz(el, api) {
    header(el, 'Teste-toi !', 'Choisis une réponse pour chaque question');
    const data = (await api.readJSON(el.dataset.src)) || [];
    if (!data.length) { el.appendChild(h('p', { class: 'muted' }, 'Quiz indisponible.')); return; }
    const box = h('div', { class: 'w-quiz' });
    el.appendChild(box);
    let i = 0, score = 0, answered = false;
    const show = () => {
      if (i >= data.length) {
        const pct = Math.round((score / data.length) * 100);
        const msg = pct === 100 ? 'Parfait ! 🎉' : pct >= 70 ? 'Très bien ! 👏' : pct >= 50 ? 'Pas mal, relis la fiche.' : 'Relis la leçon et réessaie 💪';
        box.innerHTML = `<div class="w-quiz-end"><div class="w-score">${score} / ${data.length}</div><p>${msg}</p></div>`;
        box.appendChild(h('button', { class: 'btn primary', onclick: () => { i = 0; score = 0; show(); } }, '↺ Recommencer'));
        return;
      }
      const q = data[i]; answered = false;
      box.innerHTML = `<div class="w-quiz-top"><span>Question ${i + 1} / ${data.length}</span><span>Score : ${score}</span></div>
        <div class="w-quiz-bar"><span style="width:${(i / data.length) * 100}%"></span></div>
        <p class="w-q">${q.q}</p>`;
      const opts = h('div', { class: 'w-opts' });
      const fb = h('div', { class: 'w-fb' });
      q.choices.forEach((c, k) => opts.appendChild(h('button', { class: 'w-opt', onclick: (e) => {
        if (answered) return; answered = true;
        const ok = k === q.answer; if (ok) score++;
        [...opts.children].forEach((b, j) => { b.disabled = true; if (j === q.answer) b.classList.add('ok'); });
        if (!ok) e.currentTarget.classList.add('ko');
        fb.innerHTML = `<b>${ok ? '✔ Bonne réponse !' : '✘ Mauvaise réponse.'}</b> ${q.explain || ''}`;
        fb.className = 'w-fb ' + (ok ? 'ok' : 'ko');
        const next = h('button', { class: 'btn primary', onclick: () => { i++; show(); } }, i + 1 < data.length ? 'Question suivante →' : 'Voir mon score');
        box.appendChild(next); next.focus();
      } }, c)));
      box.append(opts, fb);
    };
    show();
  }

  // =====================================================================
  // 6) Atome cliquable (structure)
  // =====================================================================
  const PARTS_INFO = {
    noyau: { t: 'Le noyau', c: '#7c3aed', d: "Au centre de l'atome. Chargé <b>positivement</b> (charge <i>Z</i>·<i>e</i>). Minuscule (rayon ≈ 10<sup>−15</sup> m) mais il contient presque <b>toute la masse</b> de l'atome. Il est formé de protons et de neutrons." },
    proton: { t: 'Le proton', c: P_COL, d: 'Dans le noyau. Charge <b>+<i>e</i> = +1,6 × 10<sup>−19</sup> C</b>. Masse <i>m</i><sub>p</sub> ≈ 1,67 × 10<sup>−27</sup> kg. Leur nombre est <b><i>Z</i></b>.' },
    neutron: { t: 'Le neutron', c: N_COL, d: 'Dans le noyau. <b>Neutre</b> (charge 0). Masse <i>m</i><sub>n</sub> ≈ 1,67 × 10<sup>−27</sup> kg (presque comme le proton).' },
    electron: { t: "L'électron", c: E_COL, d: 'Autour du noyau (nuage électronique). Charge <b>−<i>e</i> = −1,6 × 10<sup>−19</sup> C</b>. Très léger : <i>m</i><sub>e</sub> ≈ 9,11 × 10<sup>−31</sup> kg (1836 fois moins qu’un proton). Un atome a <b>autant d’électrons que de protons</b>.' },
    vide: { t: 'Le vide', c: '#64748b', d: "Entre le noyau et les électrons, il n'y a <b>rien</b> : l'atome est essentiellement vide (structure <b>lacunaire</b>). Rayon de l’atome ≈ 10<sup>−10</sup> m, soit 100 000 fois celui du noyau." }
  };
  function atomExplorer(el) {
    header(el, "Explore l'atome", 'Clique sur chaque partie de l’atome');
    const wrap = h('div', { class: 'w-explorer' });
    const pv = (x, y, k) => `<circle class="ex-hit" data-k="${k}" cx="${x}" cy="${y}" r="11" fill="${k === 'proton' ? P_COL : N_COL}" stroke="#fff" stroke-width="1.5"/>`;
    const nuc = [[-8, -6, 'proton'], [8, -6, 'neutron'], [0, 6, 'proton'], [-12, 8, 'neutron'], [12, 8, 'proton'], [0, -16, 'neutron']].map(([x, y, k]) => pv(150 + x, 150 + y, k)).join('');
    wrap.innerHTML = `
      <svg viewBox="0 0 300 300" class="ex-svg" role="img" aria-label="Atome cliquable">
        <defs><radialGradient id="exCloud"><stop offset="0" stop-color="#3b82f6" stop-opacity=".18"/><stop offset="1" stop-color="#3b82f6" stop-opacity=".02"/></radialGradient></defs>
        <circle class="ex-hit" data-k="vide" cx="150" cy="150" r="140" fill="url(#exCloud)" stroke="#3b82f6" stroke-opacity=".25" stroke-dasharray="4 5"/>
        <circle cx="150" cy="150" r="62" fill="none" stroke="currentColor" stroke-opacity=".25"/>
        <circle cx="150" cy="150" r="108" fill="none" stroke="currentColor" stroke-opacity=".25"/>
        <g class="ex-orbit o1"><circle class="ex-hit" data-k="electron" cx="212" cy="150" r="9" fill="${E_COL}"/><circle class="ex-hit" data-k="electron" cx="88" cy="150" r="9" fill="${E_COL}"/></g>
        <g class="ex-orbit o2"><circle class="ex-hit" data-k="electron" cx="150" cy="42" r="9" fill="${E_COL}"/><circle class="ex-hit" data-k="electron" cx="243" cy="204" r="9" fill="${E_COL}"/><circle class="ex-hit" data-k="electron" cx="57" cy="204" r="9" fill="${E_COL}"/><circle class="ex-hit" data-k="electron" cx="150" cy="258" r="9" fill="${E_COL}"/></g>
        <circle class="ex-hit" data-k="noyau" cx="150" cy="150" r="30" fill="#7c3aed" fill-opacity=".12" stroke="#7c3aed" stroke-dasharray="3 3"/>
        ${nuc}
      </svg>
      <div class="ex-panel"><p class="muted">👆 Clique sur un <b>proton</b>, un <b>neutron</b>, un <b>électron</b>, le <b>noyau</b> ou le <b>vide</b>.</p><div class="ex-found"></div></div>`;
    el.appendChild(wrap);
    const panel = wrap.querySelector('.ex-panel');
    const seen = new Set();
    wrap.querySelector('svg').addEventListener('click', (e) => {
      const k = e.target.closest('.ex-hit')?.dataset.k;
      if (!k) return;
      seen.add(k);
      const p = PARTS_INFO[k];
      wrap.querySelectorAll('.ex-hit').forEach((c) => c.classList.toggle('sel', c.dataset.k === k));
      panel.innerHTML = `<h4 style="color:${p.c}">${p.t}</h4><p>${p.d}</p>
        <div class="ex-found">${Object.keys(PARTS_INFO).map((x) => `<span class="${seen.has(x) ? 'on' : ''}">${seen.has(x) ? '✔' : '○'} ${PARTS_INFO[x].t.replace(/^(Le |L’|L')/, '')}</span>`).join('')}</div>
        ${seen.size === 5 ? '<p class="w-tip">Bravo, tu as exploré tout l’atome ! 🎉</p>' : ''}`;
      panel.classList.remove('pop'); void panel.offsetWidth; panel.classList.add('pop');
    });
  }

  // =====================================================================
  // 7) Curseur sur le noyau : charge (data-mode="charge") ou masse (data-mode="masse")
  // =====================================================================
  function nucleusSlider(el) {
    const mode = el.dataset.mode === 'masse' ? 'masse' : 'charge';
    header(el, mode === 'charge' ? 'La charge du noyau' : "La masse de l'atome", 'Fais glisser le curseur');
    const wrap = h('div', { class: 'w-ns' });
    const stage = h('div', { class: 'w-stage' });
    const side = h('div', { class: 'w-ns-side' });
    wrap.append(stage, side);
    el.appendChild(wrap);
    const max = 30;
    const range = h('input', { type: 'range', min: '1', max: String(max), value: mode === 'charge' ? '6' : '12', class: 'w-range', 'aria-label': mode === 'charge' ? 'Nombre de protons' : 'Nombre de nucléons' });
    const out = h('div', { class: 'w-ns-out' });
    side.append(range, out);
    const { ctx, st } = makeCanvas(stage, .75, 200, 260);
    const render = () => {
      const v = +range.value;
      if (mode === 'charge') {
        const el2 = ELEMENTS[Math.min(v, 20)];
        out.innerHTML = `<p class="w-big"><i>Z</i> = ${v} proton${v > 1 ? 's' : ''}</p>
          <div class="formula key"><span><i>Q</i> = <i>Z</i>·<i>e</i> = ${v} × 1,6 × 10<sup>−19</sup> = ${sci(v * 1.6e-19)} C</span></div>
          <p class="w-small">${v <= 20 ? `Élément : <b>${el2[1]}</b> (${el2[0]})` : ''} · Les neutrons ne changent pas la charge.</p>`;
      } else {
        const m = v * 1.67e-27;
        out.innerHTML = `<p class="w-big"><i>A</i> = ${v} nucléon${v > 1 ? 's' : ''}</p>
          <div class="formula key"><span><i>m</i> ≈ <i>A</i>·<i>m</i><sub>nucléon</sub> = ${v} × 1,67 × 10<sup>−27</sup> ≈ ${sci(m)} kg</span></div>
          <p class="w-small">Les électrons ne comptent presque pas : chaque électron pèse 1836 fois moins qu'un nucléon.</p>`;
      }
    };
    range.addEventListener('input', render);
    render();
    loop(el, (t) => {
      const v = +range.value;
      const Z = mode === 'charge' ? v : Math.ceil(v / 2), N = mode === 'charge' ? Math.round(v * 1.1) : Math.floor(v / 2);
      ctx.clearRect(0, 0, st.w, st.h);
      const s = Math.max(5, Math.min(12, 60 / Math.sqrt(Z + N)));
      drawNucleus(ctx, st.w / 2, st.h / 2, Z, N, s, t);
      ctx.fillStyle = css('--muted'); ctx.font = '12px Segoe UI, Arial'; ctx.textAlign = 'center';
      ctx.fillText(mode === 'charge' ? `${Z} protons (+)  ·  ${N} neutrons` : `${Z} protons + ${N} neutrons = ${v} nucléons`, st.w / 2, st.h - 10);
    });
