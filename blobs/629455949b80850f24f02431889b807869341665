  const langOf = (el) => (el.closest('[lang]')?.getAttribute('lang') || 'fr').slice(0, 2);
  const S_ = (el) => STR[langOf(el)] || STR.fr;
  const LEVELS = [
    { id: 'facile', i: 0, icon: '🟢', need: 'all' },
    { id: 'moyen', i: 1, icon: '🟠', need: 'all' },
    { id: 'difficile', i: 2, icon: '🔴', need: 'perfect' }
  ];
  // Normalisation des réponses écrites (français, anglais, arabe)
  const norm = (s) => String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[ً-ٰٟـ]/g, '').replace(/[أإآٱ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي').replace(/ؤ/g, 'و').replace(/ئ/g, 'ي')
    .replace(/[’'`«»"“”]/g, ' ').replace(/[.!?;:،؟,]+/g, ' ')
    .replace(/(^|\s)(le|la|les|l|un|une|des|du|de|d|the|a|an|to)(?=\s|$)/g, ' ').replace(/(^|\s)ال(?=\S{2,})/g, '$1').replace(/\s+/g, ' ').trim();
  const normFormula = (s) => norm(s).replace(/[\s()_{}]/g, '').replace(/[×·.x]/g, '*');
  // Accepte : 14 · 2,08 · 2.08 · 2,08e-18 · 2,08E-18 · 2,08×10^-18 · 2,08x10^-18 · 2,08*10^-18
  //           2,08.10^-18 · 2,08·10-18 · 2,08×10⁻¹⁸ · 2,08x10**-18 · 10^-10 · 10⁻¹⁰ (+ unité finale ignorée)
  const SUP = { '⁰': '0', '¹': '1', '²': '2', '³': '3', '⁴': '4', '⁵': '5', '⁶': '6', '⁷': '7', '⁸': '8', '⁹': '9', '⁻': '-', '⁺': '+' };
  function parseNum(s) {
    let t = String(s).trim().replace(/[٠-٩]/g, (d) => '٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/\s+/g, '').replace(/[−–—]/g, '-').replace(/\*\*/g, '^')
      .replace(/puissance/gi, '^').replace(/[ˆ＾]/g, '^')
      .replace(/[⁰¹²³⁴⁵⁶⁷⁸⁹⁻⁺]+/g, (r) => '^' + [...r].map((c) => SUP[c]).join(''));
    t = t.replace(/\^+/g, '^').replace(/(n·m|n\.m|n\/kg|n\/m|n|j|w|mv|v|ma|µa|ua|a|kΩ|Ω|ohms?|hz|ms|rad\/s|rad|mol\/l|mmol|mol|g\/mol|g\/l|ml|l|m\/s|km\/h|km|cm\^3|m\^3|°c|div|entités)$/i, '')
      .replace(/(kg|g|m|cm|c|s|%|µm|nm|atomes?|protons?|neutrons?|électrons?|electrons?|nucléons?|nucleons?|ans|couches|particules|°)$/i, '');
    const num = (x) => parseFloat(x.replace(',', '.'));
    let m = t.match(/^([+-]?(?:\d+(?:[.,]\d+)?|[.,]\d+))(?:(?:[x×*·.]10\^?|10\^)([+-]?\d+)|e([+-]?\d+))?$/i);
    if (m) return num(m[1]) * 10 ** parseInt(m[2] ?? m[3] ?? '0', 10);
    m = t.match(/^([+-])?10\^([+-]?\d+)$/);
    if (m) return (m[1] === '-' ? -1 : 1) * 10 ** parseInt(m[2], 10);
    m = t.match(/^([+-]?\d+)\/(\d+)$/); // fraction simple : 3/4
    if (m && +m[2] !== 0) return parseInt(m[1], 10) / parseInt(m[2], 10);
    return NaN;
  }
  const store = {
    get(k) { try { return JSON.parse(localStorage.getItem(k)) || null; } catch { return null; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }
  };
  const escHTML = (v) => String(v).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
  function correctText(q) {
    if (q.type === 'qcm') return q.choices[q.answer];
    if (q.type === 'calc') return (q.display || sci(q.answer, q.digits ?? 2)) + (q.unit ? ' ' + q.unit : '');
    return q.display || q.accept[0];
  }
  function whyCalc(q, x, S) {
    const r = x / q.answer;
    if (q.answer !== 0 && Number.isFinite(r) && r !== 0) {
      const l = Math.log10(Math.abs(r));
      if (Math.abs(l - Math.round(l)) < 0.01 && Math.round(l) !== 0) return S.pow;
      if (r < 0) return S.sign;
    }
    return q.whyWrong || S.calcWrong;
  }
  function burst(host) {
    const c = h('div', { class: 'confetti' });
    for (let i = 0; i < 40; i++) c.appendChild(h('i', { style: `left:${Math.random() * 100}%;background:hsl(${Math.random() * 360},90%,60%);animation-delay:${Math.random() * .6}s` }));
    host.appendChild(c);
    setTimeout(() => c.remove(), 2600);
  }

  // Affiche une question dans `zoneHost` ; appelle onAnswer(ok, actions, fb) à chaque réponse.
  function askQuestion(zoneHost, q, S, onAnswer) {
    const zone = h('div', { class: 'lv-zone' });
    const fb = h('div', { class: 'w-fb' });
    const actions = h('div', { class: 'lv-actions' });
    zoneHost.append(zone, fb, actions);
    const verdict = (ok, given) => {
      if (ok) {
        fb.className = 'w-fb ok';
        fb.innerHTML = `<b>${S.good}</b> ${q.explain || ''}`;
      } else {
        fb.className = 'w-fb ko';
        fb.innerHTML = `<b>${S.bad}</b>
          ${given ? `<p><b>${S.why}</b> ${given}</p>` : ''}
          <p><b>${S.answer}</b> ${correctText(q)}</p>
          ${q.explain ? `<p><b>${S.expl}</b> ${q.explain}</p>` : ''}`;
      }
      actions.innerHTML = '';
      onAnswer(ok, actions, fb);
    };
    if (q.type === 'qcm') {
      const opts = h('div', { class: 'w-opts' });
      q.choices.forEach((c, k) => opts.appendChild(h('button', { class: 'w-opt', onclick: (e) => {
        [...opts.children].forEach((b) => (b.disabled = true));
        const ok = k === q.answer;
        e.currentTarget.classList.add(ok ? 'ok' : 'ko');
        if (!ok) opts.children[q.answer].classList.add('ok');
        verdict(ok, ok ? '' : (q.why && q.why[k]) || S.notChoice(c));
      } }, c)));
      zone.appendChild(opts);
      return;
    }
    const form = h('form', { class: 'lv-form' });
    const inp = h('input', { class: 'lv-input', type: 'text', autocomplete: 'off', spellcheck: 'false', placeholder: S.yours, dir: 'auto' });
    const unit = q.unit ? h('span', { class: 'lv-unit' }, q.unit) : null;
    const ok = h('button', { class: 'btn primary', type: 'submit' }, S.validate);
    let exp = null;
    if (q.type === 'calc') {
      inp.placeholder = S.num;
      inp.classList.add('lv-mant');
      inp.setAttribute('dir', 'ltr');
      if (q.sci !== false) {
        exp = h('input', { class: 'lv-input lv-exp', type: 'text', autocomplete: 'off', spellcheck: 'false', inputmode: 'numeric', placeholder: 'n', dir: 'ltr', 'aria-label': 'Exposant de 10' });
        exp.addEventListener('input', () => { exp.value = exp.value.replace(/[−–]/g, '-').replace(/[^0-9+-]/g, ''); });
        const sup = h('span', { class: 'lv-sup' }); sup.appendChild(exp);
        const grp = h('span', { class: 'lv-sci', dir: 'ltr' });
        grp.append(inp, h('span', { class: 'lv-pow' }, '× 10'), sup);
        form.append(grp);
      } else form.append(inp);
    } else form.append(inp);
    if (unit) form.append(unit);
    form.append(ok);
    zone.append(form);
    if (q.type === 'calc' && exp) zone.appendChild(h('p', { class: 'w-small' }, S.numHelp));
    setTimeout(() => inp.focus(), 30);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = inp.value.trim();
      const ev = exp ? exp.value.trim() : '';
      if (!v && !ev) { inp.focus(); return; }
      const lock = (b) => { inp.disabled = b; ok.disabled = b; if (exp) exp.disabled = b; };
      lock(true);
      if (q.type === 'calc') {
        let x = parseNum(v || '1');
        if (ev) x = /^[+-]?\d+$/.test(ev) ? x * 10 ** parseInt(ev, 10) : NaN;
        if (Number.isNaN(x)) { lock(false); fb.className = 'w-fb ko'; fb.innerHTML = S.numErr; return; }
        const good = Math.abs(x - q.answer) <= Math.abs(q.answer) * Math.max(q.tol ?? 0.02, 1e-9) + 1e-12 * (q.answer === 0 ? 1 : 0) + 1e-300;
        verdict(good, good ? '' : whyCalc(q, x, S));
      } else {
        const n = q.formula ? normFormula(v) : norm(v);
        const good = q.accept.some((a) => (q.formula ? normFormula(a) : norm(a)) === n);
        verdict(good, good ? '' : (q.whyWrong || S.notMatch(escHTML(v))));
      }
    });
  }

  async function levels(el, api) {
    const all = (await api.readJSON(el.dataset.src)) || {};
    const part = all[el.dataset.part];
    if (!part) return;
    const S = S_(el);
    const lab = (L) => S.levels[L.i];
    el.classList.add('widget', 'w-levels');
    const key = 'tcsf:' + el.dataset.src + ':' + el.dataset.part;
    const saved = store.get(key) || {};
    const state = {};
    LEVELS.forEach((L) => { state[L.id] = saved[L.id] && saved[L.id].done ? { done: true, perfect: saved[L.id].perfect, best: saved[L.id].best } : { done: false }; });

    const head = h('div', { class: 'w-head' }, `<span class="w-badge">${S.exos}</span><b>${S.train}</b><span class="w-hint">${S.mix}</span>`);
    const tabs = h('div', { class: 'lv-tabs' });
    const scoreEl = h('div', { class: 'lv-score' });
    const body = h('div', { class: 'lv-body' });
    el.append(head, tabs, scoreEl, body);
    const unlocked = (L) => {
      if (L.i === 0) return true;
      const ps = state[LEVELS[L.i - 1].id];
      return ps.done && (L.need !== 'perfect' || ps.perfect);
    };
    let current = LEVELS.find((L) => !state[L.id].done && unlocked(L))?.id || 'facile';
    const lockMsg = (L) => (L.need === 'perfect' ? S.lockPerfect : S.lockPrev);
    function save() {
      const o = {};
      LEVELS.forEach((L) => { if (state[L.id].done) o[L.id] = { done: true, perfect: state[L.id].perfect, best: state[L.id].best }; });
      store.set(key, o);
    }
    function drawTabs() {
      tabs.innerHTML = '';
      LEVELS.forEach((L) => {
        const s = state[L.id], open = unlocked(L);
        const b = h('button', { class: `lv-tab ${L.id} ${current === L.id ? 'active' : ''} ${open ? '' : 'locked'}`, title: open ? '' : lockMsg(L) },
          `${open ? L.icon : '🔒'} ${lab(L)}${s.done ? ' <span class="lv-ok">✔</span>' : ''}`);
        b.addEventListener('click', () => {
          if (!open) { body.querySelector('.lv-lockmsg')?.remove(); body.prepend(h('div', { class: 'lv-lockmsg' }, '🔒 ' + lockMsg(L))); return; }
          current = L.id; startLevel(L, s.done);
        });
        tabs.appendChild(b);
      });
      const total = LEVELS.reduce((a, L) => a + (part[L.id] || []).length, 0);
      const got = LEVELS.reduce((a, L) => a + (state[L.id].best || 0), 0);
      scoreEl.innerHTML = `${S.partScore} : <b>${got} / ${total}</b> <span class="muted">${S.firstTry}</span>`;
    }
    function startLevel(L, review) {
      const qs = part[L.id] || [];
      const run = { first: qs.map(() => null), i: 0 };
      drawTabs();
      const show = () => {
        if (run.i >= qs.length) return finish();
        const q = qs[run.i];
        body.innerHTML = `
          <div class="lv-top"><span class="lv-pill ${L.id}">${L.icon} ${lab(L)}</span><span>${S.q} ${run.i + 1} / ${qs.length}</span>
            <span class="lv-type">${S.types[q.type]}</span></div>
          <div class="w-quiz-bar"><span style="width:${(run.i / qs.length) * 100}%"></span></div>
          ${run.i === 0 ? `<p class="w-small">${S.intro[L.i]}</p>` : ''}
          <p class="w-q">${q.q}</p>`;
        askQuestion(body, q, S, (ok, actions) => {
          if (run.first[run.i] === null) run.first[run.i] = ok;
          if (ok) {
            const nx = h('button', { class: 'btn primary', onclick: () => { run.i++; show(); } }, run.i + 1 < qs.length ? S.next : S.endLevel);
            actions.appendChild(nx); nx.focus();
          } else actions.appendChild(h('button', { class: 'btn', onclick: () => show() }, S.retry));
        });
      };
      const finish = () => {
        const firstOk = run.first.filter(Boolean).length;
        const perfect = firstOk === qs.length;
        const s = state[L.id];
        s.done = true; s.perfect = s.perfect || perfect; s.best = Math.max(s.best || 0, firstOk);
        save(); drawTabs();
        const next = LEVELS[L.i + 1];
        let msg, btn = null;
        if (!next) msg = perfect ? S.master : S.redoPerfect;
        else if (unlocked(next)) {
          msg = S.unlocked(lab(next));
          btn = h('button', { class: 'btn primary', onclick: () => { current = next.id; startLevel(next); } }, S.goTo(lab(next)));
        } else msg = S.needPerfect(qs.length - firstOk, lab(next));
        body.innerHTML = `<div class="w-quiz-end"><div class="w-score">${firstOk} / ${qs.length}</div><p>${msg}</p></div>`;
        const act = h('div', { class: 'lv-actions center' });
        if (btn) act.appendChild(btn);
        act.appendChild(h('button', { class: 'btn', onclick: () => startLevel(L) }, S.again));
        body.appendChild(act);
        if (perfect && !next) burst(body);
        window.dispatchEvent(new CustomEvent('tcsf:activity', { detail: { act: 'exo', src: el.dataset.src } }));
      };
      if (review) {
        body.innerHTML = `<div class="w-quiz-end"><div class="w-score">${state[L.id].best || 0} / ${qs.length}</div><p>${S.done}</p></div>`;
        const act = h('div', { class: 'lv-actions center' });
        act.appendChild(h('button', { class: 'btn primary', onclick: () => startLevel(L) }, S.redo));
        body.appendChild(act);
      } else show();
    }
    drawTabs();
    const curL = LEVELS.find((L) => L.id === current);
    startLevel(curL, state[curL.id].done);
  }

  // =====================================================================
  // 9) Examen blanc : questions tirées au hasard dans les leçons d'une matière
  // =====================================================================
  async function exam(el, api) {
    const S = STR[api.lang] || STR.fr;
    const E = S.exam;
    el.classList.add('widget', 'w-levels');
    if (api.lang === 'ar') el.setAttribute('dir', 'rtl');
    const datas = await Promise.all(api.lessons.map(async (l) => ({ l, d: await api.readJSON(l.data) })));
    const pool = [];
    datas.forEach(({ l, d }) => { if (!d || !d.exercises) return; LEVELS.forEach((L) => (d.exercises[L.id] || []).forEach((q) => pool.push({ q, lesson: l, level: L }))); });
    el.innerHTML = `<div class="w-head"><span class="w-badge">${S.exos}</span><b>${E.title}</b></div>`;
    const body = h('div', { class: 'lv-body' });
    el.appendChild(body);
    if (!pool.length) { body.innerHTML = `<p class="muted">${E.empty}</p>`; return; }
    const modules = [...new Set(api.lessons.map((l) => l.module || l.partie).filter(Boolean))];
    // choix libre : on coche les unités et/ou les leçons voulues (plusieurs à la fois)
    const PK = ({ fr: { all: 'Tout cocher', none: 'Tout décocher', need: 'Coche au moins une leçon.', sel: (n) => `${n} leçon(s) choisie(s)`, other: 'Autres leçons' },
      ar: { all: 'تحديد الكل', none: 'إلغاء الكل', need: 'اختر درسا واحدا على الأقل.', sel: (n) => `${n} درس(دروس) مختارة`, other: 'دروس أخرى' },
      en: { all: 'Select all', none: 'Clear all', need: 'Tick at least one lesson.', sel: (n) => `${n} lesson(s) selected`, other: 'Other lessons' } })[api.lang] || {};
    const pickKey = 'tcsf:exam-pick:' + (api.lessons[0] ? String(api.lessons[0].data).split('/')[0] : '');
    function setup() {
      const groups = modules.map((m) => [m, api.lessons.filter((l) => (l.module || l.partie) === m)]);
      const loose = api.lessons.filter((l) => !(l.module || l.partie));
      if (loose.length) groups.push([PK.other, loose]);
      let saved = null; try { saved = JSON.parse(localStorage.getItem(pickKey)); } catch {}
      const on = (id) => !saved || saved.includes(id);
      body.innerHTML = `<p>${E.intro}</p>
        <div class="ex-pick"><div class="ex-pick-top"><b>${E.lessons}</b><span class="ex-pick-n w-small"></span><span class="ex-pick-btns"><button type="button" class="chip-btn" data-all>☑ ${PK.all}</button><button type="button" class="chip-btn" data-none>☐ ${PK.none}</button></span></div>
          <div class="ex-mods">${groups.map(([m, ls], gi) => `<fieldset class="ex-mod"><legend><label><input type="checkbox" data-g="${gi}"> <b>${escHTML(m)}</b></label></legend>
            ${ls.map((l) => `<label class="ex-les"><input type="checkbox" data-l="${escHTML(l.id)}" data-gi="${gi}" ${on(l.id) ? 'checked' : ''}> ${escHTML(l.title)}</label>`).join('')}</fieldset>`).join('')}</div></div>
        <div class="ex-setup">
          <label>${E.count}<select class="lv-input" id="exN"><option>10</option><option selected>20</option><option>30</option><option>40</option></select></label>
          <label>${E.level}<select class="lv-input" id="exD"><option value="">${E.mixed}</option>${LEVELS.map((L) => `<option value="${L.id}">${L.icon} ${S.levels[L.i]}</option>`).join('')}</select></label>
        </div><p class="ex-pick-msg w-small"></p>`;
      const boxes = [...body.querySelectorAll('[data-l]')];
      const sync = () => {
        body.querySelectorAll('[data-g]').forEach((g) => {
          const kids = boxes.filter((b) => b.dataset.gi === g.dataset.g), n = kids.filter((b) => b.checked).length;
          g.checked = n === kids.length; g.indeterminate = n > 0 && n < kids.length;
        });
        body.querySelector('.ex-pick-n').textContent = PK.sel(boxes.filter((b) => b.checked).length);
        try { localStorage.setItem(pickKey, JSON.stringify(boxes.filter((b) => b.checked).map((b) => b.dataset.l))); } catch {}
      };
      body.querySelectorAll('[data-g]').forEach((g) => g.addEventListener('change', () => { boxes.filter((b) => b.dataset.gi === g.dataset.g).forEach((b) => (b.checked = g.checked)); sync(); }));
      boxes.forEach((b) => b.addEventListener('change', sync));
      body.querySelector('[data-all]').addEventListener('click', () => { boxes.forEach((b) => (b.checked = true)); sync(); });
      body.querySelector('[data-none]').addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); sync(); });
      sync();
      const go = h('button', { class: 'btn primary', onclick: () => {
        const ids = new Set(boxes.filter((b) => b.checked).map((b) => b.dataset.l));
        const n = +body.querySelector('#exN').value, d = body.querySelector('#exD').value;
        if (!ids.size) { body.querySelector('.ex-pick-msg').textContent = PK.need; return; }
        let sel = pool.filter((p) => (!d || p.level.id === d) && ids.has(p.lesson.id));
        sel = sel.map((p) => [Math.random(), p]).sort((a, b) => a[0] - b[0]).map((x) => x[1]).slice(0, n);
        if (!sel.length) { body.querySelector('.ex-pick-msg').textContent = E.empty; return; }
        run(sel);
      } }, E.start);
      body.appendChild(h('div', { class: 'lv-actions center' })).appendChild(go);
    }
    function run(list) {
      let i = 0, good = 0;
      const mistakes = [];
      const t0 = Date.now();
      const show = () => {
        if (i >= list.length) return end();
        const { q, lesson, level } = list[i];
        const mm = Math.floor((Date.now() - t0) / 60000), ss = Math.floor(((Date.now() - t0) / 1000) % 60);
        body.innerHTML = `<div class="lv-top"><span class="lv-pill ${level.id}">${level.icon} ${S.levels[level.i]}</span><span>${S.q} ${i + 1} / ${list.length}</span>
          <span class="lv-type">⏱ ${mm}:${String(ss).padStart(2, '0')} · ${S.score} ${good}</span></div>
          <div class="w-quiz-bar"><span style="width:${(i / list.length) * 100}%"></span></div>
          <p class="w-small">${escHTML(lesson.title)}</p><p class="w-q">${q.q}</p>`;
        askQuestion(body, q, S, (ok, actions) => {
          if (ok) good++; else mistakes.push(list[i]);
          body.querySelectorAll('.lv-input, .lv-form button').forEach((x) => (x.disabled = true));
          const nx = h('button', { class: 'btn primary', onclick: () => { i++; show(); } }, i + 1 < list.length ? S.next : E.finish);
          actions.appendChild(nx); nx.focus();
        });
      };
      const end = () => {
        const note = Math.round((good / list.length) * 20 * 4) / 4;
        const sec = Math.round((Date.now() - t0) / 1000);
        body.innerHTML = `<div class="w-quiz-end"><div class="w-score">${String(note).replace('.', ',')} / 20</div>
          <p>${good} / ${list.length} · ${E.time} ${Math.floor(sec / 60)} min ${sec % 60} s</p></div>
          <h4>${E.mistakes}</h4>
          ${mistakes.length ? `<ol class="ex-mist">${mistakes.map(({ q, lesson }) => `<li><p>${q.q}</p><p><b>${S.answer}</b> ${correctText(q)}</p>${q.explain ? `<p class="muted">${q.explain}</p>` : ''}<p class="w-small">${escHTML(lesson.title)}</p></li>`).join('')}</ol>` : `<p>${E.none}</p>`}`;
        body.appendChild(h('div', { class: 'lv-actions center' })).appendChild(h('button', { class: 'btn primary', onclick: setup }, E.restart));
        if (note >= 18) burst(body);
        const subj = String((list[0] && list[0].lesson.data) || '').split('/')[0];
        if (subj) window.dispatchEvent(new CustomEvent('tcsf:activity', { detail: { act: 'examen', subject: subj } }));
      };
      show();
    }
    setup();
  }

  // outils partagés avec le mode « Avec le prof » (prof.js)
  window.TCSF_Q = { askQuestion, STR, store, h, burst, escHTML };
  return { 'atom-history': atomHistory, rutherford, 'atom-builder': atomBuilder, 'atom-scale': atomScale, quiz, 'atom-explorer': atomExplorer, 'nucleus-slider': nucleusSlider, levels, exam };
})();
