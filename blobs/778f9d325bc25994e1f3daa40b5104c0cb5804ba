// Explications du prof pour chaque expérience : b = but, s = étapes à faire, c = ce qu'il faut comprendre.
window.TCSF_GUIDES = {
  // ---------- Mécanique ----------
  gravitation: { b: 'Découvrir de quoi dépend la force d’attraction entre deux corps.', s: ['Choisis le système Terre – Lune et lis la valeur de F.', 'Double la masse de A (curseur sur × 2) : F est multipliée par 2.', 'Remets les masses à × 1, puis double la distance d : F est divisée par 4.', 'Essaie « Deux boules de laboratoire » : la force est minuscule.'], c: 'F = G·mA·mB/d² : la force est proportionnelle aux masses et inversement proportionnelle au carré de la distance. Les deux forces sont toujours opposées et de même intensité.' },
  pesanteur: { b: 'Comprendre la différence entre masse et poids, et l’effet de l’altitude.', s: ['Garde 70 kg et passe de la Terre à la Lune : le poids change, la masse non.', 'Sur la Terre, augmente l’altitude jusqu’à 6 400 km (≈ un rayon terrestre).', 'Observe que g est alors environ 4 fois plus petit.'], c: 'P = m·g. La masse ne dépend pas du lieu ; g (donc le poids) dépend de l’astre et diminue avec l’altitude : g = g₀·R²/(R + h)².' },
  vecteur: { b: 'Apprendre à représenter une force par un vecteur à l’échelle.', s: ['Fixe l’intensité à 6 N et l’échelle à 1 cm ↔ 2 N : la flèche mesure 3 cm.', 'Tourne la direction : la droite d’action (pointillés) tourne avec la flèche.', 'Change l’échelle et observe la nouvelle longueur.'], c: 'Une force a 4 caractéristiques : point d’application, droite d’action, sens, intensité. Longueur de la flèche = intensité ÷ échelle.' },
  chrono: { b: 'Analyser une chronophotographie pour trouver la nature du mouvement et la vitesse.', s: ['Lance l’enregistrement en mouvement rectiligne uniforme : les points sont équidistants.', 'Choisis un point Mi et lis vi = Mi−1Mi+1 / 2τ.', 'Passe en mouvement accéléré puis ralenti : compare les écarts entre les points.', 'Essaie le mouvement circulaire : le vecteur vitesse reste tangent au cercle.'], c: 'Points alignés et équidistants = mouvement rectiligne uniforme. La vitesse instantanée se calcule avec les deux points voisins.' },
  inertie: { b: 'Vérifier le principe d’inertie avec un mobile autoporteur.', s: ['Table horizontale : lance le mobile en le faisant tourner.', 'Regarde les points rouges (centre d’inertie G) : ils sont alignés et équidistants.', 'Regarde les points bleus (point du bord) : ils font des boucles.', 'Incline la table et relance : la trajectoire de G se courbe.'], c: 'Pour un système pseudo-isolé, seul le centre d’inertie G a un mouvement rectiligne uniforme.' },
  barycentre: { b: 'Trouver la position du centre d’inertie de deux masses.', s: ['Mets m₁ = m₂ : G est au milieu.', 'Augmente m₁ : G se rapproche de A.', 'Vérifie que m₁·GA = m₂·GB dans le tableau.'], c: 'Relation barycentrique : m₁·GA + m₂·GB = 0 (en vecteurs). G est plus près de la masse la plus grande.' },
  deuxforces: { b: 'Trouver les conditions d’équilibre d’un corps soumis à deux forces.', s: ['F₁ = 4 N est horizontale vers la droite.', 'Règle F₂ pour annuler la somme (flèche orange) : 4 N, direction 180°.', 'Observe le message « Équilibre ! ».'], c: 'Deux forces en équilibre ont la même droite d’action, des sens opposés et la même intensité : F₁ + F₂ = 0.' },
  ressort: { b: 'Établir la loi de Hooke et mesurer la raideur d’un ressort.', s: ['Accroche successivement 50, 100, 150… g : chaque mesure s’ajoute au graphique.', 'Observe que les points sont alignés avec l’origine.', 'Calcule T/Δl : c’est la raideur k. Change de ressort et compare.'], c: 'T = k·Δl : la tension est proportionnelle à l’allongement. k (en N/m) caractérise le ressort.' },
  archimede: { b: 'Mesurer la poussée d’Archimède.', s: ['Enfonce le cylindre peu à peu : l’indication du dynamomètre diminue.', 'Compare l’eau, l’eau salée et l’huile pour la même immersion.', 'Vérifie Fa = ρ·V·g dans le tableau.'], c: 'Un liquide pousse vers le haut tout corps immergé : Fa = ρliquide·Vimmergé·g. Plus le liquide est dense, plus la poussée est grande.' },
  troisforces: { b: 'Étudier l’équilibre d’un corps soumis à trois forces.', s: ['Change les angles α et β : les tensions T₁ et T₂ changent.', 'Regarde la « dynamique des forces » à droite : P, T₁ et T₂ forment toujours un triangle fermé.', 'Mets α = β : les deux tensions sont égales.'], c: 'À l’équilibre : T₁ + T₂ + P = 0 (triangle fermé) et les trois droites d’action se coupent en un point.' },
  planincline: { b: 'Comprendre le rôle du frottement sur un plan incliné.', s: ['Fixe φ = 25° et augmente α doucement.', 'Tant que α ≤ φ, le solide reste en équilibre : R est verticale.', 'Dépasse φ : le solide glisse.'], c: 'Avec frottement, la réaction se décompose en RN (normale) et RT (frottement). L’équilibre est possible tant que l’inclinaison ne dépasse pas l’angle de frottement.' },
  moments: { b: 'Découvrir le théorème des moments.', s: ['Mets 200 g à 10 cm à gauche et 100 g à 20 cm à droite : la barre est horizontale.', 'Change une distance : la barre penche.', 'Compare M(F₁) et M(F₂) dans le tableau.'], c: 'Un solide mobile autour d’un axe est en équilibre si la somme algébrique des moments est nulle : F₁·d₁ = F₂·d₂.' },
  // ---------- Électricité ----------
  noeuds: { b: 'Vérifier la loi des nœuds dans un montage en dérivation.', s: ['Lis I, I₁ et I₂ sur les ampèremètres.', 'Change la résistance d’une lampe : son courant change, et I aussi.', 'Vérifie toujours I = I₁ + I₂.'], c: 'Au nœud, la somme des courants qui arrivent est égale à la somme des courants qui repartent (conservation de la charge).' },
  amperemetre: { b: 'Apprendre à lire un ampèremètre à aiguille et choisir le calibre.', s: ['Commence par le plus grand calibre (3 A).', 'Descends de calibre tant que l’aiguille ne dépasse pas la graduation.', 'Calcule I = C·n/n₀ avec n divisions lues.'], c: 'Le meilleur calibre est le plus petit qui reste supérieur à la valeur mesurée : la lecture est plus précise.' },
  oscillo: { b: 'Lire une tension à l’oscilloscope.', s: ['Tension continue : compte les divisions y et calcule U = Sv·y.', 'Si la trace sort de l’écran, augmente la sensibilité (V/div).', 'Passe en tension alternative : mesure Um, la période T et calcule f = 1/T.'], c: 'Verticalement on lit la tension (Sv en V/div), horizontalement le temps (Sh en ms/div). Ueff = Um/√2.' },
  mailles: { b: 'Vérifier l’additivité des tensions dans un circuit série.', s: ['Lis UAB et UBC.', 'Additionne-les : tu obtiens la tension du générateur.', 'Inverse les bornes de V₁ : la valeur devient négative.'], c: 'UAC = UAB + UBC, et UBA = −UAB : la tension est une grandeur algébrique.' },
  resistances: { b: 'Comparer l’association série et l’association en dérivation.', s: ['En série, calcule R₁ + R₂ et compare avec Réq.', 'Passe en dérivation : Réq devient plus petite que chaque résistance.', 'Observe comment se répartissent les courants et les tensions.'], c: 'Série : Réq = R₁ + R₂ (même courant). Dérivation : 1/Réq = 1/R₁ + 1/R₂ (même tension).' },
  caracteristique: { b: 'Tracer la caractéristique I = f(U) de plusieurs dipôles.', s: ['Choisis un dipôle et déplace le curseur U de gauche à droite : les points s’ajoutent.', 'Clique sur « Tracer toute la courbe » pour vérifier.', 'Compare le conducteur ohmique (droite), la lampe et la diode.', 'Pour la CTN et la LDR, change la température ou la lumière.'], c: 'Conducteur ohmique : droite (U = R·I). Diode : conduit seulement au-delà d’environ 0,6 V et dans un seul sens.' },
  potentiometre: { b: 'Obtenir une tension réglable avec un potentiomètre.', s: ['Déplace le curseur C de A vers B.', 'Observe que Us passe de 0 à la tension d’alimentation.'], c: 'Le montage potentiométrique donne une tension variable entre 0 et E à partir d’une tension fixe.' },
  pile: { b: 'Exploiter la caractéristique d’une pile et trouver le point de fonctionnement.', s: ['Lis E (ordonnée à l’origine) et Icc (abscisse à l’origine).', 'Change R : le point rouge glisse sur la droite de la pile.', 'Augmente r : la pente devient plus forte.'], c: 'Pour une pile : U = E − r·I. Le point de fonctionnement est l’intersection avec la droite U = R·I du conducteur ohmique.' },
  transistor: { b: 'Voir comment un petit courant commande un grand courant.', s: ['Laisse UBB < 0,7 V : le transistor est bloqué, la DEL est éteinte.', 'Augmente UBB : IC = β·IB, la DEL s’allume progressivement.', 'Continue : IC n’augmente plus, le transistor est saturé.'], c: 'Le transistor amplifie le courant (IC = β·IB) ; bloqué ou saturé, il joue le rôle d’un interrupteur commandé.' },
  ampliop: { b: 'Comparer les montages de l’amplificateur opérationnel.', s: ['Montage inverseur : vérifie Us = −(R₂/R₁)·Ue.', 'Augmente Ue jusqu’à la saturation (±13,5 V).', 'Essaie le non inverseur, le suiveur et le comparateur.'], c: 'En régime linéaire, V+ = V− ; la sortie reste bornée par ±Vsat.' },
  // ---------- Chimie ----------
  tests: { b: 'Identifier une espèce chimique grâce à un réactif.', s: ['Choisis un réactif, puis ajoute un échantillon.', 'Observe le changement de couleur ou le précipité.', 'Essaie tous les échantillons avec chaque réactif.'], c: 'Chaque test met en évidence une espèce précise : eau, CO₂, glucose, amidon, ions chlorure.' },
  decantation: { b: 'Choisir le bon solvant pour une extraction.', s: ['Choisis le cyclohexane et agite : deux phases apparaissent.', 'Essaie l’éthanol : il se mélange à l’eau, impossible de séparer.', 'Compare cyclohexane (en haut) et dichlorométhane (en bas).'], c: 'Le solvant doit être non miscible à l’eau et bien dissoudre l’espèce. La phase la plus dense est en bas.' },
  ccm: { b: 'Séparer et identifier des espèces par chromatographie.', s: ['Clique sur « Développer » et observe la montée de l’éluant.', 'Clique sur une tache pour mesurer son Rf.', 'Compare les hauteurs des taches du mélange et des références.'], c: 'Rf = h/H. Deux taches à la même hauteur correspondent à la même espèce ; un mélange donne plusieurs taches.' },
  reflux: { b: 'Comprendre le chauffage à reflux.', s: ['Allume le chauffage et laisse monter la température.', 'Ferme l’eau du réfrigérant : les vapeurs s’échappent.', 'Rouvre l’eau : les vapeurs retombent dans le ballon.'], c: 'Le chauffage accélère la transformation ; le réfrigérant empêche toute perte de matière.' },
  lewis: { b: 'Passer de la représentation de Lewis à la forme 3D d’une molécule.', s: ['Choisis H₂O : compte les doublets liants et non liants.', 'Regarde le modèle 3D tourner : la molécule est coudée.', 'Compare avec CH₄, NH₃ et CO₂.'], c: 'Les doublets (liants et non liants) se repoussent : c’est ce qui fixe la géométrie (tétraédrique, pyramidale, coudée, linéaire).' },
  periodique: { b: 'Comprendre l’organisation du tableau périodique.', s: ['Clique sur un élément : lis sa structure électronique.', 'Vérifie que la ligne = nombre de couches et la colonne = électrons externes.', 'Colore une famille (halogènes, alcalins…) et compare leurs ions.'], c: 'Les éléments d’une même colonne ont le même nombre d’électrons externes, donc des propriétés chimiques semblables.' },
  mole: { b: 'Passer de la masse à la quantité de matière et au nombre d’entités.', s: ['Choisis l’eau et prends 18 g : tu obtiens 1 mol.', 'Change d’espèce : la masse molaire change.', 'Lis le nombre de molécules N = n × NA.'], c: 'n = m/M et N = n·NA avec NA = 6,02 × 10²³ mol⁻¹. Pour un gaz : n = V/Vm.' },
  dilution: { b: 'Préparer une solution de concentration connue.', s: ['Dissolution : change la masse ou la fiole, observe la couleur et C.', 'Dilution : choisis la pipette et la fiole, calcule C₁.', 'Vérifie C₀·V₀ = C₁·V₁.'], c: 'C = n/V. Lors d’une dilution, la quantité de soluté se conserve : C₀V₀ = C₁V₁.' },
  equilibrer: { b: 'Équilibrer une équation chimique.', s: ['Compte les atomes de chaque élément à gauche et à droite.', 'Ajuste les coefficients avec + et − jusqu’à avoir partout ✔.', 'Choisis les plus petits coefficients entiers.'], c: 'Une réaction conserve les éléments chimiques et les charges.' },
  avancement: { b: 'Construire un tableau d’avancement et trouver le réactif limitant.', s: ['Fais glisser l’avancement x de 0 à la fin.', 'Observe quel réactif s’épuise le premier.', 'Change les quantités initiales pour obtenir un mélange stœchiométrique.'], c: 'xmax est la plus petite valeur qui annule la quantité d’un réactif : c’est le réactif limitant.' },
  // ---------- 3D Physique-Chimie ----------
  atome3d: { b: 'Voir en 3D la structure d’un atome (modèle simplifié en couches).', s: ['Fais tourner l’atome avec la souris ou le doigt.', 'Change Z : protons (rouges), neutrons (gris) et électrons (bleus) s’ajustent.', 'Observe les couches K, L, M se remplir : 2, puis 8, puis 8.'], c: 'Le noyau contient Z protons et N neutrons ; les Z électrons se répartissent sur les couches K (2), L (8), M (8).' },
  molecule3d: { b: 'Observer la forme réelle des molécules dans l’espace.', s: ['Choisis une molécule et fais-la tourner.', 'Active les doublets non liants pour voir ce qui « pousse » les liaisons.', 'Compare les angles : CH₄ (109,5°), NH₃ (107°), H₂O (104,5°).'], c: 'La géométrie vient de la répulsion des doublets d’électrons autour de l’atome central.' },
  cristal3d: { b: 'Découvrir la structure d’un cristal ionique (chlorure de sodium).', s: ['Fais tourner le cristal.', 'Repère l’alternance des ions Na⁺ (violets) et Cl⁻ (verts).', 'Augmente la taille : chaque ion est entouré de 6 ions de signe opposé.'], c: 'Un cristal ionique est un empilement régulier d’ions ; il est électriquement neutre.' },
  terrelune3d: { b: 'Visualiser l’interaction gravitationnelle Terre – Lune.', s: ['Regarde la Lune tourner autour de la Terre et les deux forces opposées.', 'Change la distance : la force varie en 1/d².', 'Accélère le temps pour voir plusieurs révolutions.'], c: 'La Terre attire la Lune et la Lune attire la Terre avec des forces de même intensité ; c’est ce qui maintient la Lune en orbite.' },
  plan3d: { b: 'Voir en 3D les forces sur un solide posé sur un plan incliné.', s: ['Fais tourner la scène pour voir le plan de côté.', 'Augmente l’inclinaison : RN diminue, le frottement RT augmente.', 'Dépasse l’angle de frottement : le bloc glisse.'], c: 'À l’équilibre, R compense P. Le bloc glisse quand l’inclinaison dépasse l’angle de frottement.' },
  circuit3d: { b: 'Voir le courant circuler dans un circuit en 3D.', s: ['Ferme l’interrupteur : les électrons se mettent en mouvement et la lampe s’allume.', 'Augmente la résistance : le courant diminue et la lampe éclaire moins.', 'Remarque : les électrons vont du − vers le +, à l’inverse du sens conventionnel.'], c: 'I = E/(R + r) ; le courant conventionnel va du + vers le − à l’extérieur du générateur.' },
  // ---------- Mathématiques ----------
  fonction: { b: 'Comprendre l’effet des coefficients sur la courbe d’une fonction.', s: ['Choisis une famille de fonctions.', 'Fais varier a, b, c et observe la courbe.', 'Repère le sommet, les variations et les points d’intersection avec les axes.'], c: 'Affine : droite de pente a. Second degré : parabole tournée vers le haut si a > 0. Homographique a/x : hyperbole.' },
  trigo: { b: 'Lire cosinus, sinus et tangente sur le cercle trigonométrique.', s: ['Fais tourner le point M sur le cercle.', 'Lis cos x (sur l’axe horizontal) et sin x (sur l’axe vertical).', 'Vérifie que cos²x + sin²x = 1.'], c: 'Sur le cercle de rayon 1, M a pour coordonnées (cos x ; sin x) et tan x = sin x / cos x.' },
  vecteurs2d: { b: 'Additionner deux vecteurs.', s: ['Règle les coordonnées de u et de v.', 'Observe u + v construit bout à bout (relation de Chasles).', 'Compare avec la règle du parallélogramme.'], c: 'u + v a pour coordonnées (x + x′ ; y + y′). Chasles : AB + BC = AC.' },
  droite: { b: 'Trouver l’équation d’une droite passant par deux points.', s: ['Déplace les points A et B.', 'Lis la pente m = (yB − yA)/(xB − xA).', 'Vérifie l’équation y = m·x + p.'], c: 'Une droite non verticale a une équation réduite y = m·x + p ; deux droites parallèles ont la même pente.' },
  solides3d: { b: 'Calculer volumes et aires de solides usuels.', s: ['Choisis un solide et fais-le tourner.', 'Change les dimensions et observe le volume.', 'Retrouve la formule utilisée.'], c: 'Pavé : V = L·l·h ; cylindre : V = π·r²·h ; cône et pyramide : V = (1/3)·base·h ; boule : V = (4/3)·π·r³.' },
  espace3d: { b: 'Visualiser les positions relatives de droites et de plans dans l’espace.', s: ['Choisis une situation et fais tourner la scène.', 'Cherche si les objets se coupent, sont parallèles ou non coplanaires.', 'Lis la propriété correspondante.'], c: 'Deux droites de l’espace peuvent être sécantes, parallèles ou non coplanaires ; une droite et un plan sont sécants ou parallèles.' }
