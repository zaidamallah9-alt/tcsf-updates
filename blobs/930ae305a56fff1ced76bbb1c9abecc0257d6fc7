/* ===== Thème 3.0 « Parcours » : couleurs vives, gros boutons en relief, formes arrondies ===== */
:root {
  --bg: #ffffff; --surface: #ffffff; --surface-2: #f7f7f7; --text: #3c3c3c; --muted: #7a7a7a; --line: #e5e5e5;
  --accent: #2fb344; --accent-2: #239a36; --accent-d: #1f8a30;
  --blue: #1ea7f0; --blue-d: #1186c7; --gold: #ffbe1a; --gold-d: #e0a000; --red: #ff4d4d; --red-d: #d93a3a; --orange: #ff9600;
  --ex: #e6f9df; --ex-line: #3cc24b; --warn: #ffe5e5; --warn-line: #ff4d4d; --def: #e9f6fe; --def-line: #1ea7f0;
  --radius: 18px; --shadow: none;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #11191e; --surface: #16222a; --surface-2: #1b2a33; --text: #eef3f6; --muted: #9db0bb; --line: #2c3d47;
    --ex: #193222; --warn: #3a1d22; --def: #14303f; }
}
body { font-family: "Nunito", "Varela Round", "Segoe UI Rounded", "Segoe UI", system-ui, sans-serif; font-weight: 600; background: var(--bg); }
h1, h2, h3, b, strong { font-weight: 800; }
.topbar { background: var(--surface); border-bottom: 2px solid var(--line); box-shadow: none; }
.brand-logo { background: var(--accent); border-radius: 12px; box-shadow: 0 3px 0 var(--accent-d); }

/* boutons en relief */
.btn { border: 2px solid var(--line); border-bottom-width: 4px; border-radius: 16px; font-weight: 800; letter-spacing: .4px; text-transform: uppercase; font-size: .9rem; background: var(--surface); box-shadow: none; transition: transform .08s; }
.btn:active:not(:disabled) { transform: translateY(2px); border-bottom-width: 2px; }
.btn.primary { background: var(--accent); border: 0; border-bottom: 4px solid var(--accent-d); color: #fff; }
.btn.primary:hover { filter: brightness(1.06); box-shadow: none; transform: none; }
.btn:disabled { opacity: .55; }
.icon-btn { border-radius: 14px; border: 2px solid var(--line); border-bottom-width: 4px; }

/* tuiles et cartes */
.tile, .lesson-card, .widget, .w-sim, .box, .subject-head, .lesson-head, .hero, .content, .toc { border-radius: 20px !important; box-shadow: none !important; }
.tile { background: var(--surface) !important; border: 2px solid var(--line); border-bottom: 5px solid var(--line); color: var(--text); }
.tile:hover { border-color: var(--c1); transform: translateY(-2px); }
.tile .tile-icon { background: var(--c1); border-radius: 16px; box-shadow: 0 4px 0 color-mix(in srgb, var(--c1) 70%, #000); color: #fff; }
.lesson-card { border: 2px solid var(--line); border-bottom-width: 5px; }
.subject-head, .lesson-head, .hero { background: var(--surface) !important; border: 2px solid var(--line); }
.w-opt { border: 2px solid var(--line); border-bottom-width: 4px; border-radius: 16px; font-weight: 700; }
.w-opt.ok { background: var(--ex); border-color: var(--ex-line); color: #2a8a35; }
.w-opt.ko { background: var(--warn); border-color: var(--warn-line); color: var(--red-d); }
.lv-tab { border-radius: 14px; border: 2px solid var(--line); border-bottom-width: 4px; font-weight: 800; }
.lv-tab.active { background: var(--blue); border-color: var(--blue-d); color: #fff; }
.w-quiz-bar, .duo-bar { background: var(--line); border-radius: 99px; overflow: hidden; height: 16px; }
.w-quiz-bar span, .duo-bar span { display: block; height: 100%; background: var(--accent); border-radius: 99px; box-shadow: inset 0 -4px 0 rgba(0,0,0,.08), inset 0 4px 0 rgba(255,255,255,.3); transition: width .35s; }
.lv-input, .mt-fill-in, select { border: 2px solid var(--line); border-radius: 14px; background: var(--surface-2); }
.app-credit { opacity: .7; }

/* ---- barre de progression du haut ---- */
.duo-hud { display: flex; gap: 12px; align-items: center; background: none; border: 0; cursor: pointer; font: inherit; color: var(--text); padding: 4px 8px; border-radius: 12px; margin-left: auto; }
.duo-hud:hover { background: var(--surface-2); }
.duo-stat { display: inline-flex; gap: 4px; align-items: center; font-size: 1rem; filter: grayscale(.2); }
.duo-stat b { font-weight: 900; }
.duo-stat:first-child:not(.on) { filter: grayscale(1); opacity: .6; }
.duo-stat:first-child.on b { color: var(--orange); }
.duo-stat:nth-child(2) b { color: var(--blue); }
.duo-stat:nth-child(3) b { color: var(--red); }
@media (max-width: 640px) { .duo-hud { gap: 6px; font-size: .9rem; } .brand-text { display: none; } }

/* ---- accueil ---- */
.duo-home { display: flex; gap: 18px; align-items: center; border: 2px solid var(--line); border-bottom-width: 5px; border-radius: 22px; padding: 16px 20px; margin: 0 0 22px; }
.duo-home-ch { flex: none; animation: duoBob 2.6s ease-in-out infinite; }
.duo-home-txt { flex: 1; display: grid; gap: 12px; }
.duo-home-row { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
.duo-home-row .btn { margin-left: auto; }
.duo-bubble { position: relative; background: var(--surface); border: 2px solid var(--line); border-radius: 16px; padding: 10px 14px; font-weight: 700; }
@keyframes duoBob { 50% { transform: translateY(-6px) rotate(-2deg); } }

/* ---- chemin ---- */
.duo-path { max-width: 560px; margin: 8px auto 30px; }
.duo-unit { display: flex; justify-content: space-between; align-items: center; background: var(--c1); color: #fff; border-radius: 18px; padding: 14px 18px; box-shadow: 0 5px 0 color-mix(in srgb, var(--c1) 65%, #000); margin: 26px 0 18px; }
.duo-unit div { display: grid; } .duo-unit small { opacity: .85; font-weight: 800; letter-spacing: 1px; } .duo-unit b { font-size: 1.15rem; }
.duo-nodes { position: relative; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 6px 0; }
.duo-node-w { position: relative; display: flex; flex-direction: column; align-items: center; }
.duo-node { width: 74px; height: 68px; border-radius: 50%; border: 0; font-size: 1.8rem; cursor: pointer; position: relative;
  background: var(--c1); box-shadow: 0 7px 0 color-mix(in srgb, var(--c1) 65%, #000); color: #fff; transition: transform .1s; }
.duo-node:not(.done):not(.cur) { background: var(--line); box-shadow: 0 7px 0 color-mix(in srgb, var(--line) 75%, #000); filter: saturate(.6); }
.duo-node:active { transform: translateY(5px); box-shadow: 0 2px 0 color-mix(in srgb, var(--c1) 65%, #000); }
.duo-node.done { background: var(--gold); box-shadow: 0 7px 0 var(--gold-d); }
.duo-node.cur { outline: 6px solid color-mix(in srgb, var(--c1) 25%, transparent); outline-offset: 6px; }
.duo-node i { position: absolute; right: -4px; bottom: -4px; font-style: normal; font-size: .75rem; background: var(--surface); color: var(--gold-d); border-radius: 99px; padding: 0 6px; border: 2px solid var(--gold); }
.duo-node.trophy { background: var(--line); box-shadow: 0 7px 0 #bbb; margin-top: 20px; }
.duo-start { position: absolute; top: -44px; white-space: nowrap; background: var(--surface); color: var(--c1); border: 2px solid var(--line); border-radius: 12px; padding: 5px 12px; font-weight: 900; font-size: .85rem; animation: duoHop 1.2s ease-in-out infinite; z-index: 2; }
@keyframes duoHop { 50% { transform: translateY(-5px); } }
.duo-side { position: absolute; top: 40%; } .duo-side.r { right: 0; } .duo-side.l { left: 0; }
@media (max-width: 520px) { .duo-side { opacity: .35; } }
.duo-pop { position: absolute; top: 84px; z-index: 5; width: 280px; background: var(--c1); color: #fff; border-radius: 18px; padding: 14px 16px; display: grid; gap: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.18); animation: duoIn .18s ease-out; }
.duo-pop p { margin: 0; opacity: .95; color: #fff; }
.duo-nodes { padding-top: 40px !important; }
.duo-pop .btn.primary { background: #fff; color: var(--c1); border-bottom-color: rgba(0,0,0,.18); }
.duo-pop-l { display: flex; flex-wrap: wrap; gap: 8px; } .duo-pop-l a { color: #fff; font-size: .85rem; font-weight: 800; opacity: .9; }
@keyframes duoIn { from { transform: scale(.9); opacity: 0; } }

/* ---- leçon en mode jeu ---- */
body.duo-in .topbar, body.duo-in .app-credit, body.duo-in .msc-walker, body.duo-in .msc-back, body.duo-in .acc-side { display: none !important; }
body.duo-in .view { max-width: 760px; padding-bottom: 170px; }
.duo-sess-top { display: flex; align-items: center; gap: 14px; margin: 8px 0 24px; }
.duo-sess-top .duo-bar { flex: 1; }
.duo-quit { background: none; border: 0; font-size: 1.5rem; color: var(--muted); cursor: pointer; }
.duo-hearts { font-weight: 900; color: var(--red); white-space: nowrap; }
.duo-hearts.hit { animation: shake .4s; }
.duo-kind { font-size: 1.45rem; font-weight: 900; margin: 0 0 14px; }
.duo-q { display: flex; gap: 12px; align-items: flex-end; margin-bottom: 18px; }
.duo-q .duo-bubble { flex: 1; font-size: 1.08rem; }
.duo-q .duo-bubble::before { content: ''; position: absolute; left: -10px; bottom: 18px; border: 8px solid transparent; border-right-color: var(--line); }
.duo-learn { border: 2px solid var(--line); border-radius: 18px; padding: 6px 18px; background: var(--def); }
.duo-sess .w-fb:empty { display: none; }
.duo-sess .w-opts { gap: 12px; }
.duo-sess .w-opt { padding: 14px 16px; font-size: 1.02rem; }
.duo-foot { position: fixed; left: 0; right: 0; bottom: 0; border-top: 2px solid var(--line); background: var(--surface); padding: 16px 20px calc(16px + env(safe-area-inset-bottom)); transform: translateY(110%); transition: transform .22s ease-out; z-index: 30; }
.duo-foot.show { transform: none; }
.duo-foot.ok { background: #d7ffb8; border-color: #b8f28b; color: #2b7a1f; }
.duo-foot.ko { background: #ffdfe0; border-color: #ffc1c1; color: #c62828; }
@media (prefers-color-scheme: dark) { .duo-foot.ok { background: #1d3a1c; color: #9be78d; } .duo-foot.ko { background: #45191c; color: #ff9b9b; } }
.duo-foot-in { max-width: 760px; margin: 0 auto; display: flex; align-items: center; gap: 14px; }
.duo-foot-t { flex: 1; } .duo-foot-t > b { font-size: 1.3rem; }
.duo-fbtxt { font-size: .95rem; } .duo-fbtxt p { margin: 4px 0; }
.duo-foot .duo-go { margin-left: auto; min-width: 150px; }
.duo-foot.ok .duo-go { background: var(--accent); color: #fff; border: 0; border-bottom: 4px solid var(--accent-d); }
.duo-foot.ko .duo-go { background: var(--red); color: #fff; border: 0; border-bottom: 4px solid var(--red-d); }
.duo-foot.learn { transform: none; }
@media (max-width: 560px) { .duo-foot-ch { display: none; } .duo-foot-in { flex-wrap: wrap; } .duo-foot .duo-go { width: 100%; } }
.duo-match { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.duo-col { display: grid; gap: 10px; align-content: start; }
.duo-tile { border: 2px solid var(--line); border-bottom-width: 4px; border-radius: 16px; background: var(--surface); padding: 12px; font: inherit; font-weight: 700; color: var(--text); cursor: pointer; min-height: 56px; font-size: .92rem; }
.duo-tile.sel { border-color: var(--blue); background: var(--def); }
.duo-tile.ok { border-color: var(--ex-line); background: var(--ex); opacity: .55; }
.duo-tile.ko { border-color: var(--warn-line); background: var(--warn); animation: shake .4s; }
.duo-end { text-align: center; display: grid; justify-items: center; gap: 12px; padding: 30px 10px; position: relative; }
.duo-end h2 { font-size: 1.9rem; margin: 0; color: var(--gold-d); }
.duo-end .btn { min-width: 260px; }
.duo-tiles { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
.duo-tiles > div { border: 2px solid; border-radius: 16px; min-width: 120px; overflow: hidden; display: grid; }
.duo-tiles small { color: #fff; font-weight: 900; padding: 4px 8px; font-size: .72rem; }
.duo-tiles b { padding: 10px; font-size: 1.2rem; }
.duo-tiles .y { border-color: var(--gold); } .duo-tiles .y small { background: var(--gold); }
.duo-tiles .g { border-color: var(--accent); } .duo-tiles .g small { background: var(--accent); }
.duo-tiles .b { border-color: var(--blue); } .duo-tiles .b small { background: var(--blue); }
.duo-loot { font-weight: 800; color: var(--blue); }
.duo-flame-big { display: grid; justify-items: center; font-size: 3.4rem; animation: duoIn .5s; }
.duo-flame-big b { font-size: 2.2rem; color: var(--orange); line-height: 1; } .duo-flame-big span { font-size: 1rem; font-weight: 800; color: var(--orange); }

/* ---- panneau progression ---- */
.duo-modal { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 60; display: grid; place-items: center; padding: 16px; }
.duo-sheet { position: relative; background: var(--surface); border-radius: 24px; width: min(520px, 100%); max-height: 90vh; overflow: auto; padding: 22px 18px; display: grid; gap: 14px; animation: duoIn .2s; }
.duo-x { position: absolute; right: 14px; top: 10px; border: 0; background: none; font-size: 1.3rem; color: var(--muted); cursor: pointer; }
.duo-card { border: 2px solid var(--line); border-radius: 18px; padding: 14px 16px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
.duo-card > b, .duo-card > label { flex-basis: 100%; }
.duo-flame { font-size: 3rem; } .duo-big { font-size: 1.5rem; color: var(--orange); }
.duo-week { display: flex; gap: 6px; margin-top: 6px; }
.duo-day { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-size: .75rem; font-weight: 900; background: var(--line); color: var(--muted); }
.duo-day.on { background: var(--orange); color: #fff; } .duo-day.today { outline: 2px solid var(--orange); outline-offset: 2px; }
.duo-goals, .duo-shop { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.duo-chip { border: 2px solid var(--line); border-bottom-width: 4px; background: var(--surface); border-radius: 12px; padding: 5px 10px; font: inherit; font-weight: 800; color: var(--text); cursor: pointer; font-size: .82rem; }
.duo-chip.on { border-color: var(--blue); color: var(--blue); }
.duo-league { list-style: none; margin: 6px 0 0; padding: 0; width: 100%; display: grid; gap: 4px; }
.duo-league li { display: flex; gap: 10px; align-items: center; padding: 6px 10px; border-radius: 12px; }
.duo-league li span { width: 22px; font-weight: 900; color: var(--muted); } .duo-league li.top span { color: var(--gold-d); }
.duo-league li em { margin-left: auto; font-style: normal; color: var(--muted); }
.duo-league li.me { background: var(--def); }
.duo-row { display: flex; gap: 8px; align-items: center; }
.duo-cast { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
.duo-cast > div { display: grid; justify-items: center; font-weight: 800; }
.duo-ch { overflow: visible; }
.duo-practice { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 6px; }
.duo-quest { display: grid; grid-template-columns: 1fr 120px auto; gap: 10px; align-items: center; width: 100%; font-size: .92rem; }
.duo-quest .duo-bar { height: 12px; } .duo-quest .duo-bar span { background: var(--gold); }
.duo-prof { display: flex; flex-wrap: wrap; gap: 10px; width: 100%; }
.duo-prof span { flex: 1 1 80px; display: grid; text-align: center; border: 2px solid var(--line); border-radius: 14px; padding: 6px; }
.duo-prof b { font-size: 1.2rem; color: var(--blue); }
.duo-badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; width: 100%; }
.duo-badges div { display: grid; justify-items: center; text-align: center; filter: grayscale(1); opacity: .45; }
.duo-badges div.on { filter: none; opacity: 1; }
.duo-badges span { font-size: 1.9rem; width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; background: var(--surface-2); border: 3px solid var(--gold); }
.duo-badges small { font-weight: 800; font-size: .72rem; }
.duo-super { background: linear-gradient(135deg, #7c3aed22, #06b6d422); }
.duo-boost b, .duo-boost { color: #a855f7; font-weight: 900; }
.duo-newbadge { font-weight: 700; color: var(--gold-d); margin: 0; }
.duo-pop-x { border-top: 1px solid rgba(255,255,255,.35); padding-top: 6px; }

