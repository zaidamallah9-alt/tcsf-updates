.prof-lang { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 6px 0 8px; }
.prof-ar { margin: 10px 0 4px; padding: 10px 14px; border-radius: 12px; background: #ecfdf5; border-inline-start: 4px solid #10b981; font-family: "Segoe UI", Tahoma, "Noto Naskh Arabic", sans-serif; line-height: 1.8; text-align: right; }
.prof-ar p { margin: 4px 0; }
.prof-ar-h { display: block; color: #047857; margin-bottom: 2px; }
.ar-badge { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: #10b981; color: #fff; font-size: 14px; vertical-align: middle; }
.prof-ar-t { color: #047857; font-weight: 600; }
.prof-extras { text-align: left; }
@media (prefers-color-scheme: dark) { .prof-ar { background: rgba(16, 185, 129, .12); } .prof-ar-h, .prof-ar-t { color: #34d399; } }
.prof-askform { margin-top: 10px; display: grid; gap: 8px; }
.prof-askrow { display: flex; flex-wrap: wrap; gap: 8px; }
.prof-mic.rec { background: #ef4444; color: #fff; border-color: #ef4444; animation: micPulse 1s ease infinite; }
@keyframes micPulse { 50% { box-shadow: 0 0 0 8px rgba(239, 68, 68, .2); } }
.qa-src { margin: 8px 0; padding: 10px 12px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
.qa-src.small { font-size: 14px; }
.qa-src.wiki { border-inline-start: 4px solid #0ea5e9; }
.qa-src.ex { border-inline-start: 4px solid var(--ex-line); }
.qa-src a { font-size: 13px; font-weight: 700; }
.qa-txt { margin-top: 4px; }
.qa-txt.big { font-size: 1.12em; font-weight: 600; }
.qa-words li { margin-bottom: 6px; }

/* ===== Mon planning (planner.js) ===== */
.plan-head .tile-icon.big { background: linear-gradient(135deg, #0ea5e9, #6366f1); }
.plan-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
.plan-tabs .tab { padding: 10px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); font-weight: 700; color: var(--text); text-decoration: none; }
.plan-tabs .tab.active { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border-color: transparent; }
.plan-body { max-width: none; }
.plan-photo-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 12px 0; }
.plan-file { cursor: pointer; }
.plan-edt-wrap { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 16px; align-items: start; }
.plan-photo img { width: 100%; border-radius: 12px; border: 1px solid var(--line); }
.plan-brushes { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.plan-brushes i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-inline-end: 6px; vertical-align: middle; }
.plan-brushes .chip-btn.on { background: var(--c, var(--accent)); border-color: var(--c, var(--accent)); }
.plan-brushes .chip-btn.on i { background: #fff !important; }
.plan-grid { width: 100%; border-collapse: separate; border-spacing: 3px; user-select: none; touch-action: none; }
.plan-grid th { font-size: 12.5px; color: var(--muted); font-weight: 700; padding: 4px; white-space: nowrap; }
.plan-grid td { height: 34px; min-width: 64px; border-radius: 8px; background: var(--surface-2); border: 1px solid var(--line); text-align: center; font-size: 12.5px; font-weight: 800; color: #fff; cursor: pointer; transition: transform .1s; }
.plan-grid td:hover { transform: scale(1.04); border-color: var(--accent); }
.plan-grid td.lunch:not(.busy) { background: repeating-linear-gradient(45deg, var(--surface-2), var(--surface-2) 5px, var(--line) 5px, var(--line) 6px); }
.plan-grid td.auto { outline: 2px dashed #f59e0b; outline-offset: -3px; }
.plan-auto-demo { outline: 2px dashed #f59e0b; padding: 0 4px; border-radius: 4px; }
.plan-prefs { display: grid; gap: 10px; }
.plan-prefs label { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.plan-prefs input, .plan-prefs select, .plan-exam-form input, .plan-exam-form select { font: inherit; padding: 6px 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--text); }
.plan-check { display: flex; align-items: center; gap: 8px; }
.plan-exam-form { display: grid; gap: 10px; padding: 14px; border-radius: 14px; background: var(--surface-2); border: 1px solid var(--line); margin: 12px 0; }
.plan-exam-form > label { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-weight: 700; }
.plan-lesson-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 4px 12px; max-height: 260px; overflow: auto; }
.plan-lesson-checks label { font-size: 14px; display: flex; gap: 6px; align-items: flex-start; }
.plan-exam { display: flex; align-items: center; gap: 12px; padding: 10px 14px; margin: 8px 0; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); border-inline-start: 5px solid var(--c); }
.plan-exam > div { flex: 1; }
.plan-exam.past { opacity: .55; }
.plan-count { font-weight: 800; color: var(--c); }
.plan-countdowns { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
.plan-cd { display: flex; flex-direction: column; padding: 10px 16px; border-radius: 14px; color: #fff; background: linear-gradient(135deg, var(--c), color-mix(in srgb, var(--c) 60%, #000)); min-width: 130px; }
.plan-cd b { font-size: 22px; }
.plan-cd span { font-size: 13px; opacity: .9; }
.plan-progress { margin: 10px 0; }
.plan-stars { float: right; font-weight: 600; color: #b45309; }
/* Récompense : séance terminée */
.rw-overlay { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; background: rgba(15, 23, 42, .45); animation: rwFade .25s ease; padding: 16px; }
.rw-overlay.small { background: rgba(15, 23, 42, .2); }
.rw-overlay.out { opacity: 0; transition: opacity .3s; }
.rw-card { position: relative; overflow: hidden; width: min(360px, 100%); text-align: center; padding: 26px 20px 20px; border-radius: 22px; background: var(--card, #fff); box-shadow: 0 20px 60px rgba(0, 0, 0, .3); animation: rwPop .55s cubic-bezier(.2, 1.6, .4, 1); }
.rw-rays { position: absolute; left: 50%; top: 60px; width: 420px; height: 420px; margin: -210px 0 0 -210px; background: repeating-conic-gradient(rgba(251, 191, 36, .22) 0 10deg, transparent 10deg 20deg); border-radius: 50%; animation: rwSpin 6s linear infinite; pointer-events: none; }
.rw-star { position: relative; font-size: 76px; line-height: 1; filter: drop-shadow(0 6px 14px rgba(245, 158, 11, .6)); animation: rwStar 1s cubic-bezier(.2, 1.4, .4, 1) both, rwFloat 2.2s ease-in-out 1s infinite; }
.rw-plus { position: relative; font-size: 30px; font-weight: 800; color: #f59e0b; margin: 2px 0 6px; animation: rwUp .8s ease .35s both; }
.rw-title { position: relative; display: block; font-size: 19px; }
.rw-what, .rw-total { position: relative; margin: 8px 0; }
.rw-total b { color: #b45309; font-size: 18px; }
.rw-ok { position: relative; margin-top: 6px; }
@keyframes rwFade { from { opacity: 0; } }
@keyframes rwPop { from { transform: scale(.4) rotate(-8deg); opacity: 0; } }
@keyframes rwSpin { to { transform: rotate(360deg); } }
@keyframes rwStar { 0% { transform: scale(0) rotate(-180deg); } 60% { transform: scale(1.35) rotate(15deg); } 100% { transform: scale(1) rotate(0); } }
@keyframes rwFloat { 50% { transform: translateY(-6px) scale(1.05); } }
@keyframes rwUp { from { transform: translateY(16px) scale(.6); opacity: 0; } }
.plan-tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 10px 0 16px; }
.plan-day { margin: 14px 0; }
.plan-day h3 { margin: 0 0 8px; font-size: 16px; }
.plan-day.today h3 { color: var(--accent); }
.plan-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; margin: 6px 0; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); border-inline-start: 5px solid var(--c); }
.plan-item.done { opacity: .55; }
.plan-item.done .plan-what b { text-decoration: line-through; }
.plan-tick input { width: 22px; height: 22px; accent-color: var(--ex-line); }
.plan-time { font-weight: 800; font-size: 14px; min-width: 48px; text-align: center; }
.plan-time small { color: var(--muted); font-weight: 600; }
.plan-what { flex: 1; font-size: 14.5px; }
.plan-what span { color: var(--muted); }
.plan-go { padding: 6px 12px; font-size: 13.5px; }
.plan-today { display: block; margin: 0 0 18px; padding: 14px 18px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--text); text-decoration: none; }
.plan-today.empty { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: linear-gradient(135deg, color-mix(in srgb, #0ea5e9 12%, var(--surface)), color-mix(in srgb, #6366f1 12%, var(--surface))); }
.plan-today.empty > div { flex: 1; min-width: 200px; }
.plan-today-ic { font-size: 34px; }
.plan-today-top { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 6px; }
.plan-today-all { margin-inline-start: auto; font-weight: 700; }
.plan-mini { display: flex; flex-wrap: wrap; gap: 10px; align-items: baseline; padding: 6px 0; border-top: 1px dashed var(--line); font-size: 14.5px; }
.plan-mini.done { opacity: .55; }
.plan-grid-box, .plan-grid-box .table-wrap { min-width: 0; max-width: 100%; overflow-x: auto; }
@media (max-width: 900px) { .plan-edt-wrap { grid-template-columns: minmax(0, 1fr); } .plan-photo { order: -1; } }
@media (max-width: 520px) { .plan-grid { border-spacing: 2px; } .plan-grid td { min-width: 0; height: 30px; font-size: 10.5px; } .plan-grid th { font-size: 10.5px; padding: 2px; } .plan-item { flex-wrap: wrap; } }
@media print { .plan-tabs, .plan-tools, .plan-go, .plan-tick { display: none !important; } }

/* ===== Sons & animations (sfx.js) ===== */
.btn, .tile, .lesson-card, .chip-btn, .w-opt, .pm-item { position: relative; overflow: hidden; }
.ripple { position: absolute; border-radius: 50%; pointer-events: none; background: currentColor; opacity: .18; transform: scale(0); animation: ripple .55s ease-out forwards; }
.btn.primary .ripple { background: #fff; opacity: .35; }
@keyframes ripple { to { transform: scale(1); opacity: 0; } }
.btn, .chip-btn, .w-opt, .pm-item, .icon-btn, .w-round { transition: transform .12s ease, box-shadow .2s ease, background .2s, border-color .2s; }
.btn:active, .chip-btn:active, .w-opt:active, .pm-item:active, .icon-btn:active, .w-round:active { transform: scale(.94); }
.btn.primary:hover { box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 40%, transparent); transform: translateY(-1px); }
.tile, .lesson-card { transition: transform .18s ease, box-shadow .2s ease; }
.tile:hover, .lesson-card:hover { transform: translateY(-4px) rotate(-.4deg); }
.tile:active, .lesson-card:active { transform: scale(.97); }
.tile:hover .tile-icon, .lesson-card:hover .lesson-num { animation: wiggle .5s ease; }
@keyframes wiggle { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-8deg) scale(1.08); } 60% { transform: rotate(6deg) scale(1.08); } }
.w-fb.ok { animation: fbPop .45s cubic-bezier(.2, 1.6, .4, 1); }
.w-fb.ko { animation: shake .42s ease; }
.w-opt.ok { animation: fbPop .45s cubic-bezier(.2, 1.6, .4, 1); }
.w-opt.ko, .pm-item.ko { animation: shake .42s ease; }
.pm-item.ok { animation: fbPop .45s cubic-bezier(.2, 1.6, .4, 1); }
@keyframes fbPop { 0% { transform: scale(.85); } 60% { transform: scale(1.04); } 100% { transform: scale(1); } }
@keyframes shake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-7px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
.streak-toast { position: fixed; left: 50%; top: 84px; z-index: 50; transform: translateX(-50%); padding: 8px 18px; border-radius: 99px; font-weight: 800; font-size: 20px; color: #fff; background: linear-gradient(135deg, #f97316, #ef4444); box-shadow: 0 8px 24px rgba(239, 68, 68, .35); animation: streakIn 1.6s ease forwards; pointer-events: none; }
@keyframes streakIn { 0% { opacity: 0; transform: translate(-50%, -12px) scale(.6); } 15% { opacity: 1; transform: translate(-50%, 0) scale(1.15); } 25% { transform: translate(-50%, 0) scale(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -18px); } }
#soundBtn.muted { color: var(--muted); opacity: .7; }
.view > * { animation: viewIn .35s ease both; }
@keyframes viewIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) { .view > *, .w-fb, .w-opt, .pm-item, .tile, .lesson-card, .streak-toast { animation: none !important; } }

/* ===== Mode « Avec le prof » (prof.js) ===== */
.lesson-layout.no-toc { display: block; }
.lesson-layout.no-toc .toc { display: none; }
.lesson-layout.no-toc .content { max-width: none; }
.w-prof { margin: 0; }
.prof-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 18px; align-items: start; }
.prof-chat { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.prof-msg { display: flex; gap: 10px; align-items: flex-start; animation: profIn .35s ease; }
.prof-msg.me { justify-content: flex-end; }
@keyframes profIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.prof-av { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-size: 22px; background: var(--def); border: 1px solid var(--line); }
.prof-av.mascot { width: 50px; height: 50px; background: none; border: 0; border-radius: 0; }
/* Fenêtre « mise à jour / quoi de neuf » */
.live-modal { position: fixed; inset: 0; z-index: 10000; display: grid; place-items: center; padding: 16px; background: rgba(15, 23, 42, .5); animation: rwFade .25s ease; }
.live-card { width: min(440px, 100%); max-height: 86vh; overflow: auto; border-radius: 20px; padding: 22px 20px 18px; background: var(--card, #fff); box-shadow: 0 20px 60px rgba(0, 0, 0, .3); text-align: center; animation: rwPop .5s cubic-bezier(.2, 1.5, .4, 1); }
.live-ic { display: grid; place-items: center; }
.live-card h3 { margin: 8px 0; }
.live-notes { text-align: start; margin: 8px 0 14px; }
.live-notes ul { padding-inline-start: 20px; margin: 0; }
.live-notes li { margin: 4px 0; }
.live-btns { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
/* Accès privé */
html.acc-locked body > *:not(.acc-lock):not(.live-modal) { visibility: hidden; }
.acc-lock { position: fixed; inset: 0; z-index: 20000; overflow: auto; display: grid; place-items: center; padding: 16px; background: linear-gradient(160deg, #eef2ff, #f5f3ff 50%, #ecfdf5); visibility: visible; }
.acc-lock.out { opacity: 0; transition: opacity .4s; }
.acc-card { width: min(480px, 100%); text-align: center; padding: 26px 22px; border-radius: 24px; background: #fff; box-shadow: 0 20px 60px rgba(30, 27, 75, .15); animation: rwPop .5s cubic-bezier(.2, 1.5, .4, 1); }
.acc-ic { display: grid; place-items: center; }
.acc-card h2 { margin: 6px 0 8px; }
.acc-ar { font-family: "Segoe UI", Tahoma, sans-serif; color: #047857; }
.acc-warn { color: #b91c1c; font-weight: 600; }
.acc-form { display: grid; gap: 10px; margin-top: 12px; text-align: start; }
.acc-form label { display: grid; gap: 6px; font-weight: 600; }
.acc-code-box { margin: 14px 0; padding: 12px; border-radius: 16px; background: #f5f3ff; border: 2px dashed #8b5cf6; }
.acc-code { font: 800 28px/1.2 ui-monospace, Consolas, monospace; letter-spacing: 2px; color: #4c1d95; margin: 4px 0; user-select: all; }
.acc-steps { text-align: start; margin: 8px 0; padding-inline-start: 22px; }
.acc-btns { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.acc-status { min-height: 1.2em; margin-top: 10px; }
.acc-admin-card { width: min(620px, 100%); text-align: start; }
.acc-add { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
.acc-add input { flex: 1 1 160px; }
.acc-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.acc-h { margin: 14px 0 6px; display: flex; gap: 8px; align-items: center; }
.acc-acts { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.chip-btn.danger { color: #b91c1c; border-color: #fecaca; }
.chip-btn.danger:hover { background: #fee2e2; }
.acc-off { margin-top: 10px; }
.acc-off summary { cursor: pointer; font-weight: 600; }
.acc-table th, .acc-table td { padding: 6px 8px; border-bottom: 1px solid var(--line, #e2e8f0); text-align: start; }
/* Nom du concepteur, en bas de toutes les pages */
.app-credit { text-align: center; padding: 18px 16px 90px; font-size: 13px; color: var(--muted, #64748b); }
.app-credit b { color: var(--accent); }
/* Défi final du prof */
.defi { margin: 14px 0 14px 58px; border-radius: 20px; overflow: hidden; background: var(--card, #fff); border: 2px solid #fbbf24; box-shadow: 0 10px 30px rgba(245, 158, 11, .18); }
[dir="rtl"] .defi { margin: 14px 58px 14px 0; }
.defi-top { display: flex; align-items: center; gap: 10px; padding: 12px 16px; color: #fff; background: linear-gradient(120deg, #f59e0b, #f97316 55%, #ec4899); }
.defi-top b { font-size: 18px; letter-spacing: .2px; }
.defi-cup { font-size: 26px; animation: mscHop .8s ease-in-out infinite alternate; }
.defi-dots { margin-inline-start: auto; display: flex; gap: 6px; }
.defi-dots i { width: 14px; height: 14px; border-radius: 50%; background: rgba(255, 255, 255, .35); border: 2px solid #fff; transition: background .3s, transform .3s; }
.defi-dots i.cur { background: #fff; transform: scale(1.25); }
.defi-dots i.ok { background: #22c55e; }
.defi-dots i.ko { background: #ef4444; }
.defi-body { padding: 14px 16px 16px; }
.defi-body.in { animation: defiIn .4s ease; }
.defi-q { display: flex; gap: 12px; align-items: flex-start; }
.defi-q .prof-q { margin: 4px 0 8px; font-size: 16px; font-weight: 600; }
.defi-num { flex: none; width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; font-size: 22px; font-weight: 800; color: #fff; background: linear-gradient(135deg, #6366f1, #8b5cf6); box-shadow: 0 4px 10px rgba(99, 102, 241, .35); }
.defi-num small { font-size: 11px; opacity: .85; margin-top: -10px; }
.defi-next { text-align: center; margin-top: 10px; }
.defi.flash-ok { animation: defiOk .6s ease; }
.defi.flash-ko { animation: defiKo .45s ease; }
.defi-res { text-align: center; padding: 6px 0; }
.defi-stars span { display: inline-block; font-size: 52px; color: #e5e7eb; margin: 0 4px; animation: rwStar .7s cubic-bezier(.2, 1.4, .4, 1) both; }
.defi-stars span.on { color: #fbbf24; text-shadow: 0 4px 14px rgba(245, 158, 11, .55); }
.defi-score { font-size: 20px; margin: 4px 0; }
.defi-score b { font-size: 34px; color: #f97316; }
@keyframes defiIn { from { opacity: 0; transform: translateY(10px); } }
@keyframes defiOk { 30% { box-shadow: 0 0 0 6px rgba(34, 197, 94, .45); } }
@keyframes defiKo { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }
@media (max-width: 600px) { .defi, [dir="rtl"] .defi { margin-left: 0; margin-right: 0; } }
/* Tico, la mascotte */
.msc { overflow: visible; display: block; }
.msc .msc-orbit { transform-origin: 60px 68px; animation: mscOrbit 9s linear infinite; }
.msc .msc-e { animation: mscE 2.4s ease-in-out infinite; }
.msc .msc-eyes { transform-origin: 60px 64px; animation: mscBlink 4.5s infinite; }
.msc .msc-tassel { transform-origin: 86px 40px; animation: mscTassel 2.8s ease-in-out infinite; }
.msc .msc-arm-r { transform-origin: 92px 74px; animation: mscWave 3.2s ease-in-out infinite; }
.msc .msc-body { transform-origin: 60px 108px; animation: mscBreath 3s ease-in-out infinite; }
.msc .msc-mouth { opacity: 0; transform-origin: 60px 82px; }
.prof-msg.prof:last-of-type .prof-av.mascot .msc-arm-r, .msc-walker.talking .msc-arm-r { animation-duration: .9s; }
.msc-walker.talking .msc-mouth { opacity: 1; animation: mscTalk .22s ease-in-out infinite alternate; }
.msc-walker.talking .msc-smile { opacity: 0; }
@keyframes mscOrbit { to { transform: rotate(360deg); } }
@keyframes mscE { 50% { opacity: .4; } }
@keyframes mscBlink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
@keyframes mscTassel { 50% { transform: rotate(14deg); } }
@keyframes mscWave { 0%, 60%, 100% { transform: rotate(0); } 70% { transform: rotate(-22deg); } 80% { transform: rotate(8deg); } 90% { transform: rotate(-18deg); } }
@keyframes mscBreath { 50% { transform: scale(1.03, .97); } }
@keyframes mscTalk { from { transform: scaleY(.3); } to { transform: scaleY(1.1); } }
.msc-walker { position: fixed; left: 0; bottom: 10px; z-index: 900; width: 96px; pointer-events: none; transition: transform .1s linear; }
.msc-walker[hidden] { display: none; }
.msc-walker .msc-hit { pointer-events: auto; background: none; border: 0; padding: 0; cursor: pointer; animation: mscHop .55s ease-in-out infinite alternate; filter: drop-shadow(0 8px 10px rgba(30, 27, 75, .28)); }
.msc-walker.idle .msc-hit { animation: none; }
.msc-walker.left .msc-hit .msc { transform: scaleX(-1); }
.msc-walker.jump .msc-hit { animation: mscJump .6s cubic-bezier(.3, 1.6, .5, 1); }
.msc-walker .msc-x { pointer-events: auto; position: absolute; top: -2px; right: 0; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--line); background: var(--card, #fff); color: var(--muted, #64748b); font-size: 14px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .2s; }
.msc-walker:hover .msc-x { opacity: 1; }
.msc-bubble { position: absolute; bottom: 96px; left: 0; width: max-content; max-width: min(260px, 70vw); padding: 8px 12px; border-radius: 14px; background: var(--card, #fff); border: 2px solid #5b6cf5; box-shadow: 0 6px 18px rgba(0, 0, 0, .15); font-size: 14px; line-height: 1.35; animation: rwPop .35s ease; }
.msc-bubble::after { content: ""; position: absolute; left: 34px; bottom: -9px; border: 8px solid transparent; border-top-color: #5b6cf5; border-bottom: 0; }
.msc-walker[style*="translateX"] .msc-bubble { left: auto; }
.msc-back { position: fixed; right: 12px; bottom: 12px; z-index: 900; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line); background: var(--card, #fff); display: grid; place-items: center; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 0, 0, .15); }
.msc-back[hidden] { display: none; }
@keyframes mscHop { from { transform: translateY(0); } to { transform: translateY(-5px); } }
@keyframes mscJump { 40% { transform: translateY(-34px) rotate(-8deg); } 70% { transform: translateY(0) scale(1.08, .92); } }
@media print { .msc-walker, .msc-back { display: none !important; } }
@media (max-width: 600px) {
  .msc-walker { width: 60px; bottom: 6px; opacity: .92; }
  .msc-walker .msc-hit .msc { width: 56px; height: 56px; }
  .msc-bubble { bottom: 62px; font-size: 13px; max-width: 62vw; }
  .msc-walker .msc-x { opacity: 1; width: 18px; height: 18px; font-size: 12px; }
}
.prof-bubble { min-width: 0; max-width: 100%; padding: 12px 16px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
.prof-msg.prof .prof-bubble { border-top-left-radius: 4px; flex: 1; }
[dir="rtl"] .prof-msg.prof .prof-bubble { border-top-left-radius: 16px; border-top-right-radius: 4px; }
.prof-msg.me .prof-bubble { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border: none; border-top-right-radius: 4px; max-width: 80%; }
[dir="rtl"] .prof-msg.me .prof-bubble { border-top-right-radius: 16px; border-top-left-radius: 4px; }
.prof-msg.good .prof-bubble { background: var(--ex); border-color: var(--ex-line); }
.prof-msg.board .prof-bubble { background: var(--surface-2); }
.prof-bubble > p:first-child { margin-top: 0; }
.prof-bubble > p:last-child { margin-bottom: 0; }
.prof-sub { font-weight: 700; color: var(--accent); margin: 10px 0 4px; }
.prof-q { font-weight: 700; font-size: 1.05em; }
.prof-zone { margin-top: 10px; }
.prof-chunk { padding: 6px 0; border-top: 1px dashed var(--line); animation: profIn .4s ease; max-width: none; }
.prof-chunk:first-of-type { border-top: none; }
.prof-actions { display: flex; flex-wrap: wrap; gap: 8px; padding-inline-start: 50px; }
.prof-sep { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; margin-top: 8px; }
.prof-sep::before, .prof-sep::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.prof-ta { width: 100%; resize: vertical; margin-top: 8px; font-size: 16px; }
.prof-key { padding: 10px 14px; border-radius: 12px; background: var(--note); border-inline-start: 4px solid var(--note-line); margin: 8px 0; }
.prof-key .formula { margin: 4px 0; }
.prof-book { position: sticky; top: 80px; max-height: calc(100vh - 110px); overflow: auto; padding: 14px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); font-size: 14px; }
.prof-book h4 { margin: 0 0 8px; }
.prof-book ol { margin: 0; padding-inline-start: 20px; }
.prof-book li { margin-bottom: 8px; color: var(--muted); }
.prof-book li b { color: var(--text); font-weight: 600; }
.prof-book li p { margin: 2px 0 0; color: var(--text); font-style: italic; }
.prof-book li.cur b { color: var(--accent); }
.prof-book li.ok::marker { content: "✔ "; color: var(--ex-line); }
.prof-book li.ko::marker { content: "↺ "; color: var(--note-line); }
.prof-match { display: grid; grid-template-columns: 1fr 1.4fr; gap: 10px; margin-top: 10px; }
.pm-col { display: flex; flex-direction: column; gap: 8px; }
.pm-item { text-align: start; padding: 10px 12px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface-2); color: var(--text); font: inherit; font-size: 14.5px; cursor: pointer; }
.pm-item:not(.def) { font-weight: 700; }
.pm-item.sel { border-color: var(--accent); background: var(--def); }
.pm-item.ok { border-color: var(--ex-line); background: var(--ex); cursor: default; }
.pm-item.ko { border-color: var(--warn-line); background: var(--warn); }
.prof-final section { padding: 8px 0; border-top: 1px solid var(--line); }
.prof-final h3 { margin: 6px 0; }
.prof-final h4 { margin: 4px 0; }
@media (max-width: 900px) {
  .prof-wrap { grid-template-columns: 1fr; }
  .prof-book { position: static; max-height: none; order: -1; }
  .prof-actions { padding-inline-start: 0; }
  .prof-match { grid-template-columns: 1fr; }
}
@media print {
  .topbar, .toc, .prof-chat, .lesson-head .tabs, .progress { display: none !important; }
  .prof-wrap { display: block; }
}

