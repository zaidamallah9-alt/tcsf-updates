:root {
  --bg: #f4f6fb;
  --surface: #ffffff;
  --surface-2: #f8f9fd;
  --text: #1b2236;
  --muted: #5e6781;
  --line: #e3e7f1;
  --accent: #4f6bed;
  --accent-2: #7a5cf0;
  --def: #eef3ff;   --def-line: #4f6bed;
  --note: #fff7e6;  --note-line: #f0a020;
  --ex: #ecfaf3;    --ex-line: #1fa971;
  --warn: #fdeef0;  --warn-line: #e0475b;
  --shadow: 0 1px 2px rgba(20, 30, 70, .06), 0 6px 20px rgba(20, 30, 70, .06);
  --radius: 16px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #11141d; --surface: #1a1f2c; --surface-2: #151a25; --text: #e8ebf4; --muted: #a0a8be; --line: #2a3142;
    --def: #1c2640; --note: #2e2614; --ex: #12291f; --warn: #331a1f;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.25);
    color-scheme: dark;
  }
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html { scroll-padding-top: 84px; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 16px/1.6 "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; }
h1, h2, h3 { line-height: 1.25; }
.muted { color: var(--muted); }
.view { max-width: 1180px; margin: 0 auto; padding: 24px 28px 64px; outline: none; }

/* ---------- Barre du haut ---------- */
.topbar {
  position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px;
  padding: 10px 20px; background: color-mix(in srgb, var(--surface) 88%, transparent);
  backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
}
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; white-space: nowrap; }
.brand em { font-style: normal; color: var(--accent); }
.brand-logo {
  width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: #fff; font-size: 14px; letter-spacing: .5px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.crumbs { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0; overflow: hidden; font-size: 14px; color: var(--muted); }
.crumbs a { text-decoration: none; white-space: nowrap; }
.crumbs a:hover { color: var(--accent); }
.crumbs .current { color: var(--text); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.crumbs .sep { opacity: .5; }
.icon-btn {
  width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--text);
  display: grid; place-items: center; cursor: pointer; flex: none;
}
.icon-btn svg { width: 20px; height: 20px; }
.icon-btn:hover { border-color: var(--accent); color: var(--accent); }
#menuBtn { margin-left: auto; }

/* ---------- Boutons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 12px;
  border: 1px solid var(--line); background: var(--surface); color: var(--text); font: inherit; font-weight: 600;
  cursor: pointer; text-decoration: none;
}
.btn:hover { border-color: var(--accent); }
.btn.primary { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border: none; }
.btn.ghost { background: transparent; }

/* ---------- Accueil ---------- */
.hero {
  display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 28px 32px; margin-bottom: 26px;
  border-radius: 22px; color: #fff; background: linear-gradient(120deg, #3b4fd8, #7a5cf0 60%, #b45cf0);
  box-shadow: var(--shadow); overflow: hidden;
}
.hero h1 { margin: 4px 0 6px; font-size: clamp(22px, 3vw, 32px); }
.hero .muted { color: rgba(255,255,255,.85); margin: 0; }
.eyebrow { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .85; }
.hero-art { width: 120px; height: 120px; flex: none; opacity: .9; animation: spin 40s linear infinite; }
.hero-art svg { width: 100%; height: 100%; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .hero-art { animation: none; } }

.grid { display: grid; gap: 18px; }
.subjects { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
.tile {
  position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 20px; min-height: 168px;
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none;
  box-shadow: var(--shadow); transition: transform .15s ease, box-shadow .15s ease, border-color .15s;
}
.tile:hover, .tile:focus-visible { transform: translateY(-3px); border-color: var(--c1); box-shadow: 0 10px 28px rgba(20,30,70,.14); outline: none; }
.tile-icon {
  width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; color: #fff; margin-bottom: 8px;
  background: linear-gradient(135deg, var(--c1), var(--c2)); box-shadow: 0 6px 16px color-mix(in srgb, var(--c1) 40%, transparent);
}
.tile-icon svg { width: 36px; height: 36px; }
.tile-icon.big { width: 76px; height: 76px; border-radius: 20px; }
.tile-icon.big svg { width: 46px; height: 46px; }
.initials { font-weight: 800; font-size: 22px; }
.tile-title { font-weight: 700; font-size: 17px; }
.tile-sub { font-size: 13px; color: var(--muted); }
.tile:not(.soon) .tile-sub { color: var(--ex-line); font-weight: 600; }
.tile:not(.soon)::after {
  content: "Disponible"; position: absolute; top: 14px; right: 14px; font-size: 11px; font-weight: 700; color: #fff;
  background: var(--ex-line); padding: 2px 8px; border-radius: 99px;
}
.tile.soon .tile-icon { filter: saturate(.75); }

/* ---------- En construction ---------- */
.construction {
  max-width: 560px; margin: 40px auto; text-align: center; background: var(--surface); border: 1px solid var(--line);
  border-radius: 24px; padding: 40px 28px; box-shadow: var(--shadow);
}
.construction-icon {
  width: 96px; height: 96px; margin: 0 auto 14px; border-radius: 26px; display: grid; place-items: center; color: #fff;
  background: linear-gradient(135deg, var(--c1, var(--accent)), var(--c2, var(--accent-2)));
}
.construction-icon svg { width: 58px; height: 58px; }
.construction h1 { margin: 6px 0 12px; }
.badge-soon {
  display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 99px; font-weight: 700;
  background: var(--note); color: #b26b00; border: 1px dashed var(--note-line);
}
.badge-soon svg { width: 20px; height: 20px; }
.construction p { margin: 18px 0 24px; }

/* ---------- Matière ---------- */
.subject-head, .lesson-head {
  display: flex; align-items: center; gap: 20px; padding: 22px 26px; margin-bottom: 22px; border-radius: 20px;
  background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); position: relative; overflow: hidden;
}
.subject-head::before, .lesson-head::before {
  content: ""; position: absolute; inset: 0 auto 0 0; width: 6px; background: linear-gradient(var(--c1), var(--c2));
}
.subject-head h1, .lesson-head h1 { margin: 2px 0 4px; font-size: clamp(22px, 3vw, 30px); }
.subject-head .eyebrow, .lesson-head .eyebrow { color: var(--c1); opacity: 1; }
.subject-head p.muted { margin: 0; }
.group-title { font-size: 15px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 8px 0 12px; }
.lessons { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
.lesson-card {
  display: flex; gap: 16px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  text-decoration: none; box-shadow: var(--shadow); transition: transform .15s, border-color .15s;
}
.lesson-card:hover, .lesson-card:focus-visible { transform: translateY(-3px); border-color: var(--c1); outline: none; }
.lesson-card h3 { margin: 0 0 4px; font-size: 19px; }
.lesson-card p { margin: 0 0 10px; font-size: 14px; }
.lesson-num {
  flex: none; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; color: #fff;
  background: linear-gradient(135deg, var(--c1, #9aa3b8), var(--c2, #9aa3b8));
}
.lesson-num svg { width: 30px; height: 30px; }
.lesson-card.disabled { opacity: .65; border-style: dashed; box-shadow: none; }
.lesson-card.disabled .lesson-num { background: #9aa3b8; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--line); }

/* ---------- Leçon ---------- */
.lesson-head { justify-content: space-between; flex-wrap: wrap; }
.tabs { display: flex; gap: 6px; padding: 5px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 14px; }
.tab { padding: 8px 20px; border-radius: 10px; text-decoration: none; font-weight: 700; color: var(--muted); }
.tab:hover { color: var(--text); }
.tab.active { background: linear-gradient(135deg, var(--c1), var(--c2)); color: #fff; }
.lesson-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 26px; align-items: start; }
.toc {
  position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow: auto; padding: 16px; background: var(--surface);
  border: 1px solid var(--line); border-radius: var(--radius); font-size: 14px;
}
.toc-title { margin: 0 0 8px; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.toc ol { margin: 0; padding-left: 18px; }
.toc li { margin: 4px 0; }
.toc a { text-decoration: none; color: var(--muted); }
.toc a:hover, .toc a.active { color: var(--accent); font-weight: 600; }
.progress { position: fixed; left: 0; right: 0; bottom: 0; height: 4px; background: transparent; z-index: 30; }
.progress span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }

/* ---------- Contenu des leçons ---------- */
.content {
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 30px 38px 40px;
  box-shadow: var(--shadow); font-size: 17px;
}
.content h2 {
  margin: 34px 0 14px; padding-top: 6px; font-size: 24px; display: flex; gap: 12px; align-items: baseline;
}
.content h2:first-of-type { margin-top: 0; }
.content h2 .num {
  flex: none; display: inline-grid; place-items: center; min-width: 34px; height: 34px; padding: 0 8px; border-radius: 10px;
  color: #fff; font-size: 16px; background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.content h3 { margin: 24px 0 8px; font-size: 19px; color: var(--accent); }
.content p { margin: 10px 0; }
.content ul, .content ol { padding-left: 24px; }
.content li { margin: 4px 0; }
.content .intro { font-size: 18px; color: var(--muted); border-left: 4px solid var(--line); padding-left: 16px; }

.box { border-radius: 12px; padding: 14px 18px; margin: 16px 0; border-left: 5px solid; }
.box > :first-child { margin-top: 0; }
.box > :last-child { margin-bottom: 0; }
.box-title { display: block; font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
.def  { background: var(--def);  border-color: var(--def-line); }   .def  .box-title { color: var(--def-line); }
.note { background: var(--note); border-color: var(--note-line); }  .note .box-title { color: #c07800; }
.ex   { background: var(--ex);   border-color: var(--ex-line); }    .ex   .box-title { color: var(--ex-line); }
.warn { background: var(--warn); border-color: var(--warn-line); }  .warn .box-title { color: var(--warn-line); }

/* Formules */
.formula {
  display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 10px; margin: 16px auto; padding: 14px 20px;
  background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; font: 21px/1.4 "Cambria Math", Cambria, "Times New Roman", serif;
  text-align: center; max-width: 100%; overflow-x: auto;
}
.formula.key { border: 2px solid var(--accent); background: var(--def); }
.m { font-family: "Cambria Math", Cambria, "Times New Roman", serif; font-size: 1.08em; white-space: nowrap; }
.m i, .formula i { font-style: italic; }
sub, sup { font-size: .68em; line-height: 0; }
.frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 4px; }
.frac > span:first-child { border-bottom: 1.5px solid currentColor; padding: 0 4px 2px; }
.frac > span:last-child { padding: 2px 4px 0; }
/* Symbole du noyau  A/Z X */
.nuc { display: inline-flex; align-items: center; font-family: "Cambria Math", Cambria, "Times New Roman", serif; white-space: nowrap; vertical-align: middle; }
.nuc .az { display: inline-flex; flex-direction: column; align-items: flex-end; font-size: .62em; line-height: 1.05; margin-right: 1px; }
.nuc .x { font-size: 1.12em; }
.formula .nuc { font-size: 1.5em; }

table { border-collapse: collapse; width: 100%; margin: 14px 0; font-size: 15.5px; }
.table-wrap { overflow-x: auto; }
th, td { border: 1px solid var(--line); padding: 8px 12px; text-align: center; }
th { background: var(--surface-2); font-weight: 700; }
td.l, th.l { text-align: left; }

figure { margin: 18px 0; text-align: center; }
figure svg { max-width: 100%; height: auto; }
figcaption { font-size: 14px; color: var(--muted); margin-top: 6px; }
.figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; }
.figs figure { margin: 0; padding: 12px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; }

/* Frise historique */
.timeline { list-style: none; padding: 0 !important; margin: 18px 0; position: relative; }
.timeline::before { content: ""; position: absolute; left: 62px; top: 6px; bottom: 6px; width: 3px; background: var(--line); border-radius: 3px; }
.timeline li { display: grid; grid-template-columns: 52px 1fr; gap: 30px; margin: 0 0 14px !important; position: relative; }
.timeline li::before { content: ""; position: absolute; left: 56px; top: 7px; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); border: 3px solid var(--surface); }
.timeline .year { font-weight: 800; color: var(--accent); text-align: right; font-size: 15px; }
.timeline b { display: block; }

details.solution { margin: 10px 0 4px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
details.solution summary { cursor: pointer; padding: 8px 14px; font-weight: 700; color: var(--ex-line); }
details.solution > div { padding: 2px 16px 12px; }

.keypoints { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin: 14px 0; }
.keypoints > div { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
.keypoints b { color: var(--accent); }

/* ---------- Menu ---------- */
.menu { position: fixed; inset: 0; z-index: 50; background: rgba(10, 14, 30, .45); display: grid; place-items: center; padding: 16px; }
.menu[hidden] { display: none; }
.menu-card { width: min(480px, 100%); background: var(--surface); border-radius: 20px; padding: 24px; box-shadow: 0 20px 60px rgba(0,0,0,.3); }
.menu-card h2 { margin: 0 0 4px; }
.menu-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 8px; }
.menu-msg { min-height: 1.4em; font-weight: 600; color: var(--accent); }
.menu-card .close { width: 100%; }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .lesson-layout { grid-template-columns: 1fr; }
  .toc { position: static; max-height: none; }
  .content { padding: 22px 20px 30px; font-size: 16px; }
}
@media (max-width: 640px) {
  .view { padding: 16px 16px 48px; }
  .brand-text { display: none; }
  .hero { padding: 22px; }
  .hero-art { display: none; }
  .subjects { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .tile { min-height: 140px; padding: 14px; }
  .tile:not(.soon)::after { display: none; }
  .lessons { grid-template-columns: 1fr; }
  .timeline::before { left: 50px; }
  .timeline li { grid-template-columns: 40px 1fr; gap: 26px; }
  .timeline li::before { left: 44px; }
}

/* =================== Widgets interactifs =================== */
.widget {
  margin: 22px 0; padding: 16px; border-radius: 18px; background: var(--surface-2); border: 1px solid var(--line);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent); outline: none;
}
.widget:focus-visible { border-color: var(--accent); }
.w-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 17px; }
.w-badge { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #fff; padding: 3px 9px; border-radius: 99px; background: linear-gradient(135deg, #f59e0b, #ef4444); }
.w-hint { font-size: 13px; color: var(--muted); margin-left: auto; }
.w-stage { position: relative; border-radius: 14px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
.w-stage.dark { background: #0f1424; border-color: #0f1424; }
.w-canvas { display: block; width: 100%; }
.w-controls { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.w-controls .btn { padding: 8px 14px; font-size: 14px; }

.w-timeline { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 8px; }
.w-step {
  flex: 1 0 96px; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 6px; border-radius: 12px;
  background: var(--surface); border: 1px solid var(--line); color: var(--text); font: inherit; cursor: pointer; transition: all .2s;
}
.w-step span { font-size: 11px; color: var(--muted); }
.w-step b { font-size: 14px; }
.w-step.past { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
.w-step.active { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border-color: transparent; transform: translateY(-2px); box-shadow: 0 6px 16px rgba(79,107,237,.35); }
.w-step.active span { color: rgba(255,255,255,.85); }
.w-info { margin-top: 12px; padding: 14px 16px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
.w-info h4 { margin: 6px 0 4px; font-size: 18px; }
.w-info p { margin: 0; }
.w-info-top { display: flex; gap: 8px; flex-wrap: wrap; }
.w-year { font-weight: 800; color: var(--accent); }
.w-news { font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 99px; background: var(--ex); color: var(--ex-line); }
.w-info.pop { animation: pop .4s ease; }
@keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

.w-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; margin-top: 12px; }
.w-stats > div { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 8px 12px; font-size: 14px; }
.w-stats b { font-size: 18px; margin-right: 4px; }
.w-stats small { color: var(--muted); margin-left: 4px; }
.dot { display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
.w-note { font-size: 14.5px; margin: 10px 0 0 !important; padding: 10px 12px; border-radius: 10px; background: var(--note); }

.w-builder { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 14px; }
.w-b-left { position: relative; }
.w-toast {
  position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 8px 12px; border-radius: 10px; font-size: 14px; text-align: center;
  background: rgba(15,20,36,.88); color: #fff; opacity: 0; transform: translateY(8px); transition: all .25s; pointer-events: none;
}
.w-toast.show { opacity: 1; transform: none; }
.w-counters { display: grid; gap: 8px; }
.w-counter { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 6px 10px; }
.w-count-label { flex: 1; font-weight: 600; }
.w-count-val { min-width: 30px; text-align: center; font-weight: 800; font-size: 18px; }
.w-round {
  width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface-2); color: var(--text);
  font-size: 20px; font-weight: 700; cursor: pointer; line-height: 1;
}
.w-round:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
.w-round:active { transform: scale(.92); }
.w-out { margin-top: 10px; }
.w-symbol { display: flex; align-items: center; gap: 14px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.w-symbol .nuc { font-size: 34px; color: var(--accent); }
.w-symbol div { display: flex; flex-direction: column; }
.w-symbol span { font-size: 14px; color: var(--muted); }
.w-table { font-size: 14px; margin: 10px 0 8px; }
.w-table td { text-align: left; padding: 5px 10px; }
.w-table td:first-child { color: var(--muted); }
.w-massbar { height: 10px; border-radius: 99px; background: color-mix(in srgb, #e5484d 35%, var(--surface)); overflow: hidden; }
.w-massbar span { display: block; height: 100%; background: #3b82f6; }
.w-small { font-size: 13px; color: var(--muted); margin: 6px 0 0 !important; }
.w-tip { font-size: 13px; margin: 6px 0 0 !important; color: var(--accent); font-weight: 600; }
.w-warn { font-size: 13px; margin: 6px 0 0 !important; color: var(--warn-line); font-weight: 600; }
.w-presets { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 12px; }
.chip-btn {
  font: inherit; font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 99px; cursor: pointer;
  background: var(--surface); color: var(--text); border: 1px solid var(--line);
}
.chip-btn:hover { border-color: var(--accent); color: var(--accent); }

.w-range { width: 100%; margin: 14px 0 6px; accent-color: var(--accent); height: 6px; }
.w-zoomlab { font-size: 14px; text-align: center; color: var(--muted); }
.w-compare { margin-top: 10px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
.w-compare p { margin: 4px 0 !important; }
.w-compare-res { font-size: 15px; }

.w-quiz { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
.w-quiz-top { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); font-weight: 600; }
.w-quiz-bar { height: 6px; border-radius: 99px; background: var(--line); margin: 8px 0 12px; overflow: hidden; }
.w-quiz-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width .3s; }
.w-q { font-size: 18px; font-weight: 700; margin: 0 0 12px !important; }
.w-opts { display: grid; gap: 8px; }
.w-opt {
  text-align: left; font: inherit; padding: 10px 14px; border-radius: 12px; cursor: pointer; background: var(--surface-2);
  border: 2px solid var(--line); color: var(--text); transition: all .15s;
}
.w-opt:hover:not(:disabled) { border-color: var(--accent); transform: translateX(3px); }
.w-opt.ok { border-color: var(--ex-line); background: var(--ex); }
.w-opt.ko { border-color: var(--warn-line); background: var(--warn); }
.w-opt:disabled { cursor: default; }
.w-fb { margin: 12px 0; padding: 0; font-size: 15px; }
.w-fb.ok, .w-fb.ko { padding: 10px 12px; border-radius: 10px; }
.w-fb.ok { background: var(--ex); }
.w-fb.ko { background: var(--warn); }
.w-quiz-end { text-align: center; padding: 10px 0; }
.w-score { font-size: 44px; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
.w-quiz .btn { margin-top: 4px; }

@media (max-width: 760px) {
  .w-builder { grid-template-columns: 1fr; }
  .w-hint { margin-left: 0; width: 100%; }
}

/* =================== Révision interactive =================== */
.recall {
  display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; margin: 6px 0 16px; border-radius: 14px;
  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 10%, var(--surface)), var(--surface)); border: 1px solid var(--line);
}
.recall::before { content: "💡"; font-size: 22px; line-height: 1.2; }
.recall p { margin: 0 !important; }
.flips { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin: 14px 0; }
.flip {
  position: relative; min-height: 132px; border: none; padding: 0; background: none; cursor: pointer; perspective: 900px; font: inherit; color: inherit; text-align: center;
}
.flip .f-front, .flip .f-back {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 12px 14px;
  border-radius: 16px; backface-visibility: hidden; transition: transform .55s cubic-bezier(.2,.8,.2,1); box-shadow: var(--shadow);
}
.flip .f-front { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-weight: 700; font-size: 17px; }
.flip .f-front small { font-weight: 500; opacity: .85; font-size: 12px; }
.flip .f-front::after { content: "↻ clique pour voir"; position: absolute; bottom: 8px; font-size: 11px; font-weight: 600; opacity: .75; }
.flip .f-back { background: var(--surface); border: 2px solid var(--accent); transform: rotateY(180deg); font-size: 14.5px; line-height: 1.45; }
.flip.flipped .f-front { transform: rotateY(-180deg); }
.flip.flipped .f-back { transform: rotateY(0); }
.flip:hover .f-front { filter: brightness(1.08); }
.flip:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 16px; }
.flip.f2 .f-front { background: linear-gradient(135deg, #0ea5e9, #6366f1); }
.flip.f3 .f-front { background: linear-gradient(135deg, #f59e0b, #ef4444); }
.flip.f4 .f-front { background: linear-gradient(135deg, #10b981, #0ea5e9); }

.w-explorer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: center; }
.ex-svg { width: 100%; max-width: 340px; margin: 0 auto; display: block; color: var(--text); }
.ex-hit { cursor: pointer; transition: filter .2s, stroke-width .2s; }
.ex-hit:hover { filter: brightness(1.2) drop-shadow(0 0 4px rgba(79,107,237,.6)); }
.ex-hit.sel { stroke: #facc15 !important; stroke-width: 3 !important; stroke-opacity: 1 !important; }
.ex-orbit { transform-origin: 150px 150px; animation: spin 14s linear infinite; }
.ex-orbit.o2 { animation-duration: 24s; animation-direction: reverse; }
.w-explorer:hover .ex-orbit { animation-play-state: paused; }
.ex-panel { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; min-height: 180px; }
.ex-panel h4 { margin: 0 0 6px; font-size: 19px; }
.ex-panel p { margin: 0 0 10px !important; }
.ex-panel.pop { animation: pop .35s ease; }
.ex-found { display: flex; flex-wrap: wrap; gap: 6px; }
.ex-found span { font-size: 12px; padding: 3px 9px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--line); color: var(--muted); }
.ex-found span.on { background: var(--ex); color: var(--ex-line); border-color: var(--ex-line); font-weight: 700; }

.w-ns { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 14px; align-items: center; }
.w-big { font-size: 22px; font-weight: 800; margin: 4px 0 !important; color: var(--accent); }
.w-ns-out .formula { font-size: 17px; margin: 8px 0; }

.w-levels { border: 2px solid color-mix(in srgb, var(--accent) 30%, var(--line)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 6%, var(--surface-2)), var(--surface-2)); }
.w-levels .w-badge { background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
.lv-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.lv-tab {
  font: inherit; font-weight: 700; padding: 10px; border-radius: 12px; cursor: pointer; border: 2px solid var(--line);
  background: var(--surface); color: var(--text); transition: all .2s;
}
.lv-tab.facile.active { border-color: #22c55e; background: color-mix(in srgb, #22c55e 14%, var(--surface)); }
.lv-tab.moyen.active { border-color: #f59e0b; background: color-mix(in srgb, #f59e0b 14%, var(--surface)); }
.lv-tab.difficile.active { border-color: #ef4444; background: color-mix(in srgb, #ef4444 14%, var(--surface)); }
.lv-tab.locked { opacity: .55; cursor: not-allowed; border-style: dashed; }
.lv-ok { color: var(--ex-line); }
.lv-score { font-size: 14px; margin: 10px 2px; }
.lv-body { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px; position: relative; overflow: hidden; }
.lv-top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); font-weight: 600; }
.lv-pill { padding: 2px 10px; border-radius: 99px; font-weight: 800; }
.lv-pill.facile { background: #dcfce7; color: #15803d; } .lv-pill.moyen { background: #fef3c7; color: #b45309; } .lv-pill.difficile { background: #fee2e2; color: #b91c1c; }
.lv-type { margin-left: auto; padding: 2px 10px; border-radius: 99px; background: var(--def); color: var(--accent); }
.lv-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.lv-input {
  flex: 1 1 220px; font: inherit; font-size: 17px; padding: 10px 14px; border-radius: 12px; border: 2px solid var(--line);
  background: var(--surface-2); color: var(--text); outline: none;
}
.lv-input:focus { border-color: var(--accent); }
.lv-unit { font-weight: 700; color: var(--muted); }
.lv-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.lv-actions.center { justify-content: center; }
.lv-lockmsg { margin-bottom: 10px; padding: 10px 12px; border-radius: 10px; background: var(--note); font-weight: 600; font-size: 14px; }
.w-fb p { margin: 6px 0 0 !important; }
.confetti { position: absolute; inset: 0; pointer-events: none; }
.confetti i { position: absolute; top: -10px; width: 8px; height: 12px; border-radius: 2px; animation: fall 2.2s ease-in forwards; }
@keyframes fall { to { transform: translateY(380px) rotate(540deg); opacity: 0; } }
.cats { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
.cat-desc { font-size: 14px; }
.tile.cat { min-height: 190px; }
@media (max-width: 760px) {
  .w-explorer, .w-ns { grid-template-columns: 1fr; }
  .lv-tabs { grid-template-columns: 1fr; }
}

/* Saisie scientifique : nombre × 10^exposant */
.lv-sci { display: inline-flex; align-items: flex-start; gap: 6px; flex: 1 1 260px; }
.lv-sci .lv-mant { flex: 1 1 140px; min-width: 0; margin-top: 12px; }
.lv-pow { font: 600 20px/1 "Cambria Math", Cambria, "Times New Roman", serif; margin-top: 23px; white-space: nowrap; }
.lv-sup { display: inline-block; }
.lv-exp { width: 74px; flex: none; padding: 6px 8px; font-size: 15px; text-align: center; }

/* =================== V2 : RTL (arabe), examens =================== */
[dir="rtl"] { text-align: right; }
[dir="rtl"] .content, [dir="rtl"] .toc, [dir="rtl"] .w-levels { font-family: "Segoe UI", Tahoma, "Arabic Typesetting", Arial, sans-serif; }
[dir="rtl"] .content { font-size: 18.5px; line-height: 1.9; }
[dir="rtl"] .box { border-left: 0; border-right: 5px solid; }
[dir="rtl"] .def { border-right-color: var(--def-line); } [dir="rtl"] .note { border-right-color: var(--note-line); }
[dir="rtl"] .ex { border-right-color: var(--ex-line); } [dir="rtl"] .warn { border-right-color: var(--warn-line); }
[dir="rtl"] .content .intro { border-left: 0; padding-left: 0; border-right: 4px solid var(--line); padding-right: 16px; }
[dir="rtl"] .content ul, [dir="rtl"] .content ol, [dir="rtl"] .toc ol { padding-left: 0; padding-right: 22px; }
[dir="rtl"] .subject-head::before, [dir="rtl"] .lesson-head::before { inset: 0 0 0 auto; }
[dir="rtl"] .w-opt { text-align: right; }
[dir="rtl"] .w-hint { margin-left: 0; margin-right: auto; }
[dir="rtl"] .lv-type { margin-left: 0; margin-right: auto; }
[dir="rtl"] .flip .f-front::after { content: "↻ انقر للقلب"; }
[dir="rtl"] th.l, [dir="rtl"] td.l { text-align: right; }
[dir="rtl"] .eyebrow { letter-spacing: 0; text-transform: none; }
[dir="rtl"] .lv-sci, [dir="rtl"] .m, [dir="rtl"] .formula { direction: ltr; }
[lang="en"] .flip .f-front::after { content: "↻ click to flip"; }
.ex-setup { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin: 14px 0; }
.ex-setup label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: 14px; }
.ex-setup select { font-size: 15px; padding: 8px 10px; flex: none; }
.ex-pick { margin: 12px 0; }
.ex-pick-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 8px; }
.ex-pick-btns { margin-inline-start: auto; display: flex; gap: 6px; }
.ex-mods { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; }
.ex-mod { border: 1px solid var(--line, #e2e8f0); border-radius: 12px; padding: 6px 12px 10px; margin: 0; min-width: 0; }
.ex-mod legend { padding: 0 6px; }
.ex-mod legend label, .ex-les { display: flex; align-items: flex-start; gap: 8px; cursor: pointer; }
.ex-les { padding: 4px 0; font-size: 14px; }
.ex-mod input { width: 18px; height: 18px; flex: none; margin-top: 2px; accent-color: var(--accent); }
.ex-pick-msg { color: #b91c1c; min-height: 1em; }
.ex-mist li { margin-bottom: 12px; padding: 10px 12px; border-radius: 10px; background: var(--warn); }
.ex-mist p { margin: 4px 0 !important; }
.content table.t2 td, .content table.t2 th { text-align: start; }
.tag { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 99px; background: var(--def); color: var(--accent); }

/* Vecteur : flèche au-dessus */
.v { display: inline-block; position: relative; padding-top: .42em; line-height: 1; font-style: italic; }
.v::before { content: "→"; position: absolute; top: -.18em; left: 0; right: 0; text-align: center; font-size: .75em; font-style: normal; }

[dir="rtl"] .formula[dir="rtl"] { direction: rtl; font-family: "Traditional Arabic", "Segoe UI", Tahoma, serif; font-size: 22px; }

/* ===== Expériences interactives (sims*.js) ===== */
.w-sim { margin: 18px 0 26px; padding: 16px; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--line); }
.sim-stage { padding: 6px; }
.sim-svg { display: block; width: 100%; height: auto; max-height: 420px; font-family: inherit; color: var(--text); user-select: none; }
.sim-svg text { fill: var(--text); font-size: 13px; }
.sim-svg text.tick { fill: var(--muted); font-size: 10.5px; }
.sim-svg text.muted { fill: var(--muted); }
.sim-svg text.small { font-size: 11.5px; fill: var(--muted); }
.sim-svg text.lab { font-weight: 700; font-size: 14px; }
.sim-svg text.axl { font-size: 12px; font-weight: 700; fill: var(--muted); }
.sim-svg text.white { fill: #fff; font-weight: 700; }
.sim-svg text.lcdt { fill: #a7f3d0; font-family: Consolas, monospace; font-size: 13px; }
.sim-svg text.lcdt2 { fill: var(--accent); font-weight: 700; font-family: Consolas, monospace; font-size: 13px; }
.sim-svg text.atom { font-size: 22px; font-weight: 700; }
.sim-svg text.atomw { fill: #fff; font-weight: 700; font-size: 12px; }
.sim-svg text.atomd { fill: #111827; font-weight: 700; font-size: 11px; }
.sim-svg text.elsym { font-size: 22px; font-weight: 800; }
.sim-svg .stroke { stroke: var(--text); fill: none; }
.sim-svg .grid { stroke: var(--line); stroke-width: 1; }
.sim-svg .ax { stroke: var(--muted); stroke-width: 1.5; }
.sim-svg .dash { stroke: var(--muted); stroke-dasharray: 5 5; fill: none; }
.sim-svg .plotbg { fill: var(--surface); }
.sim-svg .obj { fill: var(--muted); opacity: .75; }
.sim-svg .dot { fill: var(--text); }
.sim-svg .pt { fill: var(--text); }
.sim-svg .puck { fill: var(--accent); opacity: .07; stroke: var(--accent); stroke-opacity: .35; }
.sim-svg .plane { fill: color-mix(in srgb, var(--muted) 30%, transparent); stroke: var(--muted); }
.sim-svg .wire { stroke: var(--text); stroke-width: 2.5; fill: none; stroke-linejoin: round; }
.sim-svg .flow { stroke: #f59e0b; stroke-width: 3; fill: none; stroke-dasharray: 3 15; animation: simflow 1s linear infinite; stroke-linecap: round; }
@keyframes simflow { to { stroke-dashoffset: -36; } }
.sim-svg .meter { fill: var(--surface); stroke: var(--text); stroke-width: 2; }
.sim-svg .lcd { fill: #0f172a; }
.sim-svg .comp { fill: var(--surface); stroke: var(--text); stroke-width: 2; }
.sim-svg .hole { fill: var(--surface); stroke: none; }
.sim-svg .dial { fill: var(--surface); stroke: var(--line); }
.sim-svg .screen { fill: #052e16; }
.sim-svg .sgrid { stroke: #14532d; stroke-width: 1; }
.sim-svg .sgrid2 { stroke: #166534; stroke-width: 1.5; }
.sim-svg .trace { stroke: #4ade80; stroke-width: 2.5; fill: none; filter: drop-shadow(0 0 3px #22c55e); }
.sim-svg .glass { fill: color-mix(in srgb, var(--surface) 70%, transparent); stroke: var(--muted); stroke-width: 2; }
.sim-svg .plate { fill: #f8fafc; stroke: var(--muted); }
.sim-svg .spot { cursor: pointer; }
.sim-svg .pt-el { cursor: pointer; }
.sim-svg .el { fill: var(--surface); stroke: var(--line); stroke-width: 2; }
.sim-svg .el.hi { fill: color-mix(in srgb, #f59e0b 30%, var(--surface)); stroke: #f59e0b; }
.sim-svg .el.on { fill: color-mix(in srgb, var(--accent) 25%, var(--surface)); stroke: var(--accent); }
.sim-ctrls { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 18px; margin-top: 12px; align-items: end; }
.sim-ctrls > .btn { justify-self: start; }
.sim-sl { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; font-size: 14px; }
.sim-sl input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
.sim-sl output { font-weight: 800; color: var(--accent); }
.sim-sl-l { font-weight: 600; color: var(--muted); font-size: 13.5px; }
.sim-seg { display: flex; flex-direction: column; gap: 6px; grid-column: 1 / -1; }
.sim-seg-b { display: flex; flex-wrap: wrap; gap: 6px; }
.chip-btn.on { background: var(--accent); color: #fff; border-color: var(--accent); }
.sim-k { display: block; margin: 0 0 2px !important; }
.w-note.ok { background: var(--ex); }
.w-note.bad { background: var(--warn); }
.sim-coefs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 10px; padding: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; font-size: 18px; }
.sim-coef { display: inline-flex; align-items: center; gap: 4px; }
.sim-coef b { min-width: 18px; text-align: center; color: var(--accent); }
.sim-sp { font-weight: 700; margin-left: 4px; }
.sim-eq-arrow, .sim-eq-plus { font-weight: 800; color: var(--muted); }
.sim-tab { font-size: 14px; margin-bottom: 10px; }
.sim-tab tr.cur td { background: var(--def); }
.sim-top:empty { display: none; }

/* ===== Explication des expériences, 3D, questions au prof ===== */
.sim-guide { margin: 0 0 12px; padding: 10px 14px; border-radius: 12px; background: var(--def); border: 1px solid color-mix(in srgb, var(--accent) 25%, var(--line)); }
.sim-guide summary { cursor: pointer; font-weight: 800; color: var(--accent); }
.sim-guide ol { margin: 6px 0; padding-inline-start: 22px; }
.sim-guide li { margin: 3px 0; }
.sim-guide p { margin: 6px 0; }
.sim-guide-c { padding: 8px 10px; border-radius: 10px; background: var(--note); }
