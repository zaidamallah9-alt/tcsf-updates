// Onglets latéraux (pour tout le monde) :
//  « 📚 Leçons »  → chaque matière et ses rubriques (Cours, Cours vidéo, Avec le prof, Révision, Examens…)
//  « 🧭 Parcours » → le Parcours scientifique : les leçons pas à pas, matière par matière.
(() => {
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const read = async (rel) => { try { const t = window.tcsf ? await window.tcsf.readContent(rel) : await fetch('../content/' + rel).then((r) => (r.ok ? r.text() : null)); return t ? JSON.parse(t) : null; } catch { return null; } };
  const ICON = { cours: '📖', video: '🎬', prof: '👨‍🏫', methode: '📝', revision: '🎯', examen: '🏁', labo: '🔬' };
  const enc = encodeURIComponent;
  const panels = [];
  function sideTab(cls, ic, label, title, fill) {
    const tab = document.createElement('button');
    tab.type = 'button'; tab.className = `acc-side-tab cl-tab ${cls}`; tab.title = title;
    tab.innerHTML = `<span>${ic}</span><b>${label}</b>`;
    const side = document.createElement('aside');
    side.className = 'acc-side cl-side'; side.hidden = true;
    tab.addEventListener('click', () => { const was = side.hidden; panels.forEach((p) => (p.hidden = true)); if (was) { side.hidden = false; fill(side); } });
    panels.push(side);
    document.body.append(tab, side);
  }
  const subjectsReady = async () => ((await read('subjects.json')) || []).filter((s) => s.status === 'ready' && (s.categories || []).some((c) => c.status === 'ready'));
  const head = (side, h, p) => {
    side.innerHTML = `<div class="acc-side-head"><h3>${h}</h3><button type="button" class="chip-btn acc-close" title="Fermer">✕</button></div><p class="w-small muted">${p}</p><div class="cl-list">Chargement…</div>`;
    side.querySelector('.acc-close').onclick = () => (side.hidden = true);
    return side.querySelector('.cl-list');
  };
  const subjRow = (s) => `<details class="cl-subj" data-s="${esc(s.id)}" style="--c1:${esc((s.color || [])[0] || '#4f6bed')}"><summary><span class="cl-dot"></span>${esc(s.title)}<small class="muted cl-n"></small></summary><div class="cl-cats">…</div></details>`;

  // ---- 📚 Leçons : les rubriques de chaque matière ----
  async function fillLecons(side) {
    const list = head(side, '📚 Les leçons', 'Touche une matière, puis une rubrique : Cours, Cours vidéo, Avec le prof, Révision…');
    const subjects = await subjectsReady();
    list.innerHTML = subjects.map(subjRow).join('');
    list.querySelectorAll('.cl-subj').forEach((d) => d.addEventListener('toggle', () => {
      if (!d.open || d.dataset.ok) return; d.dataset.ok = 1;
      const s = subjects.find((x) => x.id === d.dataset.s);
      const cats = (s.categories || []).filter((c) => c.status === 'ready');
      d.querySelector('.cl-n').textContent = ` · ${cats.length} rubriques`;
      d.querySelector('.cl-cats').innerHTML = `<a class="cl-path" href="#/m/${enc(s.id)}">🏠 Page de la matière</a>` + cats.map((c) => `<a href="#/c/${enc(s.id)}/${enc(c.id)}">${ICON[c.mode] || '📘'} ${esc(c.title)}</a>`).join('');
    }));
  }
  // ---- 🧭 Parcours scientifique : les leçons pas à pas ----
  async function fillParcours(side) {
    const list = head(side, '🧭 Parcours scientifique', 'Les leçons dans l’ordre du programme : apprends pas à pas, gagne des 👑 et des XP.');
    const subjects = (await subjectsReady()).filter((s) => (s.categories || []).some((c) => c.mode === 'cours' && c.status === 'ready'));
    const st = (window.TCSF_DUO && window.TCSF_DUO.state()) || { crowns: {} };
    list.innerHTML = subjects.map(subjRow).join('');
    list.querySelectorAll('.cl-subj').forEach((d) => d.addEventListener('toggle', async () => {
      if (!d.open || d.dataset.ok) return; d.dataset.ok = 1;
      const s = subjects.find((x) => x.id === d.dataset.s), c = s.categories.find((x) => x.mode === 'cours');
      const lessons = ((await read(c.lessons)) || []).filter((l) => !l.status || l.status === 'ready');
      const done = lessons.filter((l) => st.crowns[s.id + '/' + l.id]).length;
      d.querySelector('.cl-n').textContent = ` · ${done}/${lessons.length} 👑`;
      let mod = null;
      d.querySelector('.cl-cats').innerHTML = `<a class="cl-path" href="#/m/${enc(s.id)}">🧭 Voir le parcours</a>` + lessons.map((l) => {
        const m = l.module && l.module !== mod ? `<small class="cl-mod">${esc((mod = l.module))}</small>` : '';
        return `${m}<a href="#/s/${enc(s.id)}/${enc(l.id)}">${st.crowns[s.id + '/' + l.id] ? '👑' : '⭐'} ${esc(l.title)}</a>`;
      }).join('');
    }));
  }
  function build() {
    sideTab('cl-lecons', '📚', 'Leçons', 'Les matières et leurs rubriques', fillLecons);
    sideTab('cl-parcours', '🧭', 'Parcours', 'Le Parcours scientifique', fillParcours);
    sideTab('cl-profil', '👤', 'Profil', 'Mon profil', (side) => {
      side.innerHTML = '<div class="acc-side-head"><h3>👤 Mon profil</h3><button type="button" class="chip-btn acc-close" title="Fermer">✕</button></div><div class="pf-host"></div>';
      side.querySelector('.acc-close').onclick = () => (side.hidden = true);
      if (window.TCSF_PROFILE) window.TCSF_PROFILE.mine(side.querySelector('.pf-host'));
    });
    window.addEventListener('hashchange', () => panels.forEach((p) => (p.hidden = true)));
  }
  // ---- bouton 🌓 : automatique → clair → sombre ----
  const TK = 'tcsf:theme';
  const MODES = [['auto', '🌓', 'Thème automatique (comme le téléphone)'], ['light', '☀️', 'Mode clair'], ['dark', '🌙', 'Mode sombre']];
  let mode = 'auto'; try { mode = localStorage.getItem(TK) || 'auto'; } catch {}
  const apply = () => {
    if (mode === 'auto') document.documentElement.removeAttribute('data-theme'); else document.documentElement.setAttribute('data-theme', mode);
    const m = document.querySelector('meta[name="theme-color"]') || document.head.appendChild(Object.assign(document.createElement('meta'), { name: 'theme-color' }));
    const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    m.content = dark ? '#11191e' : '#ffffff';
    try { const SB = window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.StatusBar; if (SB) { SB.setBackgroundColor({ color: m.content }); SB.setStyle({ style: dark ? 'DARK' : 'LIGHT' }); } } catch {}
  };
  apply();
  try { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => mode === 'auto' && apply()); } catch {}
  function themeBtn() {
    const top = document.querySelector('.topbar'); if (!top || top.querySelector('.theme-btn')) return;
    const b = document.createElement('button'); b.type = 'button'; b.className = 'icon-btn theme-btn';
    const paint = () => { const M = MODES.find((x) => x[0] === mode); b.textContent = M[1]; b.title = M[2]; };
    b.onclick = () => { mode = MODES[(MODES.findIndex((x) => x[0] === mode) + 1) % 3][0]; try { localStorage.setItem(TK, mode); } catch {} apply(); paint(); };
    paint(); top.insertBefore(b, document.getElementById('menuBtn'));
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { build(); themeBtn(); }); else { build(); themeBtn(); }
})();
