  function chunks(html) {
    const t = document.createElement('template');
    t.innerHTML = html;
    const out = [];
    let buf = '';
    for (const n of [...t.content.childNodes]) {
      if (n.nodeType === 3) { if (n.textContent.trim()) buf += n.textContent; continue; }
      const h = n.outerHTML;
      // les petites lignes (formules) restent avec le paragraphe qui précède
      if (buf && (n.classList?.contains('formula') || buf.length < 140)) { buf += h; continue; }
      if (buf) out.push(buf);
      buf = h;
    }
    if (buf) out.push(buf);
    return out.length ? out : [html];
  }
  // Phrase clé d'une partie : formule encadrée > définition > premier paragraphe
  function keyOf(html) {
    const d = el_('div', '', html);
    const k = d.querySelector('.formula.key') || d.querySelector('.box.def');
    if (k) { const c = k.cloneNode(true); c.querySelector('.box-title')?.remove(); const s = c.innerHTML.trim(); if (textOf(s).length > 3) return s.length > 600 ? textOf(s).slice(0, 260) + '…' : s; }
    const p = [...d.querySelectorAll('p, li, td')].find((x) => textOf(x.innerHTML).length > 25) || d;
    const s = textOf(p.innerHTML);
    return s.length > 260 ? s.slice(0, 257) + '…' : p.innerHTML;
  }

  W.prof = async (el, api) => {
    const lang = (el.closest('[lang]')?.getAttribute('lang') || 'fr').slice(0, 2);
    const Q = window.TCSF_Q;
    const VO = window.TCSF_VOICE;
    const QA = window.TCSF_QA;
    const subject = String(el.dataset.src || '').split('/')[0];
    const d = (await api.readJSON(el.dataset.src)) || {};
    // Langue de l'explication (leçons en français qui ont une version arabe) : fr | mix | ar
    const AR = lang === 'fr' && d.ar && d.ar.cours && d.ar.cours.length ? d.ar : null;
    let mode = 'fr';
    try { mode = localStorage.getItem('tcsf:proflang') || 'fr'; } catch {}
    if (!AR || !['fr', 'mix', 'ar'].includes(mode)) mode = 'fr';
    const ui = mode === 'ar' ? 'ar' : lang; // langue des messages du prof
    const S = Object.assign({}, P[ui] || P.fr, P2[ui] || P2.fr, X[ui] || X.fr);
    const QS = (Q && (Q.STR[ui] || Q.STR.fr)) || {};
    const title = (mode === 'ar' && AR.title) || el.dataset.title || '';
    const arBox = (html, label) => `<div class="prof-ar" dir="rtl" lang="ar"><b class="prof-ar-h"><span class="ar-badge">ع</span> ${label || X.fr.inAr}</b>${html}</div>`;
    const firstP = (html, n = 1) => { const t = document.createElement('template'); t.innerHTML = html || ''; const ps = [...t.content.querySelectorAll('p')].slice(0, n); return ps.length ? ps.map((x) => x.outerHTML).join('') : html; };
    // formules, tableaux et expériences de la version française (gardés tels quels en mode arabe)
    const extras = (html) => { const t = document.createElement('template'); t.innerHTML = html; const xs = [...t.content.querySelectorAll('.formula, [data-widget], table')].filter((n) => !n.parentElement?.closest('.formula, [data-widget], table')); return xs.length ? `<div dir="ltr" lang="fr" class="prof-extras"><p class="prof-sub" dir="rtl">📐 ${X.ar.formulas}</p>${xs.map((n) => n.outerHTML).join('')}</div>` : ''; };
    const revHref = el.dataset.rev || '';
    // parties du cours
    let parts = (d.cours || []).map((s) => ({ t: s.t, h: s.h }));
    if (!parts.length && d.coursFile && api.readText) {
      const html = (await api.readText(d.coursFile)) || '';
      const t = document.createElement('template');
      t.innerHTML = html;
      let cur = null;
      for (const n of [...t.content.childNodes]) {
        if (n.nodeName === 'H2') { cur = { t: n.innerHTML, h: '' }; parts.push(cur); continue; }
        if (cur) cur.h += n.nodeType === 1 ? n.outerHTML : n.textContent;
      }
      parts = parts.filter((p) => !/exercice/i.test(textOf(p.t)) && textOf(p.h).length > 20);
    }
    if (AR) parts.forEach((p, i) => { p.ar = AR.cours[i] || null; });
    // titre d'une partie selon la langue choisie
    const PT = (p) => (mode === 'ar' && p.ar ? p.ar.t : mode === 'mix' && p.ar ? `${p.t} <span class="prof-ar-t" dir="rtl" lang="ar">· ${p.ar.t}</span>` : p.t);
    const keyHTML = (p) => (mode === 'ar' && p.ar ? firstP(p.ar.h) : keyOf(p.h) + (mode === 'mix' && p.ar ? arBox(firstP(p.ar.h)) : ''));
    const ex = d.exercises || {};
    const pool = [...(ex.facile || []), ...(ex.moyen || [])];
    const hard = [...(ex.difficile || [])];
    const used = new Set();
    // pour chaque partie, la question (facile/moyen) dont les mots ressemblent le plus à la partie
    const words = (s) => new Set(textOf(s).toLowerCase().normalize('NFD').replace(/[̀-ًͯ-ْ]/g, '').split(/[^a-z0-9؀-ۿ]+/).filter((w) => w.length >= 4));
    const qText = (q) => [q.q, q.explain, ...(q.choices || []), ...(q.accept || [])].join(' ');
    const warm = parts.map((p, i) => {
      const pw = words(p.t + ' ' + p.t + ' ' + p.h);
      let best = null, bestS = -1;
      pool.concat(hard).forEach((q, k) => {
        if (used.has(q)) return;
        let s = 0; for (const w of words(qText(q))) if (pw.has(w)) s++;
        s -= (k >= pool.length ? 0.5 : 0) + Math.abs(k - i) * 0.01; // préférer une question facile, puis l'ordre des exercices
        if (s > bestS) { bestS = s; best = q; }
      });
      if (best) used.add(best);
      return best;
    });
    const finals = hard.concat(pool).filter((q) => !used.has(q)).slice(0, 3);
    const key = 'prof:' + el.dataset.src;
    const st = Object.assign({ part: 0, notes: {}, self: {}, done: false }, store.get(key) || {});
    const save = () => store.set(key, st);

    el.classList.add('w-prof');
    el.innerHTML = `<div class="w-head"><span class="w-badge">${S.name}</span><b>${S.title}</b><span class="prof-tools"><button type="button" class="chip-btn prof-voice"></button><button type="button" class="chip-btn prof-ask">${S.ask}</button></span></div>
      ${AR ? `<div class="prof-lang" role="group" aria-label="${S.langT}"><span class="w-small">${S.langT} :</span>${[['fr', S.mFr], ['mix', S.mMix], ['ar', S.mAr]].map(([m, l]) => `<button type="button" class="chip-btn${m === mode ? ' on' : ''}" data-m="${m}">${l}</button>`).join('')}</div>` : ''}
      <div class="prof-novoice" hidden></div>
      <div class="prof-wrap"${mode === 'ar' ? ' dir="rtl" lang="ar"' : ''}><div class="prof-chat" aria-live="polite"></div><aside class="prof-book"><h4>📒 ${S.notebook}</h4><ol class="prof-book-list"></ol></aside></div>`;
    el.querySelectorAll('.prof-lang button').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.m === mode) return;
      try { localStorage.setItem('tcsf:proflang', b.dataset.m); } catch {}
      if (VO) VO.stop();
      el.classList.remove('w-prof');
      W.prof(el, api);
    }));
    const chat = el.querySelector('.prof-chat');
    const bookList = el.querySelector('.prof-book-list');

    function renderBook() {
      bookList.innerHTML = parts.map((p, i) => {
        const n = st.notes[i];
        const cls = st.self[i] === true ? 'ok' : st.self[i] === false ? 'ko' : n ? 'wip' : i === st.part && !st.done ? 'cur' : '';
        return `<li class="${cls}"><b>${PT(p)}</b>${n ? `<p>${Q ? Q.escHTML(n) : n}</p>` : ''}</li>`;
      }).join('') || `<li>${S.empty}</li>`;
    }
    const scroll = (n) => { try { n.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch {} };
    // ---- voix du prof ----
    const vBtn = el.querySelector('.prof-voice'), noVoice = el.querySelector('.prof-novoice');
    const needLangs = mode === 'mix' ? [lang, 'ar'] : [ui];
    const paintVoice = () => {
      const on = VO && VO.enabled;
      vBtn.textContent = on ? S.voiceOn : S.voiceOff; vBtn.classList.toggle('on', !!on);
      const miss = on && VO ? needLangs.find((l) => !VO.canSpeak(l)) : null;
      noVoice.hidden = !miss;
      if (miss && noVoice.dataset.l !== miss) { noVoice.innerHTML = ''; noVoice.dataset.l = miss; noVoice.appendChild(VO.missingBox ? VO.missingBox(miss, paintVoice) : document.createTextNode(S.noVoice)); }
      if (!miss) { noVoice.innerHTML = ''; noVoice.dataset.l = ''; }
    };
    vBtn.hidden = !VO;
    vBtn.addEventListener('click', () => { if (!VO) return; VO.setEnabled(!VO.enabled); paintVoice(); });
    paintVoice(); if (VO && VO.ready) VO.ready().then(paintVoice); else setTimeout(paintVoice, 300);
    // lecture : le français avec la voix française, les encadrés arabes avec la voix arabe
    const talk = (html) => {
      if (!VO || !VO.enabled) return;
      const t = document.createElement('template'); t.innerHTML = html;
      t.content.querySelectorAll('.prof-ar-t, .prof-extras, .pm-phase').forEach((x) => x.remove());
      const ars = [...t.content.querySelectorAll('.prof-ar')].map((a) => { a.querySelector('.prof-ar-h')?.remove(); const h = a.innerHTML; a.remove(); return h; });
      VO.speak([[t.innerHTML, ui]].concat(ars.map((h) => [h, 'ar'])), ui);
    };
    el.querySelector('.prof-ask').addEventListener('click', () => { [...chat.querySelectorAll('.prof-actions')].forEach((a) => a.remove()); askBox(); });
    function say(html, cls = '', silent = false) {
      const M = window.TCSF_MASCOT;
      const b = el_('div', 'prof-msg prof ' + cls, `<span class="prof-av mascot" aria-hidden="true">${M ? M.svg(46) : '👨‍🏫'}</span><div class="prof-bubble">${html}</div>`);
      chat.appendChild(b); scroll(b);
      if (!silent) talk(html);
      // Tico (qui se promène sur l'écran) dit la première phrase
      if (M && !/board/.test(cls)) { const t = textOf(String(html).replace(/<span class="pm-phase[^>]*>[^<]*<\/span>/g, '')); M.say((t.match(/^[^.!?؟]{4,}[.!?؟]?/) || [t])[0]); }
      return b.querySelector('.prof-bubble');
    }
    function me(html) { const b = el_('div', 'prof-msg me', `<div class="prof-bubble">${html}</div><span class="prof-av" aria-hidden="true">🧑‍🎓</span>`); chat.appendChild(b); scroll(b); }
    function actions(...bs) { const a = el_('div', 'prof-actions'); bs.forEach((b) => a.appendChild(b)); chat.appendChild(a); scroll(a); return a; }
    const clear = (a) => a && a.remove();
    function initWidgets(node) {
      nucFix(node);
      node.querySelectorAll('[data-widget]').forEach((w) => { const f = W[w.dataset.widget]; if (f && f !== W.prof) { try { Promise.resolve(f(w, api)).catch((e) => console.error(e)); } catch (e) { console.error(e); } } });
      node.querySelectorAll('table').forEach((t) => { if (!t.parentElement.classList.contains('table-wrap')) { const w = el_('div', 'table-wrap'); t.replaceWith(w); w.appendChild(t); } });
      node.querySelectorAll('.flip').forEach((f) => { f.type = 'button'; f.addEventListener('click', () => f.classList.toggle('flipped')); });
    }

    // ---- Accueil ----
    function hello() {
      chat.innerHTML = '';
      const meth = (METHOD[subject] || METHOD._).stages;
      const b = say(S.hello(title) + `<p class="prof-sub">${(LB[ui] || LB.fr).method}</p><div class="pm-method">${meth.map((s) => lbl(s === 'ask' ? (METHOD[subject] || METHOD._).askKey || 'ask' : s === 'explain' ? (METHOD[subject] || METHOD._).explainKey || 'explain' : s)).join('<span class="pm-arrow">→</span>')}</div><p class="prof-sub">${S.plan}</p><ol>${parts.map((p) => `<li>${PT(p)}</li>`).join('')}</ol>` + (d.objectifs && d.objectifs.length ? `<p class="prof-sub">${S.goals}</p><ul${mode === 'ar' ? ' dir="ltr" lang="fr"' : ''}>${d.objectifs.map((o) => `<li>${o}</li>`).join('')}</ul>` : ''));
      b.parentElement.classList.add('first');
      const bs = [];
      if (st.part > 0 && st.part < parts.length && !st.done) bs.push(btn(S.resume(st.part + 1), 'primary', () => { clear(a); partAsk(st.part); }));
      else bs.push(btn(S.start, 'primary', () => { clear(a); st.part = 0; st.done = false; save(); partAsk(0); }));
      if (st.part > 0 || st.done) bs.push(btn(S.restart, 'ghost', () => { st.part = 0; st.notes = {}; st.self = {}; st.done = false; save(); renderBook(); hello(); }));
      const a = actions(...bs);
      if (st.done) { a.prepend(btn(S.notebook + ' 📒', 'primary', () => { clear(a); finish(true); })); }
    }

    // ---- Une partie = une suite d'étapes, propre à la matière (voir METHOD) ----
    const lbl = (key) => `<span class="pm-phase pm-${key}">${(LB[ui] || LB.fr)[key] || ''}</span>`;
    const stagesOf = () => (METHOD[subject] || METHOD._).stages;
    function partAsk(i) {
      st.part = i; save(); renderBook();
      const p = parts[i];
      const sep = el_('div', 'prof-sep', `<span>${S.step} ${i + 1}/${parts.length}</span>`); chat.appendChild(sep);
      say(S.part(i + 1, parts.length, PT(p)), '', true);
      const ctx = { shown: new Set() };
      const seq = stagesOf();
      const run = (k) => { if (k >= seq.length) return; const f = STAGE[seq[k]]; if (!f) return run(k + 1); f(i, () => run(k + 1), ctx); };
      run(0);
    }
    const nextBtn = (label, go) => { const a = actions(btn(label, 'primary', () => { clear(a); me(label); go(); })); return a; };

    const STAGE = {
      // question pour faire réfléchir (avant l'explication) ou pour s'entraîner (après)
      ask(i, next, ctx, practice) {
        const q = warm[i];
        const head = lbl(practice ? 'practice' : (METHOD[subject] || METHOD._).askKey || 'ask');
        if (!q || !Q) { if (practice) return next(); say(head + `<p>${S.thinkNoQ}</p>`); return nextBtn(S.explainMe, next); }
        const fq = mode === 'ar' ? ' dir="ltr" lang="fr"' : '';
        const b = say(head + `<p>${practice ? (LB[ui] || LB.fr).practiceT : S.think}</p><p class="prof-q"${fq}>${q.q}</p>`);
        const zone = el_('div', 'prof-zone'); if (fq) { zone.dir = 'ltr'; zone.lang = 'fr'; } b.appendChild(zone);
        Q.askQuestion(zone, q, QS, (ok) => {
          say(pick(ok ? S.okReact : S.koReact), ok ? 'good' : '');
          nextBtn(ctx.explained ? S.cont : S.explainMe, next);
        });
      },
      practice(i, next, ctx) { STAGE.ask(i, next, ctx, true); },
      // physique : on manipule l'expérience AVANT la théorie
      sim(i, next, ctx) {
        const t = el_('template', ''); t.innerHTML = parts[i].h;
        const sims = [...t.content.querySelectorAll('[data-widget="sim"]')];
        if (!sims.length) return next();
        const b = say(lbl('sim') + `<p>${(LB[ui] || LB.fr).simT}</p>`, 'board');
        sims.forEach((s) => { const c = el_('div', 'prof-chunk content', s.outerHTML); c.querySelector('[data-widget]').dataset.open = '1'; b.appendChild(c); initWidgets(c); ctx.shown.add(s.outerHTML); });
        nextBtn((LB[ui] || LB.fr).observed, next);
      },
      // SVT : un document à observer, l'élève note ce qu'il voit
      observe(i, next, ctx) {
        const cs = chunks(parts[i].h);
        if (cs.length < 2) return next();
        const doc = cs.find((c) => /<table|data-widget|<img|class="box/.test(c)) || cs[0];
        ctx.shown.add(doc);
        const b = say(lbl('observe') + `<p>${(LB[ui] || LB.fr).observeT}</p>`, 'board');
        const c = el_('div', 'prof-chunk content pm-doc', doc); b.appendChild(c); initWidgets(c);
        freeText(b, (LB[ui] || LB.fr).observePh, () => { say((LB[ui] || LB.fr).observeR); next(); });
      },
      // HG / philo : l'élève donne d'abord son avis
      opinion(i, next) {
        const L = LB[ui] || LB.fr;
        const b = say(lbl('opinion') + `<p>${L.opinionT(textOf(parts[i].t))}</p>`);
        freeText(b, L.opinionPh, () => { say(L.opinionR); next(); });
      },
      // islamique : appliquer à sa propre vie
      reflect(i, next) {
        const L = LB[ui] || LB.fr;
        const b = say(lbl('reflect') + `<p>${L.reflectT}</p>`);
        freeText(b, L.reflectPh, () => { say(L.reflectR, 'good'); next(); });
      },
      // maths : un exemple résolu, révélé ligne par ligne
      example(i, next, ctx) {
        const t = el_('template', ''); t.innerHTML = parts[i].h;
        const ex = t.content.querySelector('.box.ex');
        if (!ex) return next();
        ctx.shown.add(ex.outerHTML);
        const lines = [...ex.children].filter((x) => !x.classList.contains('box-title'));
        const flat = lines.length === 1 && lines[0].matches('p, div') && /[;:.]\s/.test(lines[0].textContent) ? lines[0].innerHTML.split(/(?<=[;:.])\s+(?=[A-ZÀ-Ýa-z0-9(√])/).map((x) => `<p>${x}</p>`) : lines.map((x) => x.outerHTML);
        const b = say(lbl('example') + `<p>${(LB[ui] || LB.fr).exampleT}</p>`, 'board');
        let k = 0;
        const show = () => {
          const c = el_('div', 'prof-chunk content pm-step', `<span class="pm-n">${k + 1}</span>${flat[k]}`); b.appendChild(c); nucFix(c); scroll(c); talk(flat[k]);
          k++;
          const a = actions(btn(k < flat.length ? (LB[ui] || LB.fr).nextLine : S.cont, 'primary', () => { clear(a); if (k < flat.length) show(); else next(); }));
        };
        show();
      },
      // langues : les mots importants de la partie, en cartes
      vocab(i, next) {
        const cards = (d.cards || []).filter((c) => c[0] && c[1]);
        if (!cards.length) return next();
        const pw = words(parts[i].t + ' ' + parts[i].h);
        const scored = cards.map((c) => [c, [...words(c[0] + ' ' + c[1])].filter((w) => pw.has(w)).length]).sort((a, b) => b[1] - a[1]);
        const pickC = scored.filter((x) => x[1] > 0).slice(0, 3).map((x) => x[0]);
        if (!pickC.length) return next();
        const b = say(lbl('vocab') + `<p>${(LB[ui] || LB.fr).vocabT}</p>`, 'board');
        const c = el_('div', 'flips pm-vocab', pickC.map((x, k) => `<button class="flip f${(k % 4) + 1}"><span class="f-front">${x[0]}</span><span class="f-back">${x[1]}</span></button>`).join(''));
        b.appendChild(c); initWidgets(c);
        nextBtn(S.cont, next);
      },
      explain(i, next, ctx) { ctx.explained = true; partExplain(i, next, ctx); },
      build(i) { partBuild(i); }
    };
    // réponse libre (pas de note) : l'élève écrit, puis on continue
    function freeText(host, ph, done) {
      const ta = el_('textarea', 'lv-input prof-ta'); ta.rows = 2; ta.placeholder = ph; ta.dir = 'auto';
      host.appendChild(ta); setTimeout(() => ta.focus(), 50);
      const a = actions(btn((LB[ui] || LB.fr).send, 'primary', () => {
        const v = ta.value.trim();
        if (v.length < 2) { ta.focus(); return; }
        ta.disabled = true; clear(a); me(Q ? Q.escHTML(v) : v); done();
      }), btn((LB[ui] || LB.fr).skip, 'ghost', () => { ta.disabled = true; clear(a); done(); }));
    }

    // ---- 2) Explication pas à pas ----
    function partExplain(i, next, ctx) {
      const p = parts[i];
      // en arabe : l'explication arabe, puis les formules / expériences de la version française
      let cs = chunks(mode === 'ar' && p.ar ? p.ar.h + extras(p.h) : p.h);
      // ce qui a déjà été montré (expérience, document, exemple) n'est pas répété
      if (ctx && ctx.shown.size) {
        cs = cs.map((c) => { let x = c; ctx.shown.forEach((s) => { x = x.split(s).join(''); }); return x; }).filter((c) => textOf(c).length > 2 || /data-widget|<table|formula/.test(c));
        if (!cs.length) cs = [p.h];
      }
      const finalLabel = ctx && stagesOf().indexOf('explain') < stagesOf().length - 2 ? S.cont : S.understood;
      const goOn = next || (() => partBuild(i));
      let k = 0, arShown = false;
      const b = say(lbl((METHOD[subject] || METHOD._).explainKey || 'explain') + `<p class="prof-sub">${S.look}</p>`, 'board');
      // « je n'ai pas compris » : la même partie expliquée en arabe (avec les mots français entre parenthèses)
      const showAr = () => {
        if (arShown || !p.ar) return; arShown = true;
        const c = el_('div', 'prof-chunk content', arBox(p.ar.h)); b.appendChild(c); nucFix(c); scroll(c); talk(arBox(p.ar.h));
      };
      const showNext = () => {
        let html = cs[k];
        // mélangé : à la fin de la partie, le résumé en arabe
        if (mode === 'mix' && p.ar && k === cs.length - 1) { html += arBox(p.ar.h); arShown = true; }
        const c = el_('div', 'prof-chunk content', html);
        b.appendChild(c); initWidgets(c); scroll(c); talk(html);
        k++;
        const more = [];
        if (mode === 'fr' && p.ar) more.push(btn(S.noUndAr, '', function () { this.remove(); me(S.noUndAr); showAr(); }));
        const a = k < cs.length
          ? actions(btn(S.cont, 'primary', () => { clear(a); showNext(); }), ...more)
          : actions(btn(finalLabel, 'primary', () => { clear(a); me(finalLabel); goOn(); }), ...more);
      };
      showNext();
    }

    // ---- 3) L'élève construit son cahier ----
    function partBuild(i) {
      const b = say(lbl('build') + `<p>${S.build}</p>`);
      const ta = el_('textarea', 'lv-input prof-ta'); ta.rows = 3; ta.placeholder = S.ph; ta.dir = 'auto'; ta.value = st.notes[i] || '';
      const warn = el_('p', 'w-small');
      b.append(ta, warn);
      setTimeout(() => ta.focus(), 50);
      const a = actions(btn(S.add, 'primary', () => {
        const v = ta.value.trim();
        if (v.split(/\s+/).length < 3) { warn.textContent = S.tooShort; ta.focus(); return; }
        st.notes[i] = v; save(); renderBook();
        ta.disabled = true; clear(a);
        me(`<b>${S.yours} :</b> ${Q ? Q.escHTML(v) : v}`);
        const kb = say(`<p>${S.key}</p><div class="prof-key">${keyHTML(parts[i])}</div><p>${S.selfQ}</p>`);
        nucFix(kb);
        const a2 = actions(
          btn(S.selfOk, 'primary', () => { clear(a2); st.self[i] = true; save(); renderBook(); me(S.selfOk); say(S.selfOkR, 'good'); goNext(i); }),
          btn(S.selfKo, '', () => {
            clear(a2); st.self[i] = false; save(); renderBook(); me(S.selfKo); say(S.selfKoR);
            const a3 = actions(btn(S.fix, '', () => { clear(a3); ta.disabled = false; partBuild(i); }), btn(S.next, 'primary', () => { clear(a3); nextPart(i); }));
          }));
      }));
    }
    function goNext(i) { const a = actions(btn(i + 1 < parts.length ? S.next : S.cont, 'primary', () => { clear(a); nextPart(i); })); }
    function nextPart(i) { if (i + 1 < parts.length) partAsk(i + 1); else { st.part = parts.length; save(); match(); } }

    // ---- 4) Jeu d'association des notions ----
    function match() {
      const cards = (d.cards || []).filter((c) => c[0] && c[1]).slice(0, 6);
      if (cards.length < 2) return finalQ();
      const b = say(`<p>${S.matchT}</p>`);
      const g = el_('div', 'prof-match');
      const L = el_('div', 'pm-col'), R = el_('div', 'pm-col');
      const order = cards.map((_, i) => i).sort(() => Math.random() - 0.5);
      let sel = null, left = cards.length;
      const msg = el_('p', 'w-small');
      cards.forEach((c, i) => {
        const x = el_('button', 'pm-item', c[0]); x.type = 'button'; x.dataset.i = i;
        x.addEventListener('click', () => { if (x.disabled) return; L.querySelectorAll('.pm-item').forEach((y) => y.classList.remove('sel')); x.classList.add('sel'); sel = i; });
        L.appendChild(x);
      });
      order.forEach((i) => {
        const y = el_('button', 'pm-item def', cards[i][1]); y.type = 'button';
        y.addEventListener('click', () => {
          if (sel === null || y.disabled) return;
          if (sel === i) {
            const x = L.querySelector(`[data-i="${i}"]`);
            [x, y].forEach((z) => { z.disabled = true; z.classList.remove('sel'); z.classList.add('ok'); });
            sel = null; left--; msg.textContent = '';
            if (!left) { say(S.matchDone, 'good'); if (Q) Q.burst(el); const a = actions(btn(S.cont, 'primary', () => { clear(a); finalQ(); })); }
          } else { y.classList.add('ko'); msg.textContent = S.matchErr; setTimeout(() => y.classList.remove('ko'), 600); }
        });
        R.appendChild(y);
      });
      if (mode === 'ar') { g.dir = 'ltr'; g.lang = 'fr'; }
      g.append(L, R); b.append(g, msg); nucFix(g);
    }

    // ---- 5) Défi final ----
    function finalQ() {
      if (!finals.length || !Q) return finish();
      say(`<p>${S.finalT}</p>`);
      let k = 0, score = 0;
      const n = finals.length;
      // carte « Défi » : progression en pastilles, une question à la fois, étoiles à la fin
      const card = el_('div', 'defi');
      card.innerHTML = `<div class="defi-top"><span class="defi-cup">🏆</span><b>${ui === 'ar' ? 'التحدي الأخير' : ui === 'en' ? 'Final challenge' : 'Défi final'}</b><span class="defi-dots">${finals.map(() => '<i></i>').join('')}</span></div><div class="defi-body"></div>`;
      chat.appendChild(card); scroll(card);
      const dots = [...card.querySelectorAll('.defi-dots i')], body = card.querySelector('.defi-body');
      const one = () => {
        const q = finals[k];
        dots.forEach((d, i) => d.classList.toggle('cur', i === k));
        body.innerHTML = '';
        const fq = mode === 'ar';
        const qd = el_('div', 'defi-q', `<span class="defi-num">${k + 1}<small>/${n}</small></span><p class="prof-q"${fq ? ' dir="ltr" lang="fr"' : ''}>${q.q}</p>`);
        const zone = el_('div', 'prof-zone'); if (fq) { zone.dir = 'ltr'; zone.lang = 'fr'; }
        body.append(qd, zone); body.classList.remove('in'); void body.offsetWidth; body.classList.add('in');
        talk(q.q);
        Q.askQuestion(zone, q, QS, (ok) => {
          if (ok) score++;
          dots[k].classList.remove('cur'); dots[k].classList.add(ok ? 'ok' : 'ko');
          card.classList.remove('flash-ok', 'flash-ko'); void card.offsetWidth; card.classList.add(ok ? 'flash-ok' : 'flash-ko');
          k++;
          const nx = btn(k < n ? QS.next || S.cont : (ui === 'ar' ? 'النتيجة 🏆' : ui === 'en' ? 'My result 🏆' : 'Mon résultat 🏆'), 'primary', () => { nx.remove(); if (k < n) one(); else result(); });
          const row = el_('div', 'defi-next'); row.appendChild(nx); body.appendChild(row); scroll(row);
        });
      };
      const result = () => {
        const stars = score === n ? 3 : score >= Math.ceil(n / 2) ? 2 : score > 0 ? 1 : 0;
        const msg = ui === 'ar' ? ['حاول مرة أخرى، ستنجح! 💪', 'بداية جيدة! 👍', 'جيد جدا! 👏', 'ممتاز، علامة كاملة! 🌟'][stars] : ui === 'en' ? ['Try again, you can do it! 💪', 'Good start! 👍', 'Very good! 👏', 'Perfect score! 🌟'][stars] : ['Recommence, tu vas y arriver ! 💪', 'Bon début ! 👍', 'Très bien ! 👏', 'Sans faute, bravo ! 🌟'][stars];
        dots.forEach((d) => d.classList.remove('cur'));
        body.innerHTML = `<div class="defi-res"><div class="defi-stars">${[0, 1, 2].map((i) => `<span class="${i < stars ? 'on' : ''}" style="animation-delay:${0.15 + i * 0.25}s">★</span>`).join('')}</div>
          <div class="defi-score"><b>${score}</b> / ${n}</div><p>${msg}</p></div>`;
        body.classList.remove('in'); void body.offsetWidth; body.classList.add('in');
        if (stars === 3 && Q) Q.burst(card);
        try { if (window.TCSF_SFX) window.TCSF_SFX[stars >= 2 ? 'fanfare' : 'good'](); } catch {}
        talk(msg);
        setTimeout(() => finish(), 1600);
      };
      one();
    }

    // ---- 6) Le cahier complet ----
    function finish(direct) {
      st.done = true; st.part = parts.length; save(); renderBook();
      if (!direct && Q) Q.burst(el);
      if (!direct) window.dispatchEvent(new CustomEvent('tcsf:activity', { detail: { act: 'prof', src: el.dataset.src } }));
      const b = say(`<p>${S.done}</p>`, 'good');
      const book = el_('div', 'prof-final');
      book.innerHTML = `<h3>📒 ${S.notebook} — ${title}</h3>` + parts.map((p, i) => `<section><h4>${i + 1}. ${PT(p)}</h4>
        ${st.notes[i] ? `<p><b>${S.yours} :</b> ${Q ? Q.escHTML(st.notes[i]) : st.notes[i]}</p>` : ''}
        <div class="prof-key"><b>${S.prof} :</b> ${keyHTML(p)}</div></section>`).join('');
      b.appendChild(book); nucFix(book);
      const bs = [btn(S.print, '', () => window.print())];
      if (revHref) { const r = el_('a', 'btn primary', S.goRev); r.href = revHref; bs.push(r); }
      bs.push(btn(S.restart, 'ghost', () => { st.part = 0; st.notes = {}; st.self = {}; st.done = false; save(); renderBook(); hello(); }));
      actions(...bs);
      setTimeout(() => askBox(true), direct ? 0 : 600);
    }

    // ---- 7) « As-tu une question ? » : écrite ou dite à voix haute ----
    function askBox(intro) {
      const b = say(intro ? S.anyQ : S.anyQ.split(/[.?؟]/)[0] + (lang === 'ar' ? '؟' : ' ?'));
      const form = el_('form', 'prof-askform');
      const ta = el_('textarea', 'lv-input prof-ta'); ta.rows = 2; ta.placeholder = S.qph; ta.dir = 'auto';
      const mic = btn(S.mic, 'prof-mic', () => listen());
      const go = el_('button', 'btn primary', S.send); go.type = 'submit';
      const tip = el_('p', 'w-small');
      const row = el_('div', 'prof-askrow'); row.append(mic, go);
      form.append(ta, row, tip); b.appendChild(form);
      setTimeout(() => ta.focus(), 60);
      async function listen() {
        if (!VO) return;
        mic.disabled = true; mic.classList.add('rec'); tip.innerHTML = S.listening;
        const r = await VO.listen(lang);
        mic.disabled = false; mic.classList.remove('rec');
        if (r && r.text) { ta.value = (ta.value ? ta.value + ' ' : '') + r.text; tip.innerHTML = `${S.heard} « ${Q ? Q.escHTML(r.text) : r.text} »`; ta.focus(); }
        else if (r && r.error === 'empty') tip.innerHTML = S.noHear;
        else if (r && r.error === 'perm') tip.innerHTML = S.perm;
        else { tip.innerHTML = window.TCSF_NATIVE ? S.noDictPhone : S.noDict; ta.focus(); }
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = ta.value.trim();
        if (q.length < 3) { ta.focus(); return; }
        form.remove();
        me(Q ? Q.escHTML(q) : q);
        answer(q);
      });
    }

    async function answer(q) {
      say(S.search, '', true);
      if (!QA) return;
      const [hits, wk] = await Promise.all([
        QA.search(subject, q, api, 4).catch(() => []),
        Promise.race([QA.wiki(/[؀-ۿ]/.test(q) ? 'ar' : lang, q, false), new Promise((r) => setTimeout(() => r({ offline: true }), 9000))])
      ]);
      const best = hits[0];
      let html = '', speak = '';
      if (best && mode === 'ar' && best.ar) {
        // réponse en arabe : la partie de la leçon expliquée en arabe
        html += `<div class="qa-src"><b>📘 ${S.inLesson(best.lesson)}</b> <span class="muted">› ${best.ar.t}</span><div class="qa-txt">${firstP(best.ar.h, 2)}</div></div>`;
        speak += firstP(best.ar.h, 2);
      } else if (best) {
        html += `<div class="qa-src"><b>📘 ${S.inLesson(best.lesson)}</b>${best.part ? ` <span class="muted">› ${best.part}</span>` : ''}<div class="qa-txt">${best.html}</div></div>`;
        speak += best.text + '. ';
        if (mode === 'mix' && best.ar && /[a-z]/i.test(best.text)) { html += arBox(firstP(best.ar.h, 2)); speak += arBox(firstP(best.ar.h, 2)); }
        const other = hits.slice(1).find((h) => h.score > best.score * 0.55 && h.text !== best.text);
        if (other) html += `<div class="qa-src small"><b>${S.alsoSee} :</b> ${other.lesson}${other.part ? ' › ' + other.part : ''}<div class="qa-txt">${other.html}</div></div>`;
      }
      if (wk && wk.text) {
        html += `<div class="qa-src wiki"><b>🌐 ${S.wiki}</b> — ${Q ? Q.escHTML(wk.title) : wk.title}<div class="qa-txt">${Q ? Q.escHTML(wk.text) : wk.text}</div><a href="${wk.url}" target="_blank" rel="noopener">${S.src} ↗</a></div>`;
        if (!best) speak += wk.text;
      } else if (wk && wk.offline) html += `<p class="w-small">${S.offline}</p>`;
      if (!html.includes('qa-src')) { say(S.nothing); return askBox(false); }
      const b = say(html, 'board', true);
      nucFix(b); talk(speak || html);
      followUp(q, hits, 1);
    }

    function followUp(q, hits, level) {
      const a = actions(
        btn(S.noUnd, 'primary', () => { clear(a); me(S.noUnd); simplify(q, hits, level); }),
        btn(S.und, '', () => { clear(a); me(S.und); say(S.thanks, 'good'); actions(btn(S.other, '', function () { this.parentNode.remove(); askBox(false); })); }),
        btn(S.other, 'ghost', () => { clear(a); askBox(false); }));
    }

    async function simplify(q, hits, level) {
      const best = hits[0];
      if (level === 1) {
        let html = '', speak = '';
        if (best) {
          const one = QA.firstSentences(best.text, 1);
          html += `<div class="qa-src"><b>💡 ${S.short} :</b><div class="qa-txt big">${Q ? Q.escHTML(one) : one}</div></div>`; speak += one + '. ';
          const def = hits.find((h) => (h.kind === 'carte' || h.kind === 'def') && h !== best);
          if (def) html += `<div class="qa-src"><div class="qa-txt">${def.html}</div></div>`;
          const ex = (await QA.search(subject, q + ' ' + best.part, api, 12).catch(() => [])).find((h) => h.kind === 'exemple' && h.lessonId === best.lessonId);
          if (ex) { html += `<div class="qa-src ex"><b>🧪 ${S.example} :</b><div class="qa-txt">${ex.html}</div></div>`; speak += ex.text; }
        }
        const wk = await Promise.race([QA.wiki(lang, q, true), new Promise((r) => setTimeout(() => r({}), 9000))]);
        if (wk && wk.text) {
          const t = QA.firstSentences(wk.text, 2);
          html += `<div class="qa-src wiki"><b>🌐 ${lang === 'fr' && /vikidia/.test(wk.source || '') ? S.vikidia : S.wiki}</b><div class="qa-txt">${Q ? Q.escHTML(t) : t}</div><a href="${wk.url}" target="_blank" rel="noopener">${S.src} ↗</a></div>`;
          if (!speak) speak = t;
        }
        // « je n'ai pas compris » : on mélange avec l'arabe (leçon + Wikipédia en arabe)
        if (lang === 'fr' && mode !== 'ar') {
          if (best && best.ar) { const a = arBox(firstP(best.ar.h, 2)); html += a; speak += a; }
          const wa = await Promise.race([QA.wiki('fr', q, false, true), new Promise((r) => setTimeout(() => r({}), 9000))]);
          if (wa && wa.text) {
            const t = QA.firstSentences(wa.text, 2);
            html += `<div class="qa-src wiki" dir="rtl" lang="ar"><b>🌐 ${X.fr.arWiki}</b> — ${Q ? Q.escHTML(wa.title) : wa.title}<div class="qa-txt">${Q ? Q.escHTML(t) : t}</div><a href="${wa.url}" target="_blank" rel="noopener">المصدر ↗</a></div>`;
            if (!(best && best.ar)) speak += arBox(Q ? Q.escHTML(t) : t);
          }
        }
        if (!html) { say(S.nothing); return askBox(false); }
        say(S.simpler, '', true);
        const b = say(html, 'board', true); nucFix(b); talk(S.simpler + ' ' + speak);
        return followUp(q, hits, 2);
      }
      // niveau 2 : mot par mot + reprendre la leçon avec le prof
      const words = [...new Set(QA.tokens(q))].slice(0, 4);
      let html = '';
      for (const w of words) {
        const h = (await QA.search(subject, w, api, 6).catch(() => [])).find((x) => x.kind === 'carte' || x.kind === 'def');
        if (h) html += `<li>${h.html}</li>`;
      }
      say(S.simplest, '', true);
      const b = say((html ? `<ul class="qa-words">${html}</ul>` : '') + `<p>${S.teacher}</p>`, 'board', true);
      nucFix(b); talk(S.simplest + ' ' + b.textContent);
      const bs = [];
      if (best) { const r = el_('a', 'btn primary', S.retry(best.lesson)); r.href = `#/l/${encodeURIComponent(subject)}/prof/${encodeURIComponent(best.lessonId)}`; bs.push(r); }
      bs.push(btn(S.other, '', () => { clear(a); askBox(false); }));
      const a = actions(...bs);
    }

    renderBook();
    if (!parts.length) { say(S.empty); return; }
    hello();
  };
})();
