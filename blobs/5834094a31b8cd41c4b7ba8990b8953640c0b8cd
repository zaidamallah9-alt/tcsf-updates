        const ex = [...st.exams].sort((a, b) => a.date.localeCompare(b.date));
        L.innerHTML = ex.length ? ex.map((e) => { const n = daysTo(e.date); return `<div class="plan-exam${n < 0 ? ' past' : ''}" style="--c:${color(e.subject)}"><div><b>${esc(subj(e.subject).title)}</b><br><span class="muted">${nice(e.date)}${e.time ? ' à ' + e.time : ''} · ${e.lessons.length ? e.lessons.length + ' leçon(s)' : 'leçons non précisées'}</span></div><span class="plan-count">${n < 0 ? 'passé' : n === 0 ? 'aujourd’hui !' : n === 1 ? 'demain' : 'dans ' + n + ' j'}</span><button type="button" class="icon-btn" data-del="${e.id}" title="Supprimer">✕</button></div>`; }).join('') : '<p class="muted">Aucun examen pour l’instant.</p>';
        L.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', () => { st.exams = st.exams.filter((x) => x.id !== b.dataset.del); st.plan = null; persist(); list(); }));
      };
      list();
    }

    // ===== 3. Programme =====
    async function renderProgramme() {
      if (!Object.keys(st.edt).length) { body.innerHTML = '<div class="box warn"><span class="box-title">Il manque ton emploi du temps</span><p>Commence par remplir ton emploi du temps (photo ou à la main).</p><p><a class="btn primary" href="#/planning/edt">Remplir mon emploi du temps</a></p></div>'; return; }
      if (!st.plan || st.plan.made !== ymd(new Date())) { await generate(st, A); persist(); }
      await syncNotifications(st);
      const plan = st.plan, T = plan.titles || {};
      const exams = st.exams.filter((e) => daysTo(e.date) >= 0).sort((a, b) => a.date.localeCompare(b.date));
      const byDay = {}; for (const p of plan.items) (byDay[p.date] = byDay[p.date] || []).push(p);
      const tot = plan.items.length, done = plan.items.filter((p) => st.done[p.task]).length;
      const link = link0;
      // ---- Où j'en suis dans le programme du centre ----
      const PR = st.prog || {};
      const progBox = await (async () => {
        const rows = [];
        for (const s of Object.keys(PR)) {
          const g = PR[s], idx = (await api.readJSON(`${s}/index.json`).catch(() => null)) || [];
          const diff = g.done - g.auto;
          const badge = diff >= 1 ? `<span class="pg-b ok">🚀 en avance (+${diff})</span>` : diff >= -1 ? '<span class="pg-b">✔ à jour</span>' : `<span class="pg-b ko">⚠ ${-diff} leçon(s) de retard</span>`;
          rows.push(`<div class="pg-row" style="--c:${color(s)}"><div class="pg-top"><b>${esc(subj(s).title || SHORT[s])}</b>${badge}<span class="muted">${g.done}/${g.n} 👑</span></div>
            <div class="pg-bar"><span style="width:${(g.done / g.n) * 100}%"></span><i style="left:${(Math.min(g.n, g.cur + 0.5) / g.n) * 100}%" title="En classe"></i></div>
            <label class="pg-cur">📍 En classe, on est à : <select data-cur="${esc(s)}"><option value="">Automatique (selon la date) — ${esc((idx[Math.min(g.auto, idx.length - 1)] || {}).title || '')}</option>${idx.map((l) => `<option value="${esc(l.id)}"${st.cur && st.cur[s] === l.id ? ' selected' : ''}>${esc(l.title)}</option>`).join('')}</select></label></div>`);
        }
        return rows.length ? `<details class="pg-box"${st.pgOpen === false ? '' : ' open'}><summary>📚 Où j’en suis dans le programme <small class="muted">(ordre des leçons du centre)</small></summary>
          <p class="w-small muted">Le programme se construit tout seul : <b>🎒 préparer</b> la leçon avant le prochain cours de la matière, <b>🚑 rattraper</b> les leçons en retard, <b>🔁 rappels espacés</b> (J+1, J+3, J+7, J+16, J+35) pour ne pas oublier, <b>🧠 erreurs</b> à corriger, <b>🏁 devoir</b> le dimanche, et les matières à fort coefficient d’abord. Les séances se cochent <b>toutes seules</b> quand tu fais vraiment l’activité.</p>${rows.join('')}</details>` : '';
      })();
      body.innerHTML = progBox + `${exams.length ? `<div class="plan-countdowns">${exams.slice(0, 4).map((e) => { const n = daysTo(e.date); return `<div class="plan-cd" style="--c:${color(e.subject)}"><b>${n === 0 ? 'Aujourd’hui' : n === 1 ? 'Demain' : 'J − ' + n}</b><span>${esc(SHORT[e.subject])} · ${nice(e.date)}</span></div>`; }).join('')}</div>` : '<div class="box note"><span class="box-title">Pas d’examen prévu</span><p>Ton programme contient des révisions régulières : revoir chaque soir les matières du jour et t’entraîner. Ajoute tes examens pour un programme ciblé.</p></div>'}
        <div class="plan-progress"><span>Séances faites : <b>${done}</b> / ${tot}</span><span class="plan-stars" title="Une étoile par séance terminée">⭐ <b>${st.stars || 0}</b> étoiles</span><div class="w-massbar"><span style="width:${tot ? (done / tot) * 100 : 0}%;background:var(--ex-line)"></span></div></div>
        ${plan.missed.length ? `<div class="box warn"><span class="box-title">Pas assez de temps libre</span><p>${plan.missed.length} séance(s) n’ont pas trouvé de place avant l’examen. Ajoute des créneaux (onglet 1) ou augmente le maximum par jour.</p></div>` : ''}
        <div class="plan-tools"><label class="plan-check"><input type="checkbox" class="plan-notif" ${st.notif ? 'checked' : ''}> 🔔 Rappels (notifications) à l’heure de chaque séance et la veille des examens</label>
        <button type="button" class="btn ghost plan-regen">↻ Refaire le programme</button><button type="button" class="btn ghost plan-print">🖨 Imprimer</button></div>
        <div class="plan-days">${Object.keys(byDay).sort().map((d) => `<section class="plan-day${d === ymd(new Date()) ? ' today' : ''}"><h3>${d === ymd(new Date()) ? '📍 Aujourd’hui — ' : ''}${nice(d)}${exams.some((e) => e.date === d) ? ' <span class="tag">📝 examen</span>' : ''}</h3>
          ${byDay[d].map((p) => { const L = link(p); const k = KIND[p.kind]; return `<div class="plan-item${st.done[p.task] ? ' done' : ''}" style="--c:${color(p.subject)}"><span class="plan-tick" data-t="${esc(p.task)}" title="${st.done[p.task] ? 'Faite' : 'Se coche toute seule quand tu fais l’activité'}">${st.done[p.task] ? '✅' : '⭕'}</span>
            <div class="plan-time">${hm(p.start)}<br><small>${hm(p.end)}</small></div><div class="plan-what"><b>${k.ic} ${esc(SHORT[p.subject] || p.subject)} — ${k.t}${p.iv ? ` (J+${p.iv})` : ''}${p.n ? ` · ${p.n} erreurs` : ''}</b>${p.lesson ? `<br><span>${esc(T[`${p.subject}/${p.lesson}`] || '')}</span>` : !ready(p.subject) ? '<br><span class="muted">avec ton cahier et ton livre</span>' : ''}</div><span class="plan-acts">${st.done[p.task] ? '' : `<button type="button" class="btn plan-focus" data-f="${esc(p.task)}">⏱️ Focus</button>`}${L ? `<a class="btn primary plan-go" href="${L}">Commencer</a>` : ''}</span></div>`; }).join('')}</section>`).join('')}</div>
        <div class="box ex"><span class="box-title">🧠 Conseils pour bien mémoriser</span><ul>
          <li><b>Comprendre d’abord</b> : on retient mieux ce qu’on a compris (fais la leçon « avec le prof »).</li>
          <li><b>Se tester</b> plutôt que relire : cache la fiche et récite, fais les exercices sans regarder.</li>
          <li><b>Répéter dans le temps</b> : le programme revient sur chaque leçon le lendemain puis quelques jours après.</li>
          <li><b>Séances courtes</b> avec une pause (méthode Pomodoro) et téléphone loin de toi.</li>
          <li><b>Dormir</b> : le sommeil fixe ce que tu as appris, surtout la veille d’un examen.</li></ul></div>`;
      // pas de case à cocher : une séance se valide seulement quand la tâche est vraiment faite
      body.querySelectorAll('.plan-tick').forEach((c) => c.addEventListener('click', () => {
        if (st.done[c.dataset.t]) return;
        const p = plan.items.find((x) => x.task === c.dataset.t), L = p && link(p);
        toast(L ? 'Cette séance se coche toute seule quand tu termines l’activité : touche « Commencer ».' : 'Lance ⏱️ Focus et va jusqu’au bout : la séance se cochera toute seule.');
      }));
      body.querySelectorAll('[data-f]').forEach((b) => b.addEventListener('click', () => {
        const p = plan.items.find((x) => x.task === b.dataset.f); if (!p) return;
        const L = link(p);
        focus(p, st, L, (full) => {
          // séance « avec ton cahier » (pas d'activité dans l'appli) : validée si le minuteur est allé jusqu'au bout
          if (full && !L && !st.done[p.task]) { st.done[p.task] = 1; st.stars = (st.stars || 0) + 1; persist(); syncNotifications(st); reward(p, st, true); try { window.TCSF_DUO && window.TCSF_DUO.addXP(10); } catch {} renderProgramme(); }
        });
      }));
      body.querySelectorAll('[data-cur]').forEach((sel) => sel.addEventListener('change', async () => {
        st.cur = st.cur || {}; if (sel.value) st.cur[sel.dataset.cur] = sel.value; else delete st.cur[sel.dataset.cur];
        st.plan = null; await generate(st, A); persist(); renderProgramme();
      }));
      body.querySelector('.plan-regen').addEventListener('click', async () => { st.plan = null; await generate(st, A); persist(); renderProgramme(); });
      body.querySelector('.plan-print').addEventListener('click', () => window.print());
      body.querySelector('.plan-notif').addEventListener('change', async (e) => { st.notif = e.target.checked; if (st.notif) await askPermission(); persist(); syncNotifications(st); });
      // première visite : demander l'autorisation des rappels
      if (st.notif && !st.asked) { st.asked = 1; persist(); askPermission().then(() => syncNotifications(st)); }
      const t = body.querySelector('.plan-day.today'); if (t) setTimeout(() => t.scrollIntoView({ block: 'start', behavior: 'smooth' }), 200);
    }
  }

  // ---------------- Mode Focus (Pomodoro) : minuteur plein écran pour une séance ----------------
  function focus(p, st, href, onDone) {
    const total = (p.end - p.start) * 60; let left = total, run = true, last = Date.now();
    const o = document.createElement('div'); o.className = 'fc-overlay';
    const R = 110, C = 2 * Math.PI * R;
    o.innerHTML = `<div class="fc-card"><p class="fc-sub">${KIND[p.kind].ic} ${esc(SHORT[p.subject] || p.subject)} — ${esc(KIND[p.kind].t)}</p>
      <svg class="fc-ring" viewBox="0 0 260 260"><circle cx="130" cy="130" r="${R}" class="fc-bg"/><circle cx="130" cy="130" r="${R}" class="fc-fg" stroke-dasharray="${C}" stroke-dashoffset="0" transform="rotate(-90 130 130)"/></svg>
      <div class="fc-time">--:--</div>
      <p class="fc-tip">📵 Téléphone loin de toi · 💧 un verre d’eau · une seule tâche</p>
      <div class="fc-btns"><button class="btn fc-pause">⏸ Pause</button>${href ? `<a class="btn" href="${href}" target="_self">📖 Ouvrir la leçon</a>` : ''}<button class="btn primary fc-end">✔ J’ai fini</button><button class="btn fc-quit">✕</button></div></div>`;
    document.body.appendChild(o);
    const fg = o.querySelector('.fc-fg'), tm = o.querySelector('.fc-time');
    const addMin = (m) => { if (m <= 0) return; const d = ymd(new Date()); st.focus = st.focus || {}; st.focus[d] = (st.focus[d] || 0) + m; save(st); };
    let counted = 0;
    const paint = () => { const s = Math.max(0, Math.round(left)); tm.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; fg.setAttribute('stroke-dashoffset', String(C * (1 - left / total))); };
    const iv = setInterval(() => {
      const now = Date.now(); if (run) left -= (now - last) / 1000; last = now;
      const m = Math.floor((total - left) / 60); if (m > counted) { addMin(m - counted); counted = m; }
      paint();
      if (left <= 0) { finish(true); }
    }, 500);
    paint();
    const close = () => { clearInterval(iv); o.remove(); };
    function finish(auto) {
      close();
      if (window.TCSF_SFX) try { window.TCSF_SFX.fanfare(); } catch {}
      if (auto && 'Notification' in window && Notification.permission === 'granted') try { new Notification('⏱️ Séance terminée !', { body: 'Bravo ! Fais une pause de 5 minutes 😊' }); } catch {}
      onDone && onDone(auto || left <= total * 0.1);
    }
    o.querySelector('.fc-pause').onclick = (e) => { run = !run; e.target.textContent = run ? '⏸ Pause' : '▶ Reprendre'; o.classList.toggle('paused', !run); };
    o.querySelector('.fc-end').onclick = () => finish(false);
    o.querySelector('.fc-quit').onclick = close;
    // on ouvre la leçon : le minuteur continue en petit, en bas de l'écran
    o.querySelector('a.btn')?.addEventListener('click', () => o.classList.add('mini'));
    o.addEventListener('click', (e) => { if (o.classList.contains('mini') && !e.target.closest('button')) o.classList.remove('mini'); });
  }

  // ---------------- Carte « Aujourd'hui » sur l'accueil ----------------
  async function todayCard(el, api) {
    const st = load();
    if (!Object.keys(st.edt).length) { el.innerHTML = `<a class="plan-today empty" href="#/planning"><span class="plan-today-ic">${(window.TCSF_GLYPH ? window.TCSF_GLYPH('calendar', 30) : '')}</span><div><b>Organise tes révisions</b><br><span class="muted">Prends ton emploi du temps en photo et ajoute tes examens : je te prépare un programme avec des rappels.</span></div><span class="btn primary">Créer mon planning</span></a>`; return; }
    const subjects = await api.getSubjects();
    const ready = (id) => { const s = subjects.find((x) => x.id === id); return s && s.status === 'ready' && (s.categories || []).some((c) => c.lessons); };
    const catOf = (id, m) => ((subjects.find((x) => x.id === id) || {}).categories || []).find((c) => c.mode === m || c.id === m);
    if (!st.plan || st.plan.made !== ymd(new Date())) { await generate(st, { readJSON: api.readJSON, ready, hasExam: (id) => !!catOf(id, 'examen'), hasMethode: (id) => !!catOf(id, 'methode') }); save(st); }
    syncNotifications(st);
    const today = ymd(new Date()), items = st.plan.items.filter((p) => p.date === today);
    const next = st.exams.filter((e) => daysTo(e.date) >= 0).sort((a, b) => a.date.localeCompare(b.date))[0];
    el.innerHTML = `<div class="plan-today"><div class="plan-today-top"><b>${(window.TCSF_GLYPH ? window.TCSF_GLYPH('pin', 16) : '')} Mon planning</b>${st.stars ? `<span class="tag">${(window.TCSF_GLYPH ? window.TCSF_GLYPH('star', 14) : '')} ${st.stars}</span>` : ''}${next ? `<span class="tag">${(window.TCSF_GLYPH ? window.TCSF_GLYPH('pencil', 14) : '')} ${esc(SHORT[next.subject])} ${daysTo(next.date) === 0 ? 'aujourd’hui' : daysTo(next.date) === 1 ? 'demain' : 'dans ' + daysTo(next.date) + ' jours'}</span>` : ''}<a href="#/planning/programme" class="plan-today-all">Tout mon programme</a></div>
      ${items.length ? items.map((p) => `<div class="plan-mini${st.done[p.task] ? ' done' : ''}"><span>${hm(p.start)}</span><b>${KIND[p.kind].ic} ${esc(SHORT[p.subject] || p.subject)}</b><span class="muted">${KIND[p.kind].t}${p.lesson ? ' · ' + esc((st.plan.titles || {})[`${p.subject}/${p.lesson}`] || '') : ''}</span>${st.done[p.task] ? '<span class="plan-ok">' + (window.TCSF_GLYPH ? window.TCSF_GLYPH('check', 16) : '') + '</span>' : ''}</div>`).join('') : '<p class="muted" style="margin:6px 0">Pas de séance prévue aujourd’hui. Repose-toi bien.</p>'}</div>`;
  }

  // ---------------- Séance faite → cochée toute seule + récompense ----------------
  // Les activités de l'application envoient window 'tcsf:activity' { act: prof|exo|memo|examen, src?, subject?, lesson? }
  function ctxOf(d) {
    let { subject, lesson } = d;
    const m = String(d.src || '').match(/^([^/]+)\/(?:l\/)?([^/.]+)/);
    if (!subject && m) { subject = m[1]; lesson = lesson || m[2]; }
    if (!subject) { const hh = location.hash.match(/^#\/l\/([^/]+)\/[^/]+\/([^/?]+)/); if (hh) { subject = decodeURIComponent(hh[1]); lesson = decodeURIComponent(hh[2]); } }
    return { subject, lesson };
  }
  const KMAP = { prof: ['learn', 'prep', 'retard', 'avance'], exo: ['exo', 'rev'], memo: ['memo', 'veille', 'rev'], examen: ['blanc'], session: ['prep', 'retard', 'avance', 'learn', 'rev', 'exo', 'memo'], erreurs: ['erreurs'], devoir: ['devoir'] };
  function activityDone(d) {
    const st = load();
    if (!st.plan) return;
    const { subject, lesson } = ctxOf(d);
    if (!subject) return;
    const today = ymd(new Date());
    // une leçon terminée (session Parcours) : point de départ des rappels espacés
    if (d.act === 'session' && lesson) {
      const k = `${subject}/${lesson}`;
      if (!st.learned) st.learned = {};
      const learnK = ['prep', 'retard', 'avance', 'learn'];
      if (!st.learned[k]) st.learned[k] = today;
      // apprendre la leçon valide toutes ses séances « apprendre » d'un coup
      const L = st.plan.items.filter((p) => !st.done[p.task] && p.subject === subject && p.lesson === lesson && learnK.includes(p.kind));
      if (L.length) { L.forEach((p) => (st.done[p.task] = 1)); st.stars = (st.stars || 0) + 1; st.plan = Object.assign(st.plan, { made: '' }); save(st); syncNotifications(st); reward(L[0], st); return; }
    }
    // une séance faite en avance compte aussi (la plus proche d'abord)
    const cands = st.plan.items.filter((p) => !st.done[p.task] && p.subject === subject).sort((a, b) => a.date.localeCompare(b.date) || a.start - b.start);
    const pick = cands.find((p) => (KMAP[d.act] || []).includes(p.kind) && (!p.lesson || !lesson || p.lesson === lesson))
      || cands.find((p) => p.date === today && (p.kind === 'jour' || p.kind === 'libre'));
    if (!pick) return;
    st.done[pick.task] = 1;
    st.stars = (st.stars || 0) + 1;
    save(st); syncNotifications(st);
    reward(pick, st);
  }
  // Animation de récompense : ⭐ +1
  function reward(p, st, small) {
    document.querySelector('.rw-overlay')?.remove();
    const k = KIND[p.kind] || {};
    const title = p.lesson ? (st.plan.titles || {})[`${p.subject}/${p.lesson}`] || '' : '';
    const o = document.createElement('div');
    o.className = 'rw-overlay' + (small ? ' small' : '');
    o.innerHTML = `<div class="rw-card" role="status"><div class="rw-rays"></div><div class="rw-star">⭐</div><div class="rw-plus">+1</div>
      <b class="rw-title">Séance terminée ! Bravo 🎉</b><p class="rw-what">${k.ic || ''} ${esc(SHORT[p.subject] || p.subject)} — ${esc(k.t || '')}${title ? '<br><small>' + esc(title) + '</small>' : ''}</p>
      <p class="rw-total">Tu as maintenant <b>${st.stars}</b> ⭐ · ${st.plan.items.filter((x) => st.done[x.task]).length}/${st.plan.items.length} séances faites</p>
      <button type="button" class="btn primary rw-ok">Super !</button></div>`;
    document.body.appendChild(o);
    const close = () => { o.classList.add('out'); setTimeout(() => o.remove(), 300); };
    o.querySelector('.rw-ok').addEventListener('click', close);
    o.addEventListener('click', (e) => { if (e.target === o) close(); });
    setTimeout(close, small ? 2600 : 6000);
    try { if (window.TCSF_SFX) window.TCSF_SFX.fanfare(); } catch {}
    try { if (window.TCSF_Q && window.TCSF_Q.burst) window.TCSF_Q.burst(o.querySelector('.rw-card')); } catch {}
    // mettre à jour la page planning si elle est ouverte
    const c = document.querySelector(`.plan-item input[data-t="${CSS.escape(p.task)}"]`);
    if (c && !c.checked) { c.checked = true; c.closest('.plan-item').classList.add('done'); }
  }
  window.addEventListener('tcsf:activity', (e) => { try { activityDone(e.detail || {}); } catch (err) { console.error(err); } });

  window.TCSF_PLANNER = { render, todayCard, readTimetable, generate, freeSessions, load, save, syncNotifications, activityDone };
  // au démarrage : reprogrammer les rappels
  setTimeout(() => { try { const st = load(); if (st.plan) syncNotifications(st); } catch {} }, 1500);
})();
